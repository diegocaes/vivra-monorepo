---
import Icon from './ui/Icon.astro';
interface Props { name: string; unreadCount: number; }
const { name, unreadCount } = Astro.props;
const initials = name.split(/\s+/).map(word => word[0]).slice(0, 2).join('').toUpperCase() || 'V';
---
<header class="app-topbar no-print">
  <div class="topbar-actions">
    <details class="add-menu"><summary>＋ <span>Agregar</span></summary><div><a href="/salud/vacunas?new=1">Vacuna</a><a href="/salud/historial?new=1">Visita veterinaria</a><a href="/salud/peso?new=1">Peso</a><a href="/onboarding?add=1">Mascota</a></div></details>
    <a href="/notificaciones" class="notification-link" aria-label={`Notificaciones${unreadCount ? `, ${unreadCount} sin leer` : ''}`}><Icon name="campana" class="h-6 w-6" />{unreadCount > 0 && <span />}</a>
    <a href="/perfil?view=cuenta" class="account-avatar" aria-label="Mi cuenta">{initials}</a>
  </div>
</header>
<style>
  .app-topbar { justify-content: flex-end; }
  .add-menu>div { position: absolute; top: calc(100% + 8px); left: 0; right: 0; padding: 8px; background: #FFFDFA; border: 1px solid #E8E4DC; border-radius: 16px; box-shadow: 0 14px 36px #143B3110; z-index: 60; }
  .add-menu a { display: block; font-size: 13px; padding: 10px 12px; border-radius: 8px; }
  .add-menu a:hover { background: #E5EDE1; }
  .topbar-actions { display: flex; align-items: center; gap: 25px; }
  .add-menu { position: relative; }
  .add-menu summary { cursor: pointer; list-style: none; padding: 10px 18px; background: #174C3C; color: white; font-size: 13px; border-radius: 26px; }
  summary::-webkit-details-marker { display: none; }
  .add-menu>div { min-width: 190px; left: auto; }
  .notification-link { position: relative; color: #174C3C; }
  .notification-link span { position: absolute; top: -3px; right: -2px; width: 8px; height: 8px; border: 2px solid #FFFDFA; border-radius: 50%; background: #DC755D; }
  .account-avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: #EBEAE3; font-size: 13px; font-weight: 600; }
</style>
