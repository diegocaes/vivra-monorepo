    </div>
    <div class="min-w-0 flex-1">
      <p class:list={['text-sm font-semibold truncate', vaccineSummary.state === 'overdue' ? 'text-red-700' : 'text-ink']}>
        {vaccineSummary.title}
      </p>
      <p class="mt-0.5 text-xs text-muted truncate">{vaccineSummary.detail}</p>
    </div>
    <svg class:list={['h-4 w-4 shrink-0', vaccineSummary.state === 'overdue' ? 'text-red-400' : 'text-emerald-600']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
  </a>

  {/* ── RESUMEN RAPIDO: Peso + Comida ── */}
  <div class="grid grid-cols-2 gap-3 mb-6 animate-fade-up animate-fade-up-delay-2">
