---
import MainLayout from '../../layouts/MainLayout.astro';
import HistoryChart from '../../components/HistoryChart.astro';
import Icon from '../../components/ui/Icon.astro';
import HealthHeader from '../../components/health/HealthHeader.astro';
import HealthLoadNotice from '../../components/health/HealthLoadNotice.astro';

import { formatDate, parseNumericField, preventiveNextDue, daysUntilDate, localDateKey, isPreventiveType } from '@vivra/shared';
import { getActivePet } from '../../lib/pet';
import { getPremiumStatus } from '../../lib/premium';

const { supabase, user, activePetId } = Astro.locals;
const { pet } = await getActivePet(supabase, user.id, activePetId);
if (!pet) return Astro.redirect('/perfil?new=1');

const premium = await getPremiumStatus(supabase, user.id);

// POST handler
function redirectError(message: string) {
  return Astro.redirect('/salud/preventivos?toast_error=' + encodeURIComponent(message));
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;

  if (action === 'add') {
    const dateGiven = formData.get('date_given') as string;
    const type = String(formData.get('type') || '');
    if (!isPreventiveType(type) || !/^\d{4}-\d{2}-\d{2}$/.test(dateGiven)) return redirectError('Revisa el tipo de preventivo y la fecha de aplicación.');
    const { error } = await supabase.from('preventive_treatments').insert({
      pet_id: pet.id,
      type,
      date_given: dateGiven,
      next_due: preventiveNextDue(pet.species, dateGiven, (formData.get('next_due') as string) || null),
      product_name: (formData.get('product_name') as string) || null,
      lot_number: (formData.get('lot_number') as string) || null,
      cost: parseNumericField(formData.get('cost'), { max: 100_000 }),
      notes: (formData.get('notes') as string) || null,
    });
    if (error) return redirectError('No se pudo guardar el registro. Inténtalo de nuevo.');
    return Astro.redirect('/salud/preventivos?saved=1');
  }

  if (action === 'delete') {
    const { error } = await supabase.from('preventive_treatments').delete().eq('id', formData.get('id') as string).eq('pet_id', pet.id);
    if (error) return redirectError('No se pudo eliminar el registro. Inténtalo de nuevo.');
    return Astro.redirect('/salud/preventivos?deleted=1');
  }
}

// Load data
const { data: rawTreatments, error: loadError } = await supabase
  .from('preventive_treatments')
  .select('*')
  .eq('pet_id', pet.id)
  .order('date_given', { ascending: false });

// Dogs use Vivra's calendar-month default. This normalization makes historical rows
// saved before next_due existed show their real dose instead of a false empty
// status. Cats continue to require an explicit date.
const treatments = (rawTreatments ?? []).map(treatment => ({
  ...treatment,
  next_due: preventiveNextDue(pet.species, treatment.date_given, treatment.next_due),
}));

// A 'combinado' row acts as both antipulgas and desparasitante. Include it in
// both lists so "last dose" + history reflect reality for each specific type.
const antipulgasList = treatments.filter(t => t.type === 'antipulgas' || t.type === 'combinado');
const desparasitanteList = treatments.filter(t => t.type === 'desparasitante' || t.type === 'combinado');
const isDog = pet.species === 'dog';
const defaultNextDue = isDog ? preventiveNextDue('dog', localDateKey(), null) ?? '' : '';

function daysUntilNext(nextDue: string | null | undefined) {
  if (!nextDue) return { daysLeft: null, overdue: false, nextDate: null };
  const daysLeft = daysUntilDate(nextDue);
  return { daysLeft, overdue: daysLeft < 0, nextDate: formatDate(nextDue) };
}

const antipulgasStatus = daysUntilNext(antipulgasList[0]?.next_due);
const desparasitanteStatus = daysUntilNext(desparasitanteList[0]?.next_due);

const openForm = Astro.url.searchParams.get('new');
---

<MainLayout title="Preventivos">
  <HealthHeader pet={pet} active="preventivos" title="Preventivos" subtitle={`Antipulgas y desparasitación de ${pet.name}`} />
  {loadError && <HealthLoadNotice href="/salud/preventivos" subject="los preventivos" />}

  {!loadError && <>
  <section class="health-section-summary">
    <span class:list={['health-summary-ring', { warning: antipulgasStatus.overdue || desparasitanteStatus.overdue }]}><Icon name="preventivo" class="h-7 w-7" /></span>
    <div><h2>{treatments.length ? antipulgasStatus.overdue || desparasitanteStatus.overdue ? 'Revisar próximas fechas' : 'Sus preventivos, en un lugar' : 'Empieza su historial preventivo'}</h2><p>{treatments.length ? 'Consulta las últimas aplicaciones y las fechas guardadas para cada cuidado.' : 'Registra las aplicaciones indicadas para tu mascota y conserva su historial.'}</p></div>
  </section>
  <div class="health-preventive-list">
    {[
      { label: 'Antipulgas y garrapatas', icon: 'preventivo', tone: '', records: antipulgasList, status: antipulgasStatus, href: '#historial-antipulgas' },
      { label: 'Desparasitación interna', icon: 'pastilla', tone: 'coral', records: desparasitanteList, status: desparasitanteStatus, href: '#historial-desparasitante' },
    ].map(item => <a class="health-preventive-row" href={item.href}>
      <span class:list={['health-icon', item.tone]}><Icon name={item.icon} /></span>
      <div class="health-event-info"><strong>{item.label}</strong><p>{item.records[0]?.product_name || (item.records.length ? 'Aplicación registrada' : 'Sin registros')}</p>{item.records[0] && <p>Última: {formatDate(item.records[0].date_given)}{item.status.nextDate && ` · Próxima: ${item.status.nextDate}`}</p>}</div>
      <span class:list={['health-status-pill', { warning: item.status.overdue }]}>{!item.records.length ? 'Sin registro' : item.status.overdue ? 'Fecha pendiente' : item.status.daysLeft === null ? 'Sin próxima fecha' : item.status.daysLeft === 0 ? 'Hoy' : `En ${item.status.daysLeft} días`}</span>
      <span class="health-chevron" aria-hidden="true">›</span>
    </a>)}
  </div>

  </>}

  {/* ── ADD BUTTONS ── */}
  <div class="flex gap-2 mb-3 animate-fade-up">
    <a href="/salud/preventivos?new=antipulgas" class="action-primary flex-1 justify-center gap-2">
      <Icon name="preventivo" class="h-4 w-4" /> Registrar antipulgas
    </a>
    <a href="/salud/preventivos?new=desparasitante" class="action-primary flex-1 justify-center gap-2">
      <Icon name="pastilla" class="h-4 w-4" /> Registrar desparasitante
    </a>
  </div>
  <a href="/salud/preventivos?new=combinado" class="flex items-center justify-center gap-2 rounded-2xl bg-card border-2 border-accent/40 px-4 py-3 text-sm font-semibold text-accent-dark hover:bg-accent-light transition-all active:scale-95 mb-6 animate-fade-up">
    <Icon name="combinado" class="h-4 w-4" /> Registrar combinado (antipulgas + desparasitante)
  </a>

  {/* ── FORM (inline) ── */}
  {openForm && (openForm === 'antipulgas' || openForm === 'desparasitante' || openForm === 'combinado') && (
    <div class="mb-6 animate-fade-up" id="form-section">
      <div class="rounded-2xl bg-card border border-card-border p-5">
        <h2 class="text-sm font-bold text-ink mb-4">
          {openForm === 'antipulgas' ? 'Registrar antipulgas'
            : openForm === 'desparasitante' ? 'Registrar desparasitante'
            : 'Registrar combinado'}
        </h2>
        {openForm === 'combinado' && (
          <p class="text-xs text-muted mb-3 leading-relaxed">
            Un producto combinado (p. ej. NexGard Spectra, Simparica Trio) cuenta como antipulgas y desparasitante a la vez.
          </p>
        )}
        <form method="POST" class="space-y-3">
          <input type="hidden" name="_action" value="add" />
          <input type="hidden" name="type" value={openForm} />

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Fecha de aplicación *</label>
            <input
              type="date"
              name="date_given"
              required
              max={localDateKey()}
              class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Producto (opcional)</label>
            <input
              type="text"
              name="product_name"
              placeholder={openForm === 'antipulgas' ? 'Ej: Frontline, NexGard...' : openForm === 'desparasitante' ? 'Ej: Drontal, Milbemax...' : 'Ej: NexGard Spectra, Simparica Trio...'}
              class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Próxima aplicación{isDog ? '' : ' (opcional)'}</label>
            <input type="date" name="next_due" value={defaultNextDue} class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors" />
            <p class="mt-1 text-[11px] text-muted">{isDog ? 'Se completa automáticamente un mes después de la aplicación.' : 'Confirma esta fecha con la etiqueta del producto o tu veterinario.'}</p>
          </div>

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Nº de lote (opcional)</label>
            <input
              type="text"
              name="lot_number"
              placeholder="Ej: AB1234-56"
              class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Costo (opcional)</label>
            <input
              type="number"
              name="cost"
              step="0.01"
              min="0"
              placeholder="Ej: 25.00"
              class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-muted mb-1">Notas (opcional)</label>
            <textarea
              name="notes"
              rows="2"
              placeholder="Peso al momento de aplicar, observaciones..."
              class="w-full rounded-xl border border-card-border bg-canvas px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>

          <div class="flex gap-2 pt-1">
            <button type="submit" class="flex-1 rounded-xl bg-accent text-white font-semibold py-2.5 text-sm hover:bg-accent-dark transition-colors active:scale-95">
              Guardar
            </button>
            <a href="/salud/preventivos" class="flex-1 rounded-xl bg-canvas border border-card-border text-muted font-semibold py-2.5 text-sm text-center hover:text-ink transition-colors">
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  )}

  {!loadError && <>
  {/* ── GRÁFICO HISTÓRICO ── */}
  <HistoryChart
    items={treatments.map(t => ({ date: t.date_given, amount: t.cost }))}
    showMoney={premium.isPremium}
    noun="dosis"
    class="mb-5 animate-fade-up"
  />

  {/* ── ANTIPULGAS LIST ── */}
  <div class="mb-6 animate-fade-up health-history-anchor" id="historial-antipulgas">
    <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Historial antipulgas</p>
    {antipulgasList.length === 0 ? (
      <div class="rounded-2xl bg-card border border-dashed border-card-border p-6 text-center">
        <p class="text-sm text-muted">Sin registros de antipulgas</p>
        <a href="/salud/preventivos?new=antipulgas" class="inline-block mt-2 text-xs font-semibold text-accent hover:text-accent-dark">
          + Registrar ahora
        </a>
      </div>
    ) : (
      <div class="rounded-2xl bg-card border border-card-border divide-y divide-card-border overflow-hidden">
        {antipulgasList.map((t) => (
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="h-9 w-9 shrink-0 flex items-center justify-center rounded-xl bg-green-50 text-accent-dark"><Icon name={t.type === 'combinado' ? 'combinado' : 'preventivo'} class="h-4.5 w-4.5" /></div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-ink truncate">{t.product_name || (t.type === 'combinado' ? 'Combinado' : 'Antipulgas')}</p>
                {t.type === 'combinado' && <span class="inline-flex items-center rounded-full bg-accent-light px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent-dark border border-accent/30">Combinado</span>}
              </div>
              <p class="text-[11px] text-muted">{formatDate(t.date_given)}{t.lot_number ? ` · Lote: ${t.lot_number}` : ''}{t.cost ? ` · $${t.cost}` : ''}</p>
              {t.notes && <p class="text-[11px] text-muted/70 truncate mt-0.5">{t.notes}</p>}
            </div>
            <form method="POST">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="id" value={t.id} />
              <button type="submit" class="p-1.5 rounded-lg text-muted/40 hover:text-red-400 hover:bg-red-50 transition-colors" onclick="return confirm('¿Eliminar este registro?')">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </form>
          </div>
        ))}
      </div>
    )}
  </div>

  {/* ── DESPARASITANTE LIST ── */}
  <div class="mb-6 animate-fade-up health-history-anchor" id="historial-desparasitante">
    <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Historial desparasitante</p>
    {desparasitanteList.length === 0 ? (
      <div class="rounded-2xl bg-card border border-dashed border-card-border p-6 text-center">
        <p class="text-sm text-muted">Sin registros de desparasitante</p>
        <a href="/salud/preventivos?new=desparasitante" class="inline-block mt-2 text-xs font-semibold text-accent hover:text-accent-dark">
          + Registrar ahora
        </a>
      </div>
    ) : (
      <div class="rounded-2xl bg-card border border-card-border divide-y divide-card-border overflow-hidden">
        {desparasitanteList.map((t) => (
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="h-9 w-9 shrink-0 flex items-center justify-center rounded-xl bg-blue-50 text-blue-500"><Icon name={t.type === 'combinado' ? 'combinado' : 'pastilla'} class="h-4.5 w-4.5" /></div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-ink truncate">{t.product_name || (t.type === 'combinado' ? 'Combinado' : 'Desparasitante')}</p>
                {t.type === 'combinado' && <span class="inline-flex items-center rounded-full bg-accent-light px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent-dark border border-accent/30">Combinado</span>}
              </div>
              <p class="text-[11px] text-muted">{formatDate(t.date_given)}{t.lot_number ? ` · Lote: ${t.lot_number}` : ''}{t.cost ? ` · $${t.cost}` : ''}</p>
              {t.notes && <p class="text-[11px] text-muted/70 truncate mt-0.5">{t.notes}</p>}
            </div>
            <form method="POST">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="id" value={t.id} />
              <button type="submit" class="p-1.5 rounded-lg text-muted/40 hover:text-red-400 hover:bg-red-50 transition-colors" onclick="return confirm('¿Eliminar este registro?')">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </form>
          </div>
        ))}
      </div>
    )}
  </div>

  </>}

  <p class="mt-10 mb-4 text-center text-xs text-muted/40 leading-relaxed max-w-xs mx-auto">Registra las aplicaciones y las próximas fechas indicadas por tu veterinario o en la etiqueta del producto.</p>

</MainLayout>
