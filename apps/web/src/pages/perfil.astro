---
import MainLayout from '../layouts/MainLayout.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { DOG_BREEDS, formatCurrency, calculateAge, parseNumericField, sumAmounts } from '@vivra/shared';
import { createSupabaseAdminClient } from '../lib/supabase';
import { getActivePet } from '../lib/pet';
import { uploadPetPhoto } from '../lib/storage';
import { getPremiumStatus } from '../lib/premium';
import { randomUUID } from 'node:crypto';

const { supabase, user, activePetId } = Astro.locals;
const isNew = Astro.url.searchParams.get('new') === '1';
const savedParam = Astro.url.searchParams.get('saved');
const errorParam = Astro.url.searchParams.get('error');
// Google/OAuth users don't have a password — check identities
const hasPasswordLogin = user.identities?.some((i: { provider: string }) => i.provider === 'email') ?? true;

// Extract first name for personalized greeting
const fullName = user.user_metadata?.full_name || user.user_metadata?.name || '';
const firstName = fullName.split(' ')[0] || user.email?.split('@')[0] || 'bienvenido';

// Estas dos consultas solo dependen de user.id, así que van juntas. En serie
// eran dos viajes a Supabase encadenados antes de renderizar nada.
const [petCtx, ownerProfileRes] = await Promise.all([
  getActivePet(supabase, user.id, activePetId),
  supabase.from('owner_profiles').select('*').eq('user_id', user.id).maybeSingle(),
]);
const { pet, pets, isOwner } = petCtx;
const hasMultiplePets = pets.length > 1;

// Profile completion badge logic
const profileFields = pet ? [
  !!pet.name,
  !!pet.breed,
  !!pet.birth_date,
  !!pet.gender,
  !!pet.photo_url,
  !!pet.weight_kg,
  !!pet.chip_id,
  !!pet.color,
] : [];
const completedFields = profileFields.filter(Boolean).length;
const totalFields = profileFields.length;
const isProfileComplete = pet && completedFields === totalFields;
const completionPct = pet ? Math.round((completedFields / totalFields) * 100) : 0;

// Owner profile (ya resuelto arriba, en paralelo con getActivePet)
const ownerProfile = ownerProfileRes.data;

// Handle form submission
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;

  if (action === 'save_owner') {
    const ownerData = {
      user_id: user.id,
      first_name: (formData.get('owner_first_name') as string)?.trim() || null,
      last_name: (formData.get('owner_last_name') as string)?.trim() || null,
      phone: (formData.get('owner_phone') as string)?.trim() || null,
      birth_date: (formData.get('owner_birth_date') as string) || null,
      gender: (formData.get('owner_gender') as string) || null,
    };
    if (ownerProfile) {
      await supabase.from('owner_profiles').update(ownerData).eq('user_id', user.id);
    } else {
      await supabase.from('owner_profiles').insert(ownerData);
    }
    return Astro.redirect('/perfil?saved=owner');
  }

  if (action === 'generate_invite' && pet && isOwner) {
    const admin = createSupabaseAdminClient();
    // Revoke any existing pending invite
    await admin.from('pet_share_invites')
      .update({ status: 'revoked' })
      .eq('pet_id', pet.id)
      .eq('inviter_id', user.id)
      .eq('status', 'pending');
    // Create new invite — UUID format unifies with mobile + matches the
    // regex validation in /invite/[token].astro
    const token = randomUUID();
    await admin.from('pet_share_invites').insert({
      pet_id: pet.id,
      inviter_id: user.id,
      token,
    });
    return Astro.redirect(`/perfil?invite_token=${token}`);
  }

  if (action === 'revoke_share' && pet && isOwner) {
    const shareId = formData.get('share_id') as string;
    if (shareId) {
      const admin = createSupabaseAdminClient();
      await admin.from('pet_shares').delete().eq('id', shareId).eq('pet_id', pet.id);
    }
    return Astro.redirect('/perfil?saved=revoked');
  }

  if (action === 'leave_pet' && pet && !isOwner) {
    const admin = createSupabaseAdminClient();
    await admin.from('pet_shares').delete().eq('pet_id', pet.id).eq('shared_with', user.id);
    // Switch to another pet
    const remaining = pets.filter(p => p.id !== pet.id);
    if (remaining.length > 0) {
      Astro.cookies.set('active_pet_id', remaining[0].id, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 365,
        secure: import.meta.env.PROD,
      });
    } else {
      Astro.cookies.delete('active_pet_id', { path: '/' });
    }
    return Astro.redirect('/dashboard');
  }

  if (action === 'logout') {
    await supabase.auth.signOut();
    return Astro.redirect('/login');
  }

  if (action === 'change_password') {
    const newPassword = formData.get('new_password') as string;
    const confirmPassword = formData.get('confirm_password') as string;
    if (!newPassword || newPassword.length < 8) {
      return Astro.redirect('/perfil?error=password_short');
    }
    if (newPassword !== confirmPassword) {
      return Astro.redirect('/perfil?error=password_mismatch');
    }
    const { error: pwError } = await supabase.auth.updateUser({ password: newPassword });
    if (pwError) {
      return Astro.redirect('/perfil?error=password_failed');
    }
    return Astro.redirect('/perfil?saved=password');
  }

  if (action === 'delete_account') {
    // Co-owners can only delete their OWN owned pets (or their account).
    // The pet they're co-owning belongs to someone else — they should use
    // 'leave_pet' to remove themselves from the share, not delete the pet.
    if (hasMultiplePets && pet && isOwner) {
      // Only delete this pet — keep the account and switch to another pet
      await supabase.from('pets').delete().eq('id', pet.id).eq('user_id', user.id);
      const remaining = pets.filter(p => p.id !== pet.id);
      const nextPet = remaining[0];
      Astro.cookies.set('active_pet_id', nextPet.id, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 365,
        secure: import.meta.env.PROD,
      });
      return Astro.redirect('/dashboard?deleted=1');
    } else if (hasMultiplePets && pet && !isOwner) {
      // Co-owner clicked "delete pet" but isn't the owner — redirect them
      // to the leave-pet flow instead.
      return Astro.redirect('/perfil?error=not_pet_owner');
    } else {
      // Last pet (or no pet) — delete the user's account entirely.
      // Delegamos en la edge function delete-account (misma que usa iOS):
      // limpia TODAS las tablas (shares, referrals, storage...) y cancela la
      // suscripción de Paddle si existe. Un solo camino de borrado para todo.
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.access_token) {
          const res = await fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/delete-account`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${session.access_token}`,
              'apikey': import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
            },
          });
          if (!res.ok) {
            console.error('[delete_account] edge function failed:', res.status, await res.text());
            return Astro.redirect('/perfil?error=delete_failed');
          }
        }
      } catch (e) {
        console.error('[delete_account] edge function threw:', e);
        return Astro.redirect('/perfil?error=delete_failed');
      }
      await supabase.auth.signOut();
      return Astro.redirect('/');
    }
  }

  // Edit-pet handler. CRITICAL: only the pet's owner can modify the pet's
  // core attributes (name, photo, breed, theme, etc.). Co-owners get full
  // read access and can write into companion tables (vaccines, weight,
  // visits, etc.) but the pet identity itself is owner-only.
  if (pet && !isOwner) {
    return Astro.redirect('/perfil?error=not_pet_owner');
  }

  // Resolve breed: if "Other" is selected, use the text input
  const breedSelect = formData.get('breed') as string;
  const breedOther = formData.get('breed_other') as string;
  const breed = breedSelect === 'Other' && breedOther ? breedOther : breedSelect || null;

  const newWeight = parseNumericField(formData.get('weight_kg'), { min: 0.1, max: 150 });

  const rawName = (formData.get('name') as string)?.trim().slice(0, 100);
  if (!rawName) {
    return Astro.redirect('/perfil?error=name_required');
  }

  // Colores de tema premium: naranja y azul son free; el resto requiere premium.
  const requestedTheme = (formData.get('theme_color') as string) || 'orange';
  const premiumAtSave = await getPremiumStatus(supabase, user.id);
  const themeColor = premiumAtSave.isPremium || ['orange', 'blue'].includes(requestedTheme)
    ? requestedTheme
    : (pet?.theme_color ?? 'orange');

  const petData = {
    user_id: user.id,
    name: rawName,
    // Los gatos no manejan raza — nunca guardar breed para species 'cat'
    breed: ((pet as any)?.species === 'cat') ? null : (breed?.slice(0, 100) || null),
    birth_date: (formData.get('birth_date') as string) || null,
    gender: (formData.get('gender') as string) || null,
    weight_kg: newWeight,
    chip_id: ((formData.get('chip_id') as string)?.trim().slice(0, 50)) || null,
    color: ((formData.get('color') as string)?.trim().slice(0, 50)) || null,
    theme_color: themeColor,
    birth_city: (formData.get('birth_city') as string)?.trim() || null,
    birth_country: (formData.get('birth_country') as string)?.trim() || null,
    support_type: (formData.get('support_type') as string) || null,
  };

  // Handle photo upload
  const uploaded = await uploadPetPhoto(formData.get('photo') as File, user.id, supabase, 'pet-profile');
  const photo_url = uploaded ?? pet?.photo_url ?? null;

  let petId = pet?.id;

  if (pet) {
    // Defensive: scope by owner so even if RLS is misconfigured, a co-owner
    // can't accidentally hijack the row.
    await supabase.from('pets').update({ ...petData, photo_url }).eq('id', pet.id).eq('user_id', user.id);
  } else {
    const { data: newPet } = await supabase.from('pets').insert({ ...petData, photo_url }).select('id').single();
    petId = newPet?.id;
  }

  // Auto-log weight record if weight changed
  if (newWeight && petId) {
    const weightChanged = !pet || pet.weight_kg !== newWeight;
    if (weightChanged) {
      await supabase.from('weight_records').insert({
        pet_id: petId,
        weight_kg: newWeight,
        date: new Date().toISOString().split('T')[0],
      });
    }
  }

  return Astro.redirect('/dashboard?saved=1');
}

// Check if current breed is in the list (for "Other" logic)
const breedInList = pet?.breed ? DOG_BREEDS.includes(pet.breed as typeof DOG_BREEDS[number]) : false;
const isOtherBreed = pet?.breed && !breedInList;
const isCatPet = ((pet as any)?.species ?? 'dog') === 'cat';

// Premium + suscripción propia (para avisos al eliminar cuenta). Ninguna
// depende de la otra, así que se piden a la vez.
const [premium, ownSubRes] = await Promise.all([
  getPremiumStatus(supabase, user.id),
  supabase
    .from('user_subscriptions')
    .select('source, premium_until, cancel_scheduled_at')
    .eq('user_id', user.id)
    .maybeSingle(),
]);
const isPremium = premium.isPremium;
const ownSub = ownSubRes.data;
const subVigente = !!(ownSub?.premium_until && new Date(ownSub.premium_until) > new Date());
const hasActiveWebSub = ownSub?.source === 'web' && subVigente && !ownSub.cancel_scheduled_at;
const hasActiveIapSub = ownSub?.source === 'iap' && subVigente;

// El TOTAL de gastos es visible para todos; el desglose por categoría es premium.
let spending = { alimento: 0, vet: 0, grooming: 0, vuelos: 0, snacks: 0, preventivos: 0, total: 0 };
if (pet) {
  // Use admin client for the spending rollup. RLS is sometimes flaky in the
  // SSR context for cross-table aggregations (especially vet_visits where
  // multiple PERMISSIVE policies + SECURITY DEFINER helpers interact). It's
  // safe to bypass RLS here because:
  //   1. We've already validated `pet.id` belongs to this user via getActivePet
  //   2. Every query is filtered by `pet_id = pet.id`
  //   3. We only return aggregated sums, not row data
  // Mirrors the pattern used by evaluatePremiumWithSharing in lib/premium.ts.
  const admin = createSupabaseAdminClient();
  const [vetRes, groomRes, flightRes, treatRes, prevRes, foodRes] = await Promise.all([
    admin.from('vet_visits').select('cost').eq('pet_id', pet.id).not('cost', 'is', null),
    admin.from('groomings').select('cost').eq('pet_id', pet.id).not('cost', 'is', null),
    admin.from('flights').select('ticket_price').eq('pet_id', pet.id).not('ticket_price', 'is', null),
    admin.from('treats').select('price').eq('pet_id', pet.id).not('price', 'is', null),
    admin.from('preventive_treatments').select('cost').eq('pet_id', pet.id).not('cost', 'is', null),
    admin.from('foods').select('price').eq('pet_id', pet.id).not('price', 'is', null),
  ]);
  // `sumAmounts` es la MISMA función que usa /alimentacion y el resumen del
  // móvil. Antes cada sitio sumaba a su manera y el total del perfil podía no
  // coincidir con el de la pantalla de la que venía el gasto.
  spending.alimento = sumAmounts(foodRes.data, 'price');
  spending.vet = sumAmounts(vetRes.data, 'cost');
  spending.grooming = sumAmounts(groomRes.data, 'cost');
  spending.vuelos = sumAmounts(flightRes.data, 'ticket_price');
  spending.snacks = sumAmounts(treatRes.data, 'price');
  spending.preventivos = sumAmounts(prevRes.data, 'cost');
  spending.total = Math.round(
    (spending.alimento + spending.vet + spending.grooming +
     spending.vuelos + spending.snacks + spending.preventivos) * 100,
  ) / 100;
}

// Co-owner data
let coOwners: { id: string; shared_with: string; email: string; name: string }[] = [];
let pendingInvite: { token: string; expires_at: string } | null = null;
let ownerEmail = '';
const inviteTokenParam = Astro.url.searchParams.get('invite_token');

try {
  if (pet && isOwner) {
    const admin = createSupabaseAdminClient();
    // La invitación pendiente no depende de los co-dueños: se piden juntas.
    const invitePromise = inviteTokenParam
      ? admin.from('pet_share_invites')
          .select('token, expires_at')
          .eq('token', inviteTokenParam)
          .maybeSingle()
      : admin.from('pet_share_invites')
          .select('token, expires_at')
          .eq('pet_id', pet.id)
          .eq('inviter_id', user.id)
          .eq('status', 'pending')
          .order('created_at', { ascending: false })
          .limit(1)
          .maybeSingle();

    const [sharesRes, inviteRes] = await Promise.all([
      admin.from('pet_shares').select('id, shared_with').eq('pet_id', pet.id),
      invitePromise,
    ]);
    pendingInvite = inviteRes.data;

    const shares = sharesRes.data;
    if (shares && shares.length > 0) {
      // Antes esto era un for con await adentro: un viaje por co-dueño, en
      // fila. Con Promise.all los N tardan lo que tardaba uno.
      const perfiles = await Promise.all(
        shares.map(async (share: { id: string; shared_with: string }) => {
          const { data: { user: sharedUser } } = await admin.auth.admin.getUserById(share.shared_with);
          const sharedName = sharedUser?.user_metadata?.full_name || sharedUser?.user_metadata?.name || '';
          return {
            id: share.id,
            shared_with: share.shared_with,
            email: sharedUser?.email ?? 'Usuario',
            name: sharedName,
          };
        }),
      );
      coOwners.push(...perfiles);
    }
  }

  // Owner email for co-owners viewing the pet
  if (pet && !isOwner) {
    const admin = createSupabaseAdminClient();
    const { data: { user: ownerUser } } = await admin.auth.admin.getUserById(pet.user_id);
    ownerEmail = ownerUser?.email ?? '';
  }
} catch (_e) {
  // Admin client unavailable — co-owner section won't show, page still works
}

const origin = new URL(Astro.request.url).origin;
---

<MainLayout title={isNew ? 'Registra a tu mascota' : 'Perfil'}>
  {isNew ? (
    <div class="mb-6 animate-fade-up">
      <!-- Hero welcome card -->
      <div class="relative overflow-hidden rounded-3xl px-6 py-8 text-center text-white shadow-xl mb-4" style="background-color: var(--color-accent);">
        <!-- Decorative circles -->
        <div class="absolute -top-8 -right-8 h-32 w-32 rounded-full bg-white/5"></div>
        <div class="absolute -bottom-6 -left-6 h-24 w-24 rounded-full bg-white/5"></div>

        <div class="relative">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl shadow-inner">
            🐾
          </div>
          <p class="text-2xl font-bold tracking-tight">
            ¡Hola, {firstName}!
          </p>
          <p class="mt-2 text-sm text-white/70 leading-relaxed max-w-xs mx-auto">
            Vamos a registrar a tu mascota. Solo toma un minuto y tendrás su pasaporte digital listo.
          </p>
        </div>

        <!-- Steps -->
        <div class="relative mt-6 flex items-center justify-center gap-2 text-xs text-white/60">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-white font-bold text-xs">1</span>
          <span>Datos</span>
          <span class="h-px w-4 bg-white/20"></span>
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 font-bold text-xs">2</span>
          <span>Foto</span>
          <span class="h-px w-4 bg-white/20"></span>
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 font-bold text-xs">3</span>
          <span>Vacunas</span>
        </div>
      </div>
    </div>
  ) : (
    <SectionHeader title="Perfil" subtitle="Datos de tu mascota" />
  )}

  <!-- Profile completion badge (top) -->
  {pet && (
    <div class="mb-4 animate-fade-up">
      {isProfileComplete ? (
        <div class="rounded-2xl border border-accent/30 bg-accent/5 px-5 py-4 flex items-center gap-4">
          <img src="/badges/perfil-completo.png" alt="Perfil completo" class="h-14 w-14 shrink-0 object-contain" />
          <div>
            <p class="text-sm font-bold text-accent-dark">¡Perfil completo!</p>
            <p class="text-xs text-muted mt-0.5">El pasaporte de {pet.name} tiene toda la información.</p>
          </div>
        </div>
      ) : (
        <div class="rounded-2xl border border-card-border bg-white px-5 py-4">
          <div class="flex items-center gap-4 mb-3">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-canvas text-2xl">
              🔒
            </div>
            <div class="flex-1">
              <p class="text-sm font-bold text-ink">Perfil completo</p>
              <p class="text-xs text-muted mt-0.5">{completedFields} de {totalFields} campos completados</p>
              <div class="mt-2 h-1.5 w-full rounded-full bg-card-border overflow-hidden">
                <div class="h-full bg-accent rounded-full transition-all duration-500" style={`width:${completionPct}%`}></div>
              </div>
            </div>
          </div>
          <p class="text-xs text-muted">Completa todos los datos del perfil para desbloquear esta insignia.</p>
        </div>
      )}
    </div>
  )}

  <Card variant="elevated" class="animate-fade-up animate-fade-up-delay-1">
    <details class="group" open={isNew || errorParam === 'name_required' || !pet}>
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <div class="flex items-center gap-3">
          <img
            src={pet?.photo_url || '/icons/default-pet.svg'}
            alt=""
            class="h-12 w-12 rounded-2xl object-cover border border-card-border shrink-0"
          />
          <div>
            <p class="text-sm font-semibold text-ink">{pet?.name || 'Sin nombre'}</p>
            <p class="text-xs text-muted">
              {pet?.breed || 'Sin raza'}
              {pet?.birth_date && ` · ${calculateAge(pet.birth_date)}`}
            </p>
          </div>
        </div>
        <svg class="h-4 w-4 text-muted transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>

      <form method="POST" enctype="multipart/form-data" class="space-y-6 mt-4 pt-4 border-t border-card-border/50">
      <!-- Photo -->
      <div class="flex flex-col items-center gap-3">
        <div class="relative">
          <img
            id="photo-preview"
            src={pet?.photo_url || '/icons/default-pet.svg'}
            alt="Foto de mascota"
            class="h-28 w-28 rounded-3xl object-cover border-2 border-card-border shadow-md"
          />
          <label class="absolute -bottom-2 -right-2 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-accent text-white shadow-lg transition-all hover:bg-accent-dark active:scale-95">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
            <input type="file" name="photo" accept="image/*" class="hidden" id="photo-input" />
          </label>
        </div>
        <p class="text-xs text-gray-400">Toca para cambiar la foto</p>
      </div>

      <!-- Section: Datos Básicos -->
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-xs font-semibold text-muted uppercase tracking-widest">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
          Datos Básicos
        </div>

        <Input label="Nombre" name="name" value={pet?.name || ''} required placeholder="Ej: Luna" />

        {/* Raza: solo perros — los gatos usan un perfil felino general sin raza */}
        {!isCatPet && (
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Raza</label>
            <select
              name="breed"
              id="breed-select"
              class="field-input"
            >
              <option value="">Seleccionar raza</option>
              {DOG_BREEDS.map((breed) => (
                <option value={breed} selected={pet?.breed === breed || (isOtherBreed && breed === 'Other')}>
                  {breed}
                </option>
              ))}
            </select>
            <input
              type="text"
              name="breed_other"
              id="breed-other-input"
              placeholder="Escribe la raza"
              value={isOtherBreed ? pet?.breed : ''}
              class:list={[
                'mt-2 field-input',
                { hidden: !isOtherBreed },
              ]}
            />
          </div>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input label="Fecha de nacimiento" name="birth_date" type="date" value={pet?.birth_date || ''} />
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Género</label>
            <select
              name="gender"
              class="field-input"
            >
              <option value="">Seleccionar</option>
              <option value="macho" selected={pet?.gender === 'macho'}>Macho ♂️</option>
              <option value="hembra" selected={pet?.gender === 'hembra'}>Hembra ♀️</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input label="Ciudad de nacimiento" name="birth_city" value={pet?.birth_city || ''} placeholder="Ej: Bogotá" />
