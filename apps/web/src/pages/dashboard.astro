---
import PassportCard from '../components/PassportCard.astro';
import WeightChart from '../components/WeightChart';
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { buildVaccineOverview, calculateAge, computeFoodStats, formatDate, isPreventiveType, preventiveNextDue } from '@vivra/shared';
import { getActivePet } from '../lib/pet';
import { calculateVitalityScore } from '@vivra/shared';
import type { ScoreInput } from '@vivra/shared';

import { BREED_FACTS, CAT_FACTS } from '@vivra/shared';
import type { DogBreed } from '@vivra/shared';
import { getPremiumStatus } from '../lib/premium';

const { supabase, user, activePetId } = Astro.locals;
const isNewlyOnboarded = Astro.url.searchParams.get('onboarded') === '1';

// One-shot: if the user just joined via a co-owner invite, show a personalized
// banner with the pet name + owner name + App Store CTA. Cookie value is the
// pet_id (set in /api/auth/callback when a pending_share_invite is processed).
// We consume + delete here so the banner only shows once.
const incomingShareCookie = Astro.cookies.get('incoming_share')?.value;
let incomingShare: { petName: string; ownerName: string } | null = null;
if (incomingShareCookie && incomingShareCookie !== '1') {
  // Look up pet + owner display name (best-effort)
  try {
    const { data: sharedPet } = await supabase
      .from('pets')
      .select('name, user_id')
      .eq('id', incomingShareCookie)
      .maybeSingle();
    if (sharedPet) {
      const { createSupabaseAdminClient } = await import('../lib/supabase');
      const admin = createSupabaseAdminClient();
      const { data: owner } = await admin.auth.admin.getUserById(sharedPet.user_id);
      const ownerName =
        owner?.user?.user_metadata?.full_name ||
        owner?.user?.user_metadata?.name ||
        owner?.user?.email?.split('@')[0] ||
        'el dueño';
      incomingShare = { petName: sharedPet.name, ownerName };
    }
  } catch {
    incomingShare = { petName: 'esta mascota', ownerName: 'el dueño' };
  }
} else if (incomingShareCookie === '1') {
  // Legacy cookie value (pre-R9c) — show generic banner
  incomingShare = { petName: 'la mascota', ownerName: 'el dueño' };
}
if (incomingShareCookie) {
  Astro.cookies.delete('incoming_share', { path: '/' });
}

const { pet, pets } = await getActivePet(supabase, user.id, activePetId);

if (!pet) {
  return Astro.redirect('/onboarding');
}

const [
  premium,
  { data: allGroomings, error: allGroomingsError },
  { data: allVaccines, error: allVaccinesError },
  { data: allVetVisits, error: allVetVisitsError },
  { data: weightRecords, error: weightRecordsError },
  { data: foods, error: foodsError },
  { data: allPreventives, error: allPreventivesError },
] = await Promise.all([
  getPremiumStatus(supabase, user.id),
  supabase.from('groomings').select('type, date').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('vaccines').select('id, name, date_given, next_due').eq('pet_id', pet.id).order('date_given', { ascending: false }),
  supabase.from('vet_visits').select('date, reason').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('weight_records').select('weight_kg, date').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('foods').select('brand, daily_grams, bag_size, bag_unit, price, type, food_type, start_date, end_date, notes, created_at').eq('pet_id', pet.id).order('created_at', { ascending: false }),
  // All preventives (antipulgas, desparasitante, combinado) in one call.
  // 'combinado' rows count as BOTH antipulgas and desparasitante for next-due.
  supabase.from('preventive_treatments').select('type, date_given, next_due, product_name').eq('pet_id', pet.id).order('date_given', { ascending: false }),
]);

const dataLoadFailed = [allGroomingsError, allVaccinesError, allVetVisitsError, weightRecordsError, foodsError, allPreventivesError].some(Boolean);

// Split preventives — 'combinado' counts for both
const preventives = (allPreventives ?? []).flatMap(treatment => {
  if (!isPreventiveType(treatment.type)) return [];
  return [{
    ...treatment,
    type: treatment.type,
    next_due: preventiveNextDue(pet.species, treatment.date_given, treatment.next_due),
  }];
});
const lastAntipulgas = preventives.filter(p => p.type === 'antipulgas' || p.type === 'combinado');
const lastDesparasitante = preventives.filter(p => p.type === 'desparasitante' || p.type === 'combinado');

// Derived counts and recent items from full queries
const vaccineCount = allVaccines?.length ?? 0;
const visitCount = allVetVisits?.length ?? 0;

// The dashboard uses the latest record of each vaccine name. Only a saved
// next_due date can make a dose pending — never an inferred annual schedule.
const vaccineOverview = buildVaccineOverview(allVaccines ?? []);
// Food insights — averages across all logged bags. The owner already knows
// when food runs out; we surface trazabilidad (cost, duration) instead.
const foodStats = computeFoodStats((foods ?? []).map(f => ({
  brand: f.brand,
  food_type: f.food_type ?? f.type,
  type: f.type,
  daily_grams: f.daily_grams,
  bag_size: f.bag_size,
  bag_unit: f.bag_unit,
  start_date: f.start_date,
  end_date: f.end_date,
  price: f.price,
  created_at: f.created_at,
})));


// Vitality Score — same full data as /salud for consistent results
const vitalityInput: ScoreInput = {
  pet: {
    species: pet.species ?? 'dog',
    breed: pet.breed ?? null,
    birth_date: pet.birth_date ?? null,
    weight_kg: pet.weight_kg ?? null,
    gender: pet.gender ?? null,
    is_neutered: pet.is_neutered ?? null,
  },
  weightRecords: weightRecords ?? [],
  vaccines: allVaccines ?? [],
  vetVisits: allVetVisits ?? [],
  groomings: (allGroomings ?? []).map(g => ({ date: g.date })),
  foods: (foods ?? []).filter(f => f.daily_grams && f.bag_size),
  preventives: preventives.map(p => ({ type: p.type, date_given: p.date_given, next_due: p.next_due })),
};
const dashScore = calculateVitalityScore(vitalityInput);

// Short pillar names for the compact bar display
const SHORT_PILLAR: Record<string, string> = {
  'Peso': 'Peso',
  'Cuidado preventivo': 'Preventivo',
  'Raza y edad': 'Raza',
  'Nutrición': 'Nutrición',
};

// Preventive treatment reminders use a confirmed next date, never an inferred interval.
// A past application without a next date is a valid historical record, not an
// overdue treatment and not a "never applied" state.
function preventiveStatus(
  lastDate: string | null | undefined,
  nextDue: string | null | undefined,
): { hasRecord: boolean; hasDue: boolean; daysLeft: number; overdue: boolean } {
  if (!lastDate) return { hasRecord: false, hasDue: false, daysLeft: 0, overdue: false };
  if (!nextDue) return { hasRecord: true, hasDue: false, daysLeft: 0, overdue: false };
  const next = new Date(`${nextDue}T00:00:00`);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  next.setHours(0, 0, 0, 0);
  const daysLeft = Math.ceil((next.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
  return { hasRecord: true, hasDue: true, daysLeft, overdue: daysLeft < 0 };
}

const antipulgasInfo = preventiveStatus(lastAntipulgas?.[0]?.date_given, lastAntipulgas?.[0]?.next_due);
const desparasitanteInfo = preventiveStatus(lastDesparasitante?.[0]?.date_given, lastDesparasitante?.[0]?.next_due);


// "Qué hacer hoy" — priority actions
type DashAction = { href: string; icon: string; iconBg: string; iconColor: string; label: string; detail: string; urgent: boolean };
const todoActions: DashAction[] = [];

// Fact del día — rota por día del año. Gatos usan CAT_FACTS (no manejan raza);
// perros usan los de su raza con fallback a los genéricos.
const isCat = (pet.species ?? 'dog') === 'cat';
const breedFacts = isCat
  ? CAT_FACTS
  : (pet.breed ? BREED_FACTS[pet.breed as DogBreed] : BREED_FACTS['Other']);
const dayOfYear = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000);
const dailyFact = breedFacts?.length
  ? breedFacts[dayOfYear % breedFacts.length]
  : null;

// Weight trend
const latestWeight = weightRecords?.[0]?.weight_kg ?? pet.weight_kg;
const prevWeight = weightRecords?.[1]?.weight_kg;
const weightDiff = latestWeight && prevWeight ? +(latestWeight - prevWeight).toFixed(1) : null;

const profileComplete = !!(pet.photo_url && pet.chip_id && pet.color);

// Checklist
const checklistItems = [
  { done: (vaccineCount ?? 0) > 0,   href: '/salud/vacunas?new=1', label: 'Agregar vacuna',           sub: 'Rabia, Parvovirus, Moquillo u otras',           iconColor: 'bg-accent/10', iconStroke: 'text-accent',    icon: '<path d="m14.5 2-8.5 8.5v4h4l8.5-8.5a2.83 2.83 0 0 0-4-4z"/><path d="m18 2 4 4"/>' },
  { done: (visitCount ?? 0) > 0,     href: '/salud/historial',    label: 'Agregar cita veterinaria', sub: 'Registra visitas al vet y próximas citas',       iconColor: 'bg-blue-50',   iconStroke: 'text-blue-500',  icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
  { done: (weightRecords?.length ?? 0) > 0, href: '/salud/peso?new=1', label: 'Registrar peso',      sub: 'Lleva el historial de peso desde hoy',          iconColor: 'bg-sky-50',    iconStroke: 'text-sky-500',   icon: '<circle cx="12" cy="12" r="10"/><path d="M8 12a4 4 0 0 1 8 0"/><line x1="12" y1="12" x2="12" y2="8"/>' },
  { done: profileComplete,            href: '/perfil',              label: 'Completar perfil',          sub: 'Foto, microchip, color de pelaje',               iconColor: 'bg-amber/10',  iconStroke: 'text-amber-dark',icon: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>' },
].filter(item => !item.done);

// ── Generación de notificaciones ────────────────────────────────────────────
//
// OJO — aquí vivía un bug de spam. La deduplicación construía el set con
// `${type}::${message}` pero comparaba contra claves de OTRO formato
// (`weight_reminder::${días}`, `vaccine_overdue::${nombre}`), así que NUNCA
// coincidían: cada carga del dashboard insertaba una notificación nueva.
// Un usuario acumuló 30 avisos idénticos de peso en un solo día.
//
// Ahora se usa la misma estrategia que el cron de push (send-push): ventana
// de enfriamiento por (mascota, tipo). Los tipos coinciden con los del cron
// A PROPÓSITO, para que los dos sistemas compartan el enfriamiento y el
// usuario no reciba el mismo aviso por duplicado desde la web y desde el push.
try {
  if (dataLoadFailed) throw new Error('Dashboard records unavailable');
  const COOLDOWNS: Record<string, number> = {
    preventive_due: 7,
    vaccine_due: 30,
    weight_stale: 30,
    score_improved: 7,
  };

  const maxCooldown = Math.max(...Object.values(COOLDOWNS));
  const { data: recentNotifs } = await supabase
    .from('notifications')
    .select('type, created_at')
    .eq('user_id', user.id)
    .eq('pet_id', pet.id)
    .gte('created_at', new Date(Date.now() - maxCooldown * 86400000).toISOString());

  // Fecha del aviso más reciente de cada tipo para esta mascota.
  const ultimoPorTipo = new Map<string, number>();
  for (const n of recentNotifs ?? []) {
    if (!n.created_at) continue;
    const t = new Date(n.created_at).getTime();
    if (!ultimoPorTipo.has(n.type) || t > ultimoPorTipo.get(n.type)!) {
      ultimoPorTipo.set(n.type, t);
    }
  }

  /** true si ya pasó el enfriamiento y se puede volver a avisar. */
  const puedeAvisar = (tipo: string): boolean => {
    const ultimo = ultimoPorTipo.get(tipo);
    if (!ultimo) return true;
    return (Date.now() - ultimo) / 86400000 >= (COOLDOWNS[tipo] ?? 14);
  };

  const rawSnapshot = Astro.cookies.get('pet_snapshot')?.value;
  const snapshot = rawSnapshot ? JSON.parse(rawSnapshot) as { score?: number; petId?: string } : null;
  const isSamePet = snapshot?.petId === pet.id;
  const prevScore = (isSamePet ? snapshot?.score : null) ?? 0;

  // `icon` guarda un NOMBRE de icono, no un emoji: lo dibuja <Icon> en la web
  // y Ionicons en la app. Un emoji se ve distinto en cada sistema y no hereda
  // el color del tema.
  const newNotifications: Array<{ type: string; title: string; message: string; icon: string; href: string }> = [];

  if (dashScore.showScore && prevScore > 0 && dashScore.total >= prevScore + 5 && puedeAvisar('score_improved')) {
    newNotifications.push({
      type: 'score_improved',
      title: `${pet.name}: su bienestar mejoró`,
      message: `El bienestar de ${pet.name} subió a ${dashScore.total}/100`,
      icon: 'score',
      href: '/salud',
    });
  }

  // Preventivos vencidos o por vencer, únicamente si el usuario confirmó
  // una próxima fecha para ese producto.
  for (const [info, etiqueta] of [
    [antipulgasInfo, 'antipulgas'],
    [desparasitanteInfo, 'desparasitante'],
  ] as const) {
    if (!info.hasDue || info.daysLeft > 1) continue;
    if (!puedeAvisar('preventive_due')) break;
    newNotifications.push({
      type: 'preventive_due',
      title: info.overdue ? `${pet.name}: ${etiqueta} vencido` : `${pet.name}: ${etiqueta} próximo`,
      message: info.overdue
        ? `El ${etiqueta} de ${pet.name} ya venció. Aplícalo cuanto antes.`
        : info.daysLeft === 0
          ? `Hoy toca el ${etiqueta} de ${pet.name}`
          : `Mañana toca el ${etiqueta} de ${pet.name}`,
      icon: 'preventivo',
      href: '/salud/preventivos',
    });
    break; // un solo aviso de preventivos por ciclo, no uno de cada tipo
  }

  // Vaccines use the next date confirmed by the user or veterinarian.
  // Never infer an annual booster from a past dose.
  if (puedeAvisar('vaccine_due')) {
    const { data: allVaccinesByDate } = await supabase
      .from('vaccines')
      .select('id, name, date_given, next_due')
      .eq('pet_id', pet.id)
      .order('date_given', { ascending: false });
    const vacunasVigentes = buildVaccineOverview(allVaccinesByDate ?? []).latestByName;
    for (const v of vacunasVigentes) {
      if (!v.next_due) continue;
      const dias = Math.ceil((new Date(`${v.next_due}T00:00:00`).getTime() - Date.now()) / 86400000);
      if (dias <= 7) {
        newNotifications.push({
          type: 'vaccine_due',
          title: `${pet.name}: vacuna pendiente`,
          message: dias < 0
            ? `La próxima fecha registrada para ${v.name} de ${pet.name} ya pasó. Confirma el refuerzo con tu vet.`
            : dias === 0
              ? `Hoy corresponde la vacuna de ${v.name} de ${pet.name}.`
              : `La vacuna de ${v.name} de ${pet.name} tiene próxima fecha en ${dias} días.`,
          icon: 'vacuna',
          href: '/salud/vacunas',
        });
        break; // una sola por ciclo, aunque haya varias vencidas
      }
    }
  }

  // Sin registro de peso en 30+ días. Mismo tipo que el cron (`weight_stale`)
  // para que compartan enfriamiento; antes la web usaba `weight_reminder` y
  // el push `weight_stale`, así que el usuario recibía los dos.
  const lastWeightDate = weightRecords?.[0]?.date;
  if (lastWeightDate && puedeAvisar('weight_stale')) {
    const dias = Math.floor((Date.now() - new Date(lastWeightDate + 'T00:00:00').getTime()) / 86400000);
    if (dias >= 30) {
      newNotifications.push({
        type: 'weight_stale',
        title: `${pet.name}: hora de pesar`,
        message: `Llevas ${dias} días sin pesar a ${pet.name}`,
        icon: 'peso',
        href: '/salud/peso',
      });
    }
  }

  if (newNotifications.length > 0) {
    await supabase.from('notifications').insert(
      newNotifications.map(n => ({ ...n, user_id: user.id, pet_id: pet.id, dismissed: false }))
    );
  }

  Astro.cookies.set('pet_snapshot', JSON.stringify({
    score: dashScore.total,
    petId: pet.id,
  }), { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 365, secure: import.meta.env.PROD });
} catch (_) {
  // Si algo falla, el dashboard se muestra igual: las notificaciones nunca
  // deben poder tumbar la página.
}

// Build "Qué hacer hoy" actions
if (antipulgasInfo.hasDue && (antipulgasInfo.overdue || antipulgasInfo.daysLeft <= 3)) {
  todoActions.push({
    href: '/salud/preventivos',
    icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
    iconBg: antipulgasInfo.overdue ? 'bg-red-50' : 'bg-amber/10',
    iconColor: antipulgasInfo.overdue ? 'text-red-500' : 'text-amber-600',
    label: antipulgasInfo.overdue ? 'Antipulgas vencido' : `Antipulgas en ${antipulgasInfo.daysLeft}d`,
    detail: 'Aplicar tratamiento',
    urgent: antipulgasInfo.overdue,
  });
} else if (!antipulgasInfo.hasRecord) {
  todoActions.push({
    href: '/salud/preventivos',
    icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
    iconBg: 'bg-accent-light', iconColor: 'text-accent',
    label: 'Registrar antipulgas', detail: 'Primera aplicacion', urgent: false,
  });
}

if (desparasitanteInfo.hasDue && (desparasitanteInfo.overdue || desparasitanteInfo.daysLeft <= 3)) {
  todoActions.push({
    href: '/salud/preventivos',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    iconBg: desparasitanteInfo.overdue ? 'bg-red-50' : 'bg-amber/10',
    iconColor: desparasitanteInfo.overdue ? 'text-red-500' : 'text-amber-600',
    label: desparasitanteInfo.overdue ? 'Desparasitante vencido' : `Desparasitante en ${desparasitanteInfo.daysLeft}d`,
    detail: 'Aplicar tratamiento',
    urgent: desparasitanteInfo.overdue,
  });
} else if (!desparasitanteInfo.hasRecord) {
  todoActions.push({
    href: '/salud/preventivos',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    iconBg: 'bg-accent-light', iconColor: 'text-accent',
    label: 'Registrar desparasitante', detail: 'Primera aplicacion', urgent: false,
  });
}

if (!latestWeight) {
  todoActions.push({
    href: '/salud/peso?new=1',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M8 12a4 4 0 0 1 8 0"/><line x1="12" y1="12" x2="12" y2="8"/>',
    iconBg: 'bg-sky-50', iconColor: 'text-sky-500',
    label: 'Registrar peso', detail: 'Primer registro', urgent: false,
  });
}

if (vaccineCount === 0) {
  todoActions.push({
    href: '/salud/vacunas?new=1',
    icon: '<path d="m14.5 2-8.5 8.5v4h4l8.5-8.5a2.83 2.83 0 0 0-4-4z"/><path d="m18 2 4 4"/>',
    iconBg: 'bg-accent/10', iconColor: 'text-accent',
    label: 'Agregar vacuna', detail: 'Rabia, Parvovirus, etc.', urgent: false,
  });
}

todoActions.sort((a, b) => (b.urgent ? 1 : 0) - (a.urgent ? 1 : 0));
const topActions = todoActions.slice(0, 4);

const scoreColor = ({ '#22c55e': '#378655', '#f59e0b': '#B77D35', '#f97316': '#B7853C', '#94a3b8': '#87958B' } as Record<string, string>)[dashScore.color.toLowerCase()] || dashScore.color;
const displayName = (user.user_metadata?.full_name || user.user_metadata?.name || '').split(' ')[0];
const recentActivity = [
  ...(allVaccines ?? []).map(record => ({ title: record.name, subtitle: 'Vacuna registrada', date: record.date_given, icon: 'vacuna', href: '/salud/vacunas', tone: 'sage' })),
  ...(allVetVisits ?? []).map(record => ({ title: record.reason, subtitle: 'Visita veterinaria', date: record.date, icon: 'vet', href: '/salud/historial', tone: 'coral' })),
  ...(allGroomings ?? []).map(record => ({ title: 'Grooming', subtitle: 'Cuidado registrado', date: record.date, icon: 'grooming', href: '/salud/grooming', tone: 'coral' })),
  ...(foods ?? []).map(record => ({ title: record.brand, subtitle: 'Alimentación', date: record.start_date || record.created_at || '', icon: 'comida', href: '/alimentacion', tone: 'sand' })),
].filter(record => record.date).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const upcoming = [
  ...vaccineOverview.schedule.map(record => ({ title: record.name, date: record.next_due!, href: '/salud/vacunas', icon: 'vacuna', tone: 'coral' })),
  ...[lastAntipulgas[0], lastDesparasitante[0]].filter((record, index, all) => record?.next_due && all.indexOf(record) === index).map(record => ({ title: record.product_name || 'Preventivo', date: record.next_due!, href: '/salud/preventivos', icon: 'preventivo', tone: 'sage' })),
].sort((a, b) => a.date.localeCompare(b.date)).slice(0, 4);
const quickActions = [
  { label: 'Visita vet', icon: 'vet', href: '/salud/historial?new=1', tone: 'sage' },
  { label: 'Vacuna', icon: 'vacuna', href: '/salud/vacunas?new=1', tone: 'coral' },
  { label: 'Alimento', icon: 'comida', href: '/alimentacion', tone: 'sand' },
  { label: 'Viaje', icon: 'vuelo', href: '/viajes', tone: 'sky' },
  { label: 'Peso', icon: 'peso', href: '/salud/peso?new=1', tone: 'lavender' },
  { label: 'Grooming', icon: 'grooming', href: '/salud/grooming', tone: 'sand' },
];
---

<MainLayout title="Inicio">
  {incomingShare && <div class="dashboard-notice">Ahora compartes a {incomingShare.petName} con {incomingShare.ownerName}. Su información está disponible en este panel.</div>}
  {isNewlyOnboarded && <div class="dashboard-notice">El perfil de {pet.name} está listo. Puedes completar su historial poco a poco.</div>}
  <div class="dashboard-heading"><div><h1>Hola{displayName ? `, ${displayName}` : ''} <span class="sun" aria-hidden="true">☀</span></h1><p>Así va el día de {pet.name}. Todo su cuidado, en un solo lugar.</p></div><time datetime={new Date().toISOString().slice(0,10)}>{new Date().toLocaleDateString('es', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}</time></div>
  {dataLoadFailed ? <div class="dashboard-notice" role="alert"><h2>No pudimos cargar su historial</h2><p>Revisa tu conexión y vuelve a intentar. Tus registros siguen guardados.</p><a href="/dashboard">Volver a cargar →</a></div> : <div class="dashboard-columns">
    <div class="dashboard-main">
      <section class="pets-grid" aria-label="Tus mascotas">
        {pets.map(profile => <article class:list={['dashboard-card', 'pet-overview', { 'selected-pet': profile.id === pet.id }]}>
          <form method="POST" action="/api/pets/switch"><input type="hidden" name="pet_id" value={profile.id} /><button type="submit" class="pet-select" aria-label={`Ver a ${profile.name}`}>
            <img src={profile.photo_url || '/icons/default-pet.svg'} alt="" width="82" height="82" />
            <div><h2>{profile.name} <span aria-hidden="true">›</span></h2><p>{[profile.birth_date ? calculateAge(profile.birth_date) : '', profile.breed || (profile.species === 'cat' ? 'Gato' : 'Perro')].filter(Boolean).join(' · ')}</p></div>
          </button></form>
          <div class="pet-metrics">
            <span><Icon name="score" class="h-4 w-4"/><strong>{profile.id === pet.id && dashScore.showScore ? dashScore.total : '—'}</strong><small>{profile.id === pet.id ? 'Bienestar' : 'Selecciona'}</small></span>
            <span><Icon name="peso" class="h-4 w-4"/><strong>{(profile.id === pet.id ? latestWeight : profile.weight_kg) ?? '—'} kg</strong><small>{profile.id === pet.id ? 'Último peso' : 'Peso del perfil'}</small></span>
            <span><Icon name="documento" class="h-4 w-4"/><strong>{profile.chip_id ? 'Microchip' : 'Perfil'}</strong><small>{profile.chip_id ? 'Registrado' : 'Ver datos'}</small></span>
          </div>
        </article>)}
        {pets.length === 1 && <a href="/onboarding?add=1" class="dashboard-card add-pet-card"><span>＋</span><h2>Su familia puede crecer</h2><p>Agrega otra mascota y cuídalas juntas.</p><b>Agregar mascota →</b></a>}
      </section>
      <div class="metrics-grid">
        <section class="dashboard-card wellbeing"><div class="card-heading"><h2>Bienestar</h2><a href="/salud">Ver detalles ›</a></div><div class="wellbeing-body">
          <a href="/salud" class="score-ring" aria-label={dashScore.showScore ? `Bienestar: ${dashScore.total} de 100` : 'Completa los registros de bienestar'}><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="51" fill="none" stroke="#DDE3D9" stroke-width="8"/><circle cx="60" cy="60" r="51" fill="none" stroke={dashScore.showScore ? scoreColor : '#BFCBBC'} stroke-width="8" stroke-linecap="round" stroke-dasharray="320.44" stroke-dashoffset={320.44 * (1 - (dashScore.showScore ? dashScore.total : 0) / 100)} transform="rotate(-90 60 60)"/></svg><div><strong>{dashScore.showScore ? dashScore.total : '—'}</strong><small>{dashScore.showScore ? 'Vitality Score' : 'Completando'}</small></div></a>
          <div class="pillar-list">{dashScore.pillars.map(pillar => <div><span>{SHORT_PILLAR[pillar.name] || pillar.name}</span><i><b style={`width:${pillar.isEstimated ? 0 : pillar.pct}%;background:${scoreColor}`} /></i><small>{pillar.isEstimated ? '—' : Math.round(pillar.pct)}</small></div>)}</div>
        </div><p class="wellbeing-caption">{dashScore.headline}</p></section>
        <section class="dashboard-card weight-card"><div class="card-heading"><h2>Evolución del peso</h2><a href="/salud/peso">{pet.name} ›</a></div><div class="weight-summary"><strong>{latestWeight ?? '—'} <small>kg</small></strong>{weightDiff !== null && <span>{weightDiff > 0 ? '+' : ''}{weightDiff} kg desde el anterior</span>}</div><WeightChart records={[...(weightRecords ?? [])].reverse().slice(-12)} compact /></section>
      </div>
      <div class="bottom-grid">
        <section class="dashboard-card"><div class="card-heading"><h2>Actividad reciente</h2><a href="/salud">Ver todo ›</a></div>{recentActivity.length ? recentActivity.map(record => <a href={record.href} class="activity-row"><span class:list={['category-icon', record.tone]}><Icon name={record.icon} class="h-5 w-5" /></span><div><h3>{record.title}</h3><p>{record.subtitle}</p></div><time>{formatDate(record.date)}</time><span aria-hidden="true">›</span></a>) : <div class="dashboard-empty"><Icon name="documento" class="h-8 w-8" /><p>Su historia empieza contigo.</p><a href="/salud/vacunas?new=1">Agregar su primer registro →</a></div>}</section>
        <section class="travel-feature"><div><h2>Planea y disfruta<br />cada aventura,<br />juntos.</h2><p>Su salud y documentos,<br />siempre a mano.</p><a href="/viajes">Explorar viajes <span aria-hidden="true">→</span></a></div><img src="/welcome-pets.jpg" alt="" width="1536" height="1024" loading="lazy" /></section>
      </div>
      {checklistItems.length > 0 && <details class="dashboard-card first-steps"><summary>Primeros pasos con {pet.name} <span>{checklistItems.length} por completar</span></summary><div>{checklistItems.map(item => <a href={item.href}>{item.label} <span>›</span></a>)}</div></details>}
      {topActions.length > 0 && <details class="dashboard-card first-steps"><summary>Cuidados por revisar <span>{topActions.length}</span></summary><div>{topActions.map(item => <a href={item.href}>{item.label} <span>›</span></a>)}</div></details>}
      {dailyFact && <p class="daily-fact">{dailyFact.fact}</p>}
    </div>
    <aside class="dashboard-aside">
      <section class="dashboard-card"><div class="card-heading"><h2>Lo próximo</h2><a href="/calendario">Ver todo ›</a></div>{upcoming.length ? upcoming.map(event => <a href={event.href} class="upcoming-row"><span class:list={['category-icon', event.tone]}><Icon name={event.icon} class="h-5 w-5" /></span><div><h3>{event.title}</h3><p>{pet.name} · {formatDate(event.date)}</p></div><span aria-hidden="true">›</span></a>) : <div class="dashboard-empty"><Icon name="calendario" class="h-7 w-7"/><p>No hay próximas fechas registradas.</p><a href="/calendario">Abrir calendario →</a></div>}</section>
      <section class="dashboard-card"><div class="card-heading"><h2>Acciones rápidas</h2></div><div class="quick-grid">{quickActions.map(action => <a href={action.href} class={action.tone}><Icon name={action.icon} class="h-7 w-7"/><span>{action.label}</span></a>)}</div></section>
      <section class="dashboard-card passport-summary"><div class="card-heading"><h2>Pasaporte de viaje</h2><a href="/pasaporte">Ver ›</a></div><PassportCard pet={pet} compact /><a href="/pasaporte" class="document-link"><Icon name="documento" class="h-5 w-5"/><span>Documentos de {pet.name}</span><span aria-hidden="true">›</span></a></section>
      {foodStats.latestFood && <section class="dashboard-card"><div class="card-heading"><h2>Alimentación</h2><a href="/alimentacion">Ver ›</a></div><p class="nutrition-brand">{foodStats.latestFood.brand}</p><p class="daily-fact">Lleva sus compras, porciones y cambios de alimento.</p></section>}
      {premium.isTrial && <a href="/premium" class="dashboard-notice">Estás probando Vivra Premium. Ver mi plan →</a>}
    </aside>
  </div>}
</MainLayout>

<style>
  .dashboard-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:26px; }
  .dashboard-heading h1 { font-size:clamp(26px,2.5vw,36px); font-weight:600; letter-spacing:-1.4px; line-height:1.2; }
  .sun { font-size:31px; font-weight:400; color:#D5A14D; margin-left:8px; }
  .dashboard-heading p { margin-top:7px; color:#6E7872; font-size:14px; line-height:1.5; }
  .dashboard-heading time { font-size:11px; color:#6E7872; white-space:nowrap; padding-top:10px; }
  .dashboard-columns { display:grid; grid-template-columns:minmax(0,2.55fr) minmax(275px,1fr); gap:18px; align-items:start; }
  .dashboard-main,.dashboard-aside { min-width:0; display:grid; gap:18px; }
  .pets-grid,.metrics-grid,.bottom-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .dashboard-card { min-width:0; background:#FFFDFABF; border:1px solid #EBE7DF; border-radius:18px; padding:20px; box-shadow:0 4px 20px #244B3603; }
  .card-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:20px; }
  h2 { font-size:15px; font-weight:600; letter-spacing:-.3px; }
  .card-heading a { font-size:10px; white-space:nowrap; color:#174C3C; padding-block:4px; }
  .pet-select { display:flex; align-items:center; gap:16px; width:100%; text-align:left; cursor:pointer; }
  .pet-select img { width:76px; height:76px; object-fit:cover; border-radius:50%; background:#E5DFD4; }
  .pet-select h2 { font-size:20px; }
  .pet-select h2 span { font-weight:400; margin-left:6px; }
  .pet-select p { margin-top:6px; font-size:11px; color:#6E7872; line-height:1.5; }
  .selected-pet { border-color:#D9E1D5; }
  .pet-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:20px; }
  .pet-metrics>span { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:5px; padding:11px 4px; border-radius:9px; background:#EBF1E7; color:#174C3C; font-size:10px; }
  .pet-metrics>span:nth-child(3) { background:#F6EDDC; color:#84632F; }
  .pet-metrics strong { font-weight:600; }.pet-metrics small { width:100%; text-align:center; font-size:9px; color:#61746B; }
  .add-pet-card { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; background:#F1F1E8; gap:10px; }
  .add-pet-card>span { font-size:24px; color:#174C3C; }.add-pet-card p { color:#6E7872; font-size:12px; }.add-pet-card b { font-size:12px; color:#174C3C; font-weight:500; }
  .wellbeing-body { display:flex; align-items:center; gap:18px; }.score-ring { position:relative; width:120px; height:120px; flex-shrink:0; }.score-ring>div { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; align-items:center; }.score-ring strong { font-size:40px; font-weight:600; letter-spacing:-2px; }.score-ring small { font-size:9px; color:#61746B; }
  .pillar-list { flex:1; min-width:0; }.pillar-list>div { display:flex; gap:8px; align-items:center; padding:10px 0; font-size:10px; }.pillar-list span { width:54px; }.pillar-list i { height:5px; flex:1; border-radius:10px; background:#E8E8DF; overflow:hidden; }.pillar-list b { display:block; height:100%; border-radius:10px; }.pillar-list small { color:#6E7872; min-width:16px; text-align:right; }.wellbeing-caption { font-size:10px; color:#6E7872; margin-top:12px; line-height:1.5; }
  .weight-summary { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:13px; }.weight-summary strong { font-size:23px; font-weight:600; }.weight-summary small { font-size:12px; font-weight:400; }.weight-summary span { font-size:9px; color:#6E7872; }
  .category-icon { width:36px; height:36px; display:grid; place-items:center; border-radius:10px; flex-shrink:0; }.sage { background:#E7EFE5; color:#28714D; }.coral { background:#FAE8E3; color:#C76E5D; }.sand { background:#F6EAD8; color:#AE7939; }.sky { background:#E5EDF0; color:#557F96; }.lavender { background:#ECE8F1; color:#7B789D; }
  .activity-row,.upcoming-row { display:flex; align-items:center; gap:11px; padding:13px 0; border-bottom:1px solid #EDE9E2; }.activity-row:last-child,.upcoming-row:last-child { border:0; padding-bottom:0; }.activity-row>div,.upcoming-row>div { flex:1; min-width:0; }h3 { font-size:11px; font-weight:500; line-height:1.5; }.activity-row p,.upcoming-row p { color:#6E7872; font-size:10px; margin-top:3px; line-height:1.5; }.activity-row time { font-size:9px; white-space:nowrap; color:#6E7872; }.activity-row>span:last-child,.upcoming-row>span:last-child { color:#7F8A82; }
  .quick-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }.quick-grid a { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; padding:14px 4px; border-radius:11px; }.quick-grid span { font-size:10px; text-align:center; color:#14231F; }.quick-grid a:hover { filter:brightness(.97); }
  .travel-feature { position:relative; isolation:isolate; overflow:hidden; border-radius:18px; min-height:250px; background:#E3E9DE; padding:28px; }.travel-feature>div { position:relative; z-index:1; }.travel-feature h2 { font-size:23px; line-height:1.2; color:#174C3C; letter-spacing:-.7px; }.travel-feature p { font-size:11px; line-height:1.6; margin-top:14px; }.travel-feature a { display:inline-flex; gap:12px; background:#174C3C; color:white; border-radius:30px; padding:11px 15px; font-size:11px; margin-top:18px; }.travel-feature img { position:absolute; right:-74px; bottom:0; width:280px; height:220px; object-fit:cover; object-position:62%; mix-blend-mode:multiply; mask-image:linear-gradient(to bottom,transparent,#000 22%); opacity:.9; z-index:0; }
  .document-link { display:flex; align-items:center; gap:10px; margin-top:15px; font-size:11px; }.document-link>span:first-of-type { flex:1; }.dashboard-empty { min-height:130px; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:13px; color:#738271; font-size:12px; text-align:center; }.dashboard-empty a { color:#174C3C; font-size:11px; }
  .first-steps { padding:16px 20px; }.first-steps summary { cursor:pointer; font-size:13px; font-weight:500; }.first-steps summary>span { float:right; color:#6E7872; font-size:11px; }.first-steps>div { margin-top:14px; }.first-steps a { display:flex; justify-content:space-between; padding:10px 0; border-top:1px solid #E8E4DC; font-size:12px; }.daily-fact { font-size:11px; color:#6E7872; line-height:1.6; }.nutrition-brand { font-size:16px; font-weight:500; margin-bottom:8px; }.dashboard-notice { padding:18px; border:1px solid #D5DFCC; background:#E5EDE1; border-radius:16px; margin-bottom:18px; font-size:13px; line-height:1.6; }
  @media(max-width:1270px) { .dashboard-columns { grid-template-columns:minmax(0,1fr) 270px; }.pets-grid,.metrics-grid,.bottom-grid { grid-template-columns:1fr; }.travel-feature { min-height:240px; }.travel-feature img { right:0; } }
  @media(max-width:760px) { .dashboard-columns { grid-template-columns:1fr; }.dashboard-heading time { display:none; }.dashboard-heading h1 { font-size:29px; }.dashboard-heading p { font-size:12px; }.dashboard-aside { grid-template-columns:1fr; }.dashboard-card { padding:20px; }.first-steps summary>span { float:none; display:block; margin-top:6px; } }
</style>
