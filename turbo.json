{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".vercel/output/**"
      ],
      "env": [
        "PUBLIC_SUPABASE_URL",
        "PUBLIC_SUPABASE_ANON_KEY",
        "PUBLIC_SENTRY_DSN"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.*",
        "$TURBO_ROOT$/packages/shared/**"
      ]
    }
  }
}
