          </div>
          <a href="https://apps.apple.com/app/vivra/id6761087142" target="_blank" rel="noopener" data-track="download_app_dashboard" class="shrink-0 rounded-lg bg-ink px-3 py-1.5 text-xs font-semibold text-white hover:bg-ink/80 transition-colors">
            Descargar
          </a>
        </div>
      </div>
    </div>
