    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Vivra",
      "url": "https://vivrapet.com",
      "inLanguage": "es"
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Vivra es gratis?",
          "acceptedAnswer": { "@type": "Answer", "text": "Sí. Las funciones esenciales (vacunas, peso, veterinario, pasaporte) son gratis para siempre. Hay un plan premium opcional con analytics avanzados, codueño compartido, exportar PDF y más." }
        },
        {
          "@type": "Question",
          "name": "¿Funciona sin internet?",
          "acceptedAnswer": { "@type": "Answer", "text": "Necesitas conexión para sincronizar entre iPhone y web. La app móvil cachea datos para consultas rápidas cuando estás fuera de cobertura." }
        },
        {
          "@type": "Question",
          "name": "¿Solo funciona para perros?",
          "acceptedAnswer": { "@type": "Answer", "text": "Funciona para perros y gatos. Los perros tienen perfiles por raza; los gatos usan un perfil felino general. Puedes tener varios, todos gratis." }
        },
        {
          "@type": "Question",
          "name": "¿Puedo compartir la mascota con mi pareja o familia?",
          "acceptedAnswer": { "@type": "Answer", "text": "Sí. Con plan premium puedes agregar un codueño — comparten la misma vista de la mascota desde sus propias cuentas. El codueño hereda premium mientras tu lo tengas activo." }
        },
        {
          "@type": "Question",
          "name": "¿Mis datos están seguros?",
          "acceptedAnswer": { "@type": "Answer", "text": "Conexión cifrada (HTTPS), datos almacenados en Supabase con Row Level Security. Solo tu ingresas a la info de tu mascota. Sin publicidad, sin venta de datos." }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el Indicador de Bienestar?",
          "acceptedAnswer": { "@type": "Answer", "text": "Es un número del 0 al 100 que resume qué tan completo y al día está el registro de salud de tu mascota en cuatro áreas: peso, cuidado preventivo, raza y edad, y alimentación. No es un diagnóstico médico, sube cuando agregas información y te muestra qué te falta por registrar." }
        },
        {
          "@type": "Question",
          "name": "¿La app me dice cuánta comida darle a mi perro?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. La porción ideal la define tu veterinario o nutricionista según tu mascota. Vivra solo lleva el registro de qué le das, cuánto gastas y cuánto dura cada bolsa." }
        }
      ]
    })} />

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --orange: #F97316;
        --orange-dark: #EA6C0A;
        --orange-light: rgba(249,115,22,0.10);
        --ink: #0F1117;
        --ink-2: #1A1D26;
        --muted: #6B7280;
        --muted-light: #9CA3AF;
        --card-border: #EAECF0;
        --canvas: #F7F8FA;
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: white;
        color: var(--ink);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      a { color: inherit; }

      /* ────────────────────────────────────────────
         NAV — fixed, blur, minimal
         ──────────────────────────────────────────── */
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 32px; height: 64px;
        background: rgba(255,255,255,0.78);
        backdrop-filter: saturate(180%) blur(18px);
        -webkit-backdrop-filter: saturate(180%) blur(18px);
        border-bottom: 1px solid rgba(15,17,23,0.06);
      }
      .nav-logo { display: flex; align-items: center; text-decoration: none; }
      .nav-logo img { height: 64px; width: auto; }
      .nav-links { display: flex; align-items: center; gap: 8px; }
      .nav-link-text {
        font-size: 14px; font-weight: 500; color: var(--ink);
        text-decoration: none; padding: 8px 14px; border-radius: 8px;
        opacity: 0.65; transition: opacity 0.15s, background 0.15s;
      }
      .nav-link-text:hover { opacity: 1; background: rgba(15,17,23,0.04); }
      .nav-cta {
        background: var(--ink); color: white; border: none;
        padding: 9px 18px; border-radius: 999px;
        font-size: 13px; font-weight: 600; cursor: pointer;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
      }
      .nav-cta:hover { background: var(--ink-2); transform: translateY(-1px); }
      @media (max-width: 640px) {
        nav { padding: 0 16px; }
        /* Se ocultan los enlaces de sección, pero NO "Entrar": sin él, un usuario
           que ya tiene cuenta no tiene cómo iniciar sesión desde el móvil salvo
           bajando hasta el footer — y la mayoría del tráfico es móvil. */
        .nav-links .nav-link-text:not(.nav-login) { display: none; }
        .nav-links .nav-login { opacity: 1; font-weight: 600; padding: 8px 10px; }
        .nav-links { gap: 2px; }
      }

      /* ────────────────────────────────────────────
         HERO — light, warm, bold
         ──────────────────────────────────────────── */
      .hero {
        position: relative;
        background: white;
        color: var(--ink);
        padding: 140px 32px 120px;
        overflow: hidden;
        isolation: isolate;
      }
      .hero::before {
        content: '';
        position: absolute; inset: 0; z-index: -1;
        background:
          radial-gradient(ellipse 60% 40% at 80% 20%, rgba(249,115,22,0.10) 0%, transparent 60%),
          radial-gradient(ellipse 50% 60% at 20% 80%, rgba(249,115,22,0.06) 0%, transparent 70%);
      }
      .hero::after {
        content: '';
        position: absolute; inset: 0; z-index: -1;
        background-image:
          linear-gradient(to right, rgba(15,17,23,0.035) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(15,17,23,0.035) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black, transparent 80%);
      }
      .hero-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 64px;
        align-items: center;
      }
      .hero-pill {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(249,115,22,0.08);
        border: 1px solid rgba(249,115,22,0.25);
        color: var(--orange-dark);
        padding: 6px 14px; border-radius: 999px;
        font-size: 12px; font-weight: 600; letter-spacing: 0.4px;
        margin-bottom: 28px;
      }
      .hero-pill-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--orange); box-shadow: 0 0 8px var(--orange);
      }
      .hero h1 {
        font-size: clamp(40px, 6.5vw, 76px);
        font-weight: 900; line-height: 1.02;
        letter-spacing: -3px;
        margin: 0 0 24px;
      }
      .hero h1 .gradient-text {
        background: linear-gradient(110deg, #F97316 0%, #EA580C 55%, #C2410C 100%);
        -webkit-background-clip: text; background-clip: text;
        color: transparent;
      }
      .hero p.lead {
        font-size: clamp(17px, 1.8vw, 21px);
        color: var(--muted);
        max-width: 540px;
        line-height: 1.55;
        margin: 0 0 40px;
      }
      .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
      .btn-primary {
        background: var(--orange); color: white;
        padding: 15px 30px; border-radius: 12px;
        font-size: 15px; font-weight: 700; text-decoration: none;
        display: inline-flex; align-items: center; gap: 10px;
        box-shadow: 0 8px 32px rgba(249,115,22,0.35);
        transition: all 0.15s ease;
      }
      .btn-primary:hover { background: var(--orange-dark); transform: translateY(-2px); box-shadow: 0 12px 40px rgba(249,115,22,0.5); }
      .btn-primary svg { width: 16px; height: 16px; }
      .btn-secondary-dark {
        background: white;
        color: var(--ink);
        border: 1.5px solid var(--card-border);
        padding: 14px 26px; border-radius: 12px;
        font-size: 14px; font-weight: 600; text-decoration: none;
        display: inline-flex; align-items: center; gap: 10px;
        transition: all 0.15s ease;
      }
      .btn-secondary-dark:hover { border-color: var(--ink); transform: translateY(-2px); }
      .hero-trust {
        margin-top: 36px;
        display: flex; align-items: center; gap: 24px;
        color: var(--muted);
        font-size: 12px; font-weight: 500;
      }
      .hero-trust-item { display: inline-flex; align-items: center; gap: 6px; }
      .hero-trust-item svg { width: 14px; height: 14px; opacity: 0.7; }

      /* HERO MOCKUP */
      .hero-mockup-wrap {
        position: relative;
        display: flex; justify-content: center;
      }
      .hero-mockup-wrap::before {
        content: '';
        position: absolute;
        width: 380px; height: 380px;
        background: radial-gradient(circle, rgba(249,115,22,0.22) 0%, transparent 65%);
        filter: blur(70px);
        z-index: 0;
      }
      /* Screenshots reales de la app en marcos de iPhone — 3 en desktop, 1 en mobile */
      .hero-phones {
        position: relative;
        display: flex; align-items: center; justify-content: center;
      }
      .hero-phones img {
        background: #13161C;
        border: 6px solid #13161C;
        border-radius: 34px;
        box-shadow: 0 24px 48px rgba(15,17,23,0.25);
        height: auto;
      }
      .phone-main {
        position: relative; z-index: 2;
        width: 250px;
      }
      .phone-side {
        position: absolute; z-index: 1;
        width: 190px;
        opacity: 0.92;
      }
      .phone-side.left  { transform: rotate(-7deg) translateX(-150px) translateY(18px); }
      .phone-side.right { transform: rotate(7deg) translateX(150px) translateY(18px); }
      @media (max-width: 1100px) {
        .phone-side.left  { transform: rotate(-7deg) translateX(-120px) translateY(18px); }
        .phone-side.right { transform: rotate(7deg) translateX(120px) translateY(18px); }
      }
      @media (max-width: 900px) {
        .phone-side { display: none; }
        .phone-main { width: 260px; }
      }

      @media (max-width: 900px) {
        .hero { padding: 120px 24px 80px; text-align: center; }
        .hero-inner { grid-template-columns: 1fr; gap: 48px; }
        .hero p.lead { margin-left: auto; margin-right: auto; }
        .hero-actions { justify-content: center; }
        .hero-trust { justify-content: center; flex-wrap: wrap; }
      }

      /* ────────────────────────────────────────────
         LOGO STRIP / TRUST BAR — minimal
         ──────────────────────────────────────────── */
      .trust-bar {
        background: var(--canvas);
        border-top: 1px solid var(--card-border);
        border-bottom: 1px solid var(--card-border);
        padding: 32px 24px;
      }
      .trust-bar-inner {
        max-width: 1100px; margin: 0 auto;
        display: flex; flex-wrap: wrap; justify-content: center;
        gap: 40px;
        color: var(--muted);
        font-size: 13px; font-weight: 500;
        text-align: center;
      }
      .trust-bar-item {
        display: inline-flex; align-items: center; gap: 8px;
      }
      .trust-bar-item svg { width: 16px; height: 16px; opacity: 0.7; }

      /* ────────────────────────────────────────────
         HOW IT WORKS — 3 steps
         ──────────────────────────────────────────── */
      .how-section {
        padding: 120px 24px 80px;
        background: white;
      }
      .section-inner { max-width: 1100px; margin: 0 auto; }
      .section-eyebrow {
        font-size: 11px; font-weight: 700; letter-spacing: 3.2px;
        text-transform: uppercase; color: var(--orange);
        display: block; margin-bottom: 16px;
      }
      .section-title {
        font-size: clamp(32px, 4.8vw, 52px);
        font-weight: 900; letter-spacing: -2px;
        line-height: 1.05;
        margin-bottom: 16px;
      }
      .section-sub {
        font-size: clamp(16px, 1.6vw, 19px);
        color: var(--muted);
        max-width: 620px;
        line-height: 1.6;
        margin-bottom: 64px;
      }
      .how-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        counter-reset: step;
      }
      .how-card {
        position: relative;
        background: var(--canvas);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        padding: 48px 32px 32px;
        transition: all 0.2s ease;
      }
      .how-card:hover { border-color: rgba(249,115,22,0.3); transform: translateY(-4px); }
      .how-card::before {
        counter-increment: step;
        content: counter(step);
        position: absolute; top: 24px; right: 28px;
        font-size: 56px; font-weight: 900;
        color: rgba(15,17,23,0.06);
        line-height: 1;
      }
      .how-icon {
        width: 48px; height: 48px;
        background: white;
        border: 1px solid var(--card-border);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 24px;
        font-size: 22px;
      }
      .how-card h3 { font-size: 20px; font-weight: 800; letter-spacing: -0.4px; margin-bottom: 8px; }
      .how-card p { font-size: 14px; color: var(--muted); line-height: 1.6; }
      @media (max-width: 768px) { .how-grid { grid-template-columns: 1fr; } }

      /* ────────────────────────────────────────────
         FEATURES — bento grid
         ──────────────────────────────────────────── */
      .features-section {
        padding: 80px 24px 120px;
        background: white;
      }
      .features-bento {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
      }
      .bento-card {
        background: white;
        border: 1px solid var(--card-border);
        border-radius: 24px;
        padding: 32px 28px;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
      }
      .bento-card:hover { box-shadow: 0 16px 48px rgba(0,0,0,0.08); transform: translateY(-3px); border-color: rgba(15,17,23,0.12); }
      .bento-card.featured {
        grid-column: span 2;
        grid-row: span 1;
        background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
        border-color: rgba(249,115,22,0.25);
        color: var(--ink);
        display: flex;
        gap: 32px;
        align-items: stretch;
        padding: 40px;
      }
      .bento-card.featured::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 60% 80% at 100% 0%, rgba(249,115,22,0.10) 0%, transparent 60%);
        pointer-events: none;
      }
      .bento-icon {
        width: 44px; height: 44px;
        background: var(--orange-light);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 18px; font-size: 22px;
      }
      .bento-card h3 { font-size: 18px; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 6px; }
      .bento-card p { font-size: 14px; color: var(--muted); line-height: 1.55; }
      .bento-card.featured h3 { color: var(--ink); font-size: 22px; }
      .bento-card.featured p { color: var(--muted); font-size: 15px; }
      .score-preview { flex: 1; min-width: 0; position: relative; z-index: 1; }
      .score-visual {
        flex: 0 0 200px;
        background: white;
        border: 1px solid rgba(249,115,22,0.20);
        border-radius: 18px;
        padding: 20px;
        display: flex; flex-direction: column; justify-content: center;
        position: relative; z-index: 1;
      }
      .score-circle {
        width: 88px; height: 88px; border-radius: 50%;
        border: 3px solid var(--orange);
        background: rgba(249,115,22,0.06);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        margin-bottom: 18px; align-self: center;
      }
      .score-circle-n { font-size: 30px; font-weight: 900; color: var(--orange); line-height: 1; }
      .score-circle-l { font-size: 8px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); margin-top: 3px; }
      .score-bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
      .score-bar-row:last-child { margin-bottom: 0; }
      .score-bar-name { font-size: 10px; color: var(--muted); width: 56px; }
      .score-bar-bg { flex: 1; height: 4px; background: rgba(15,17,23,0.08); border-radius: 999px; overflow: hidden; }
      .score-bar-fill { height: 100%; background: linear-gradient(90deg, var(--orange), #FFB74A); border-radius: 999px; }
      .score-bar-val { font-size: 10px; color: var(--muted); width: 18px; text-align: right; font-variant-numeric: tabular-nums; }

      @media (max-width: 768px) {
        .features-bento { grid-template-columns: 1fr; }
        .bento-card.featured { grid-column: span 1; flex-direction: column; padding: 32px; }
        .score-visual { flex: none; }
      }

      /* ────────────────────────────────────────────
         PASSPORT SECTION — dark accent
         ──────────────────────────────────────────── */
      .passport-section {
        padding: 120px 24px;
        background: var(--canvas);
        color: var(--ink);
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .passport-section::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(249,115,22,0.06) 0%, transparent 60%);
        pointer-events: none;
      }
      .passport-section .section-eyebrow { color: var(--orange); }
      .passport-section .section-sub {
        color: var(--muted);
        max-width: 480px;
        margin: 0 auto 56px;
      }
      .passport-preview {
        max-width: 320px; margin: 0 auto;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(249,115,22,0.18), 0 0 0 1px var(--card-border);
        text-align: left;
        position: relative;
      }
      .pp-cover {
        background: linear-gradient(160deg, #7C2D12, #EA580C);
        padding: 28px 24px;
        text-align: center;
      }
      .pp-cover p { color: rgba(255,255,255,0.6); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; }
      .pp-cover h3 { color: white; font-size: 20px; font-weight: 900; letter-spacing: 4px; text-transform: uppercase; margin-top: 8px; }
      .pp-body { padding: 18px 22px; }
      .pp-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px dashed #E5E7EB; color: var(--ink); }
      .pp-row:last-child { border-bottom: none; }
      .pp-label { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 1.3px; }
      .pp-value { font-size: 13px; font-weight: 700; }

      /* ────────────────────────────────────────────
         APP STORE CTA SECTION
         ──────────────────────────────────────────── */
      .appstore-section {
        padding: 120px 24px;
        background: white;
        text-align: center;
      }
      .appstore-section .appstore-card {
        max-width: 720px; margin: 0 auto;
        background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
        color: white;
        border-radius: 32px;
        padding: 64px 48px;
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }
      .appstore-card::before {
        content: '';
        position: absolute; inset: 0; z-index: -1;
        background: radial-gradient(ellipse 60% 60% at 100% 0%, rgba(255,255,255,0.18) 0%, transparent 60%);
      }
      .appstore-card .pill {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.30);
        color: white;
        padding: 6px 16px; border-radius: 999px;
        font-size: 12px; font-weight: 600; letter-spacing: 0.4px;
        margin-bottom: 24px;
      }
      .appstore-card h2 {
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 900; letter-spacing: -2px;
        line-height: 1.05; margin-bottom: 16px;
      }
      .appstore-card p {
        color: rgba(255,255,255,0.85);
        font-size: 17px; line-height: 1.6;
        max-width: 460px; margin: 0 auto 36px;
      }
      .appstore-btn {
        display: inline-flex; align-items: center; gap: 14px;
        background: black;
        color: white; text-decoration: none;
        padding: 14px 28px; border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.15);
        transition: all 0.15s ease;
      }
      .appstore-btn:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.5); box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
      .appstore-btn-text { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
      .appstore-btn-text small { font-size: 11px; opacity: 0.75; letter-spacing: 0.3px; }
      .appstore-btn-text strong { font-size: 19px; font-weight: 700; letter-spacing: -0.4px; }

      /* ────────────────────────────────────────────
         PRICING
         ──────────────────────────────────────────── */
      .pricing-section { padding: 100px 24px; background: white; }
      .pricing-grid {
        display: grid; grid-template-columns: 1fr 1fr;
        gap: 20px; max-width: 820px; margin: 0 auto;
      }
      .price-card {
        border: 1px solid var(--card-border);
        border-radius: 24px;
        padding: 36px 32px;
        background: white;
        display: flex; flex-direction: column;
      }
      .price-card.featured {
        border: 2px solid var(--orange);
        box-shadow: 0 16px 48px rgba(249,115,22,0.12);
        position: relative;
      }
      .price-badge {
        position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
        background: var(--orange); color: white;
        font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
        padding: 4px 14px; border-radius: 999px; white-space: nowrap;
      }
      .price-name { font-size: 14px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 12px; }
      .price-amount { font-size: 44px; font-weight: 900; letter-spacing: -2px; color: var(--ink); line-height: 1; }
      .price-amount small { font-size: 16px; font-weight: 600; color: var(--muted); letter-spacing: 0; }
      .price-alt { font-size: 13px; color: var(--muted); margin-top: 6px; }
      .price-alt strong { color: var(--orange-dark); }
      .price-features { list-style: none; margin: 24px 0 28px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
      .price-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--ink); line-height: 1.45; }
      .price-features li svg { width: 16px; height: 16px; flex: none; margin-top: 2px; color: var(--orange); }
      .price-features li.muted { color: var(--muted); }
      .price-cta {
        display: block; text-align: center;
        padding: 13px 24px; border-radius: 12px;
        font-size: 14px; font-weight: 700; text-decoration: none;
        transition: all 0.15s ease;
      }
      .price-cta.solid { background: var(--orange); color: white; box-shadow: 0 6px 20px rgba(249,115,22,0.30); }
      .price-cta.solid:hover { background: var(--orange-dark); transform: translateY(-2px); }
      .price-cta.ghost { border: 1.5px solid var(--card-border); color: var(--ink); }
      .price-cta.ghost:hover { border-color: var(--ink); }
      .pricing-note { text-align: center; font-size: 12px; color: var(--muted); margin-top: 24px; }
      @media (max-width: 700px) { .pricing-grid { grid-template-columns: 1fr; } }

      /* ────────────────────────────────────────────
         FAQ SECTION
         ──────────────────────────────────────────── */
      .faq-section { padding: 100px 24px; background: var(--canvas); }
      .faq-grid { display: grid; gap: 12px; max-width: 720px; margin: 0 auto; }
      .faq-item {
        background: white;
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 22px 26px;
      }
      .faq-item summary {
        cursor: pointer; list-style: none;
        display: flex; align-items: center; justify-content: space-between;
        font-size: 16px; font-weight: 700; color: var(--ink);
      }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after {
        content: '+'; font-size: 22px; font-weight: 300; color: var(--muted);
        transition: transform 0.2s ease;
      }
      .faq-item[open] summary::after { transform: rotate(45deg); color: var(--orange); }
      .faq-item p {
        margin-top: 14px; font-size: 14px; color: var(--muted); line-height: 1.65;
      }

      /* ────────────────────────────────────────────
         FINAL CTA
         ──────────────────────────────────────────── */
      .final-cta {
        padding: 120px 24px;
        background: white;
        text-align: center;
      }
      .final-cta h2 {
        font-size: clamp(36px, 5.5vw, 64px);
        font-weight: 900; letter-spacing: -2.5px;
        line-height: 1.02; margin-bottom: 20px;
      }
      .final-cta h2 span {
        background: linear-gradient(110deg, var(--orange), #FFB74A);
        -webkit-background-clip: text; background-clip: text;
        color: transparent;
      }
      .final-cta p {
        color: var(--muted); font-size: 18px; line-height: 1.55;
        max-width: 460px; margin: 0 auto 40px;
      }
      .final-cta-actions {
        display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center;
      }
      .btn-light-secondary {
        background: white; color: var(--ink);
        border: 1.5px solid var(--card-border);
        padding: 15px 30px; border-radius: 12px;
        font-size: 15px; font-weight: 600; text-decoration: none;
        transition: all 0.15s ease;
      }
      .btn-light-secondary:hover { border-color: var(--ink); transform: translateY(-2px); }

      /* ────────────────────────────────────────────
         FOOTER
         ──────────────────────────────────────────── */
      footer {
        background: var(--canvas);
        border-top: 1px solid var(--card-border);
        color: var(--muted);
        padding: 48px 32px 32px;
      }
      .footer-inner {
        max-width: 1100px; margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 48px;
      }
      .footer-brand img { height: 32px; width: auto; margin-bottom: 12px; }
      .footer-brand p { font-size: 13px; line-height: 1.6; max-width: 260px; }
      .footer-col h4 { color: var(--ink); font-size: 13px; font-weight: 700; margin-bottom: 14px; letter-spacing: 0.3px; }
      .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
      .footer-col a { color: var(--muted); text-decoration: none; font-size: 13px; transition: color 0.15s; }
      .footer-col a:hover { color: var(--orange-dark); }
      .footer-bottom {
        max-width: 1100px; margin: 32px auto 0;
        padding-top: 24px;
        border-top: 1px solid var(--card-border);
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
        font-size: 12px;
      }
      .footer-bottom .made-in { color: var(--muted); }
      @media (max-width: 768px) {
        .footer-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
        .footer-brand { grid-column: span 2; }
      }
    </style>
  </head>
