---
/**
 * Iconos SVG en línea, por nombre.
 *
 * Reemplazan a los emojis que hacían de icono en toda la app. Un emoji se
 * dibuja distinto en cada sistema operativo, no hereda el color del tema y
 * en un contexto de salud se lee como poco serio. Estos son trazos que
 * heredan `currentColor` y se ven igual en todas partes.
 *
 * Trazos de Lucide (ISC), copiados en línea para no cargar una librería
 * entera por unos cuantos iconos.
 */
interface Props {
  name: string;
  /** Clases del <svg>. Incluye tamaño y color, ej. "h-5 w-5 text-accent". */
  class?: string;
}

