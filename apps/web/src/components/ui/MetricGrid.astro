---
export interface Metric {
  value: string;
  label: string;
  href?: string;
  tone?: 'default' | 'warning' | 'danger';
}

interface Props {
  items: Metric[];
}

const { items } = Astro.props;
const gridClass = items.length >= 4 ? 'sm:grid-cols-4' : items.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<div class:list={['grid grid-cols-2 gap-3', gridClass]}>
  {items.map(item => (
    <div class:list={[
      'rounded-2xl border px-4 py-3 text-center',
      item.tone === 'danger' ? 'border-red-200 bg-red-50' : item.tone === 'warning' ? 'border-amber-200 bg-amber-50' : 'border-card-border bg-card',
    ]}>
      {item.href ? (
        <a href={item.href} class:list={['text-lg font-black transition-colors', item.tone === 'danger' ? 'text-red-500 hover:text-red-600' : item.tone === 'warning' ? 'text-amber-600 hover:text-amber-700' : 'text-accent hover:text-accent-dark']}>{item.value}</a>
      ) : (
        <p class:list={['text-lg font-black', item.tone === 'danger' ? 'text-red-500' : item.tone === 'warning' ? 'text-amber-600' : 'text-ink']}>{item.value}</p>
      )}
      <p class="mt-0.5 text-[10px] font-medium text-muted">{item.label}</p>
    </div>
  ))}
</div>
