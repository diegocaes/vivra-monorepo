{
  "name": "vivra-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build:web": "turbo run build --filter=web",
    "build:shared": "turbo run build --filter=@vivra/shared",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "cd apps/mobile && npx tsc --noEmit && cd ../web && npx astro check",
    "db:types": "npx --yes supabase@2.116.0 gen types typescript --project-id upjiewrirkzhjeciwugg --schema public > packages/shared/lib/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@expo/dom-webview": "55.0.6",
      "tar": "^7.5.22",
      "postcss": "^8.5.25",
      "brace-expansion": "^5.0.9",
      "minimatch@3.1.5>brace-expansion": "^2.0.2",
      "shell-quote": "^1.10.0",
      "ws": "^8.21.1",
      "svgo": "^4.0.2",
      "defu": "^6.1.7",
      "sharp": "^0.35.3"
    }
  }
}
