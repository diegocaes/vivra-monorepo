---
import '../styles/global.css';
import Icon from '../components/ui/Icon.astro';
import Analytics from '@vercel/analytics/astro';
import Track from '../components/Track.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { createSupabaseClient } from '../lib/supabase';

if (Astro.url.searchParams.has('code') || Astro.url.searchParams.has('token_hash')) {
  return Astro.redirect(`/api/auth/callback?${Astro.url.searchParams.toString()}`);
}

// Solo consultamos Supabase Auth si hay cookie de sesión — los visitantes
// anónimos (la mayoría del tráfico de la landing) no pagan el round-trip.
const cookieHeader = Astro.request.headers.get('cookie') ?? '';
if (cookieHeader.includes('-auth-token')) {
  const supabase = createSupabaseClient(Astro.request, Astro.cookies);
  const { data: { user } } = await supabase.auth.getUser();
  if (user) {
    return Astro.redirect('/dashboard');
  }
}

const APP_STORE_URL = 'https://apps.apple.com/app/vivra/id6761087142';
