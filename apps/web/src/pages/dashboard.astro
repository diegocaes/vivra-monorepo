        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-accent-dark">Comparte con tu pareja y controla tus gastos</p>
            <p class="text-xs text-muted mt-0.5">Premium: co-dueño + desglose de gastos por categoría. Desde $2.99/mes.</p>
          </div>
          <a href="/premium" class="shrink-0 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-dark transition-colors">
            Ver Premium
          </a>
          <button type="button" id="premium-upsell-dismiss" aria-label="Cerrar" class="shrink-0 flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:bg-black/5 hover:text-ink transition-colors">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>
    <script is:inline data-astro-rerun>
      (function () {
        var banner = document.getElementById('premium-upsell-banner');
        if (!banner) return;
        var KEY = 'vivra-premium-upsell-dismissed';
        if (!localStorage.getItem(KEY)) banner.classList.remove('hidden');
        var btn = document.getElementById('premium-upsell-dismiss');
        if (btn && !btn.dataset.wired) {
          btn.dataset.wired = '1';
          btn.addEventListener('click', function () {
            localStorage.setItem(KEY, '1');
            banner.remove();
          });
        }
      })();
    </script>
    </>
  )}

  {/* ── APP BANNER (post-onboarding): informar que existe la app iOS ── */}
  {isNewlyOnboarded && (
    <div class="mb-5 rounded-2xl border border-card-border bg-white overflow-hidden animate-fade-up" id="app-banner">
      <div class="px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink">
            <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
