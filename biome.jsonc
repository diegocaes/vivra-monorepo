{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.astro",
      "!**/.expo",
      "!**/.vercel",
      "!**/.turbo",
      "!**/dist",
      "!**/ios",
      "!**/android",
      "!apps/mobile/types/supabase.ts",
      "!apps/web/src/types/supabase.ts",
      // Biome solo parsea el frontmatter de .astro, no el template: reporta como
      // "sin usar" todo lo que se consume en el markup. Un --write llegó a borrar
      // el import de MainLayout en faq.astro. Se revisan con `astro check`.
      "!**/*.astro"
    ]
  },
  // Formateo apagado a propósito: activarlo reformatearía ~39k líneas de golpe
  // y volvería irrevisable cualquier diff. Se puede adoptar archivo por archivo.
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // Evaluada caso por caso sobre los 8 hallazgos del repo: todos resultaron
        // patrones deliberados, no bugs.
        //   1. Efectos que llaman consts declarados más abajo — meterlos en las
        //      deps daría ReferenceError por TDZ (el array se evalúa en el render).
        //   2. `pet?.id` en vez de `pet`, a propósito: con el objeto completo,
        //      cualquier cambio de la mascota dispararía refetches innecesarios.
        //   3. Deps usadas como disparador (ej. `refreshing` para que el
        //      pull-to-refresh recargue contadores).
        // Reactivar si algún día se reordenan esos hooks.
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
