---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { getPremiumStatus } from '../lib/premium';
import type { PremiumStatus } from '../lib/premium';

const { supabase, user } = Astro.locals;
const premium: PremiumStatus = await getPremiumStatus(supabase, user.id);

// Checkout web con Paddle — se activa solo cuando las env vars existen.
// PUBLIC_PADDLE_ENV: 'sandbox' | 'production'
const PADDLE_TOKEN = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN ?? '';
const PADDLE_ENV = import.meta.env.PUBLIC_PADDLE_ENV ?? 'sandbox';
const PADDLE_PRICE_MONTHLY = import.meta.env.PUBLIC_PADDLE_PRICE_MONTHLY ?? '';
const PADDLE_PRICE_YEARLY = import.meta.env.PUBLIC_PADDLE_PRICE_YEARLY ?? '';
const paddleReady = !!(PADDLE_TOKEN && (PADDLE_PRICE_MONTHLY || PADDLE_PRICE_YEARLY));

// Cancelación programada de suscripción web (Paddle): premium sigue activo
// hasta cancelAt pero no se renovará.
let cancelAt: string | null = null;
let isMonthlyPlan = false;
if (premium.isPremium && premium.source === 'web') {
  const { data: subRow } = await supabase
    .from('user_subscriptions')
    .select('cancel_scheduled_at, paddle_subscription_id')
    .eq('user_id', user.id)
    .maybeSingle();
  cancelAt = subRow?.cancel_scheduled_at ?? null;

  // Para el exit offer: si el plan actual es mensual, ofrecemos cambiarse al
  // anual antes de cancelar. Consultamos el precio actual a Paddle.
  const apiKey = import.meta.env.PADDLE_API_KEY || process.env.PADDLE_API_KEY;
  if (!cancelAt && apiKey && subRow?.paddle_subscription_id) {
    try {
      const apiBase = PADDLE_ENV === 'production' ? 'https://api.paddle.com' : 'https://sandbox-api.paddle.com';
      const r = await fetch(`${apiBase}/subscriptions/${subRow.paddle_subscription_id}`, {
        headers: { 'Authorization': `Bearer ${apiKey}` },
      });
      if (r.ok) {
        const body = await r.json();
        isMonthlyPlan = body.data?.items?.[0]?.price?.id === PADDLE_PRICE_MONTHLY;
      }
    } catch { /* sin oferta si falla; el flujo de cancelar sigue funcionando */ }
  }
}
const cancelAtLabel = cancelAt
  ? new Date(cancelAt).toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const APP_STORE_URL = 'https://apps.apple.com/app/vivra/id6761087142';

// Premium = co-dueño + detalle de gastos + colores de tema. Todo lo demás es gratis.
const features = [
  { icon: 'codueno', name: 'Co-dueño', desc: 'Comparte la mascota con tu pareja: ambos ven y registran todo', free: 'No', premium: 'Sí' },
  { icon: 'gastos', name: 'Detalle de gastos', desc: 'Desglose por categoría y totales de vet, alimento, vuelos y más', free: 'Solo el total', premium: 'Completo' },
  { icon: 'colores', name: 'Colores de tema', desc: 'Personaliza el color del perfil de tu mascota', free: '2 colores', premium: 'Todos' },
  { icon: 'mascota', name: 'Varias mascotas', desc: 'Perros y gatos en una sola cuenta', free: 'Sí', premium: 'Sí' },
  { icon: 'grafica', name: 'Gráfica de peso', desc: 'Evolución del peso con gráficas detalladas', free: 'Sí', premium: 'Sí' },
  { icon: 'score', name: 'Vitality Score', desc: 'Desglose por pilar, flags y recomendaciones', free: 'Sí', premium: 'Sí' },
  { icon: 'vuelo', name: 'Pasaporte y viajes', desc: 'Documentos de vuelo y pasaporte imprimible', free: 'Sí', premium: 'Sí' },
  { icon: 'campana', name: 'Recordatorios', desc: 'Vacunas, comida, antiparasitarios y más', free: 'Sí', premium: 'Sí' },
];
---

<MainLayout title="Premium">
  <div class="max-w-lg mx-auto space-y-6 animate-fade-up">

    <!-- Header -->
    <div class="text-center">
      <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10">
        <svg class="h-8 w-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-ink">Vivra Premium</h1>
      <p class="text-sm text-muted mt-1">Desbloquea refiriendo amigos o con una suscripción</p>
    </div>

    <!-- Current status -->
    {premium.isPremium ? (
      <div class="rounded-2xl border border-accent/30 bg-accent/5 px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold text-accent-dark">Premium activo</p>
            <p class="text-xs text-muted">
              {premium.daysLeft} dias restantes
              {premium.isTrial ? ' (trial por referido)' : premium.source === 'referral' ? ' (por referidos)' : ''}
            </p>
          </div>
        </div>
        {premium.isExpiringSoon && (
          <p class="text-xs text-amber-600 mt-3 font-medium">Tu premium vence pronto. Refiere amigos para extenderlo gratis.</p>
        )}

        {/* Gestionar/cancelar según el origen de la suscripción */}
        {premium.source === 'web' && cancelAt && (
          <div class="mt-4 pt-4 border-t border-accent/20">
            <div class="rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 mb-2">
              <p class="text-xs font-semibold text-amber-700">Suscripción cancelada — no se renovará</p>
              <p class="text-xs text-amber-600 mt-0.5">Mantienes Premium hasta el {cancelAtLabel}. Después pasas a plan gratuito sin perder ningún dato.</p>
            </div>
            <button
              type="button"
              id="resume-sub-btn"
              class="text-xs font-semibold text-accent hover:text-accent-dark transition-colors"
            >
              Reanudar suscripción
            </button>
          </div>
        )}
        {premium.source === 'web' && !cancelAt && (
          <div class="mt-4 pt-4 border-t border-accent/20">
            <p class="text-xs text-muted mb-2">Suscripción contratada en la web. Si cancelas, mantienes Premium hasta el final del período pagado.</p>
            <button
              type="button"
              id="open-cancel-modal-btn"
              class="text-xs font-semibold text-red-500 hover:text-red-600 transition-colors"
            >
              Cancelar suscripción
            </button>
          </div>
        )}
        {premium.source === 'iap' && (
          <div class="mt-4 pt-4 border-t border-accent/20">
            <p class="text-xs text-muted mb-2">Suscripción contratada con tu Apple ID desde el iPhone.</p>
            <a
              href="https://apps.apple.com/account/subscriptions"
              target="_blank"
              rel="noopener"
              class="text-xs font-semibold text-accent hover:text-accent-dark transition-colors"
            >
              Gestionar o cancelar en el App Store →
            </a>
          </div>
        )}
        {['promo', 'referral', 'trial', 'shared'].includes(premium.source ?? '') && (
          <p class="text-xs text-muted mt-4 pt-4 border-t border-accent/20">
            Tu Premium es un beneficio ({premium.source === 'shared' ? 'compartido por tu co-dueño' : premium.source === 'promo' ? 'promocional' : 'por referidos'}) — no tiene ningún cobro asociado que cancelar.
          </p>
        )}
      </div>
    ) : (
      <div class="rounded-2xl border border-card-border bg-canvas px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-canvas border border-card-border">
            <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold text-ink">Plan gratuito</p>
            <p class="text-xs text-muted">Todo Vivra, gratis — Premium agrega co-dueño y desglose de gastos</p>
          </div>
        </div>
      </div>
    )}

    {premium.isPremium && (
      <div class="rounded-2xl border border-accent/25 bg-accent-light/60 p-5">
        <p class="text-xs font-semibold text-accent-dark uppercase tracking-wider mb-3">Lo que tienes activo</p>
        <div class="space-y-3">
          {[
            { icon: 'codueno', name: 'Co-dueño', desc: 'Comparte la mascota con quien la cuida contigo: ambos registran y ven todo.', href: '/perfil' },
            { icon: 'gastos', name: 'Detalle de gastos', desc: 'Desglose por categoría y el total de cada sección: vet, alimento, grooming.', href: '/perfil' },
            { icon: 'colores', name: 'Colores de tema', desc: 'Toda la paleta para el perfil de tu mascota, no solo dos.', href: '/perfil' },
          ].map((f) => (
            <a href={f.href} class="flex items-start gap-3 -mx-2 px-2 py-1.5 rounded-xl hover:bg-white/60 transition-colors">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white text-accent shadow-sm">
                <Icon name={f.icon} class="h-4 w-4" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ink">{f.name}</p>
                <p class="text-xs text-muted mt-0.5 leading-relaxed">{f.desc}</p>
              </div>
              <svg class="h-4 w-4 shrink-0 text-accent/40 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Feature comparison -->
    <div class="rounded-2xl border border-card-border bg-card overflow-hidden">
      <div class="grid grid-cols-3 gap-0 border-b border-card-border bg-canvas px-4 py-3">
        <p class="text-xs font-semibold text-muted uppercase tracking-wider col-span-1">Funcion</p>
        <p class="text-xs font-semibold text-muted uppercase tracking-wider text-center">Free</p>
        <p class="text-xs font-semibold text-accent uppercase tracking-wider text-center">Premium</p>
      </div>
      {features.map((f, i) => (
        <div class:list={['grid grid-cols-3 gap-0 px-4 py-3 items-center', i < features.length - 1 && 'border-b border-card-border']}>
          <div class="flex items-center gap-2 col-span-1">
            <span class="text-accent"><Icon name={f.icon} class="h-4 w-4" /></span>
            <div>
              <p class="text-xs font-semibold text-ink">{f.name}</p>
              <p class="text-xs text-muted leading-tight hidden sm:block">{f.desc}</p>
            </div>
          </div>
          <p class="text-xs text-muted text-center">{f.free}</p>
          <p class="text-xs text-accent-dark font-semibold text-center">{f.premium}</p>
        </div>
      ))}
    </div>

    <!-- How to get premium -->
    {!premium.isPremium && (
    <div class="rounded-2xl border border-card-border bg-card p-5">
      <p class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Cómo obtener premium</p>
      <div class="space-y-4">
        <a href="/referidos" class="flex items-start gap-3 -mx-2 px-2 py-1 rounded-xl hover:bg-canvas transition-colors">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent"><Icon name="regalo" class="h-4 w-4" /></div>
          <div class="flex-1">
            <p class="text-sm font-medium text-ink">Refiere amigos</p>
            <p class="text-xs text-muted mt-0.5">Cada amigo que se une = 1 mes premium gratis para ti</p>
          </div>
          <svg class="h-4 w-4 shrink-0 text-muted mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent"><Icon name="codueno" class="h-4 w-4" /></div>
          <div>
            <p class="text-sm font-medium text-ink">Premium compartido</p>
            <p class="text-xs text-muted mt-0.5">Si tu co-dueño tiene Premium, tú también lo obtienes</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent"><Icon name="pago" class="h-4 w-4" /></div>
          <div>
            <p class="text-sm font-medium text-ink">Suscripción</p>
            <p class="text-xs text-muted mt-0.5">$2.99/mes o $14.99/año — se contrata desde la app de iPhone (Perfil → Premium)</p>
          </div>
        </div>
      </div>
    </div>
    )}

    <!-- CTA -->
    {!premium.isPremium && (
      <div class="space-y-3">
        <a
          href="/referidos"
          class="flex items-center justify-center gap-2 w-full rounded-2xl px-6 py-3.5 text-sm font-semibold text-white transition-all active:scale-95"
          style="background:#F97316;box-shadow:0 4px 14px rgba(249,115,22,0.35);"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Invitar amigos y ganar premium
        </a>
        {paddleReady ? (
          <>
            <div class="grid grid-cols-2 gap-3">
              {PADDLE_PRICE_MONTHLY && (
                <button
                  type="button"
                  data-paddle-price={PADDLE_PRICE_MONTHLY}
                  class="paddle-buy flex flex-col items-center justify-center gap-0.5 rounded-2xl border-2 border-accent bg-card px-4 py-3.5 transition-all hover:bg-accent/5 active:scale-95"
                >
                  <span class="text-sm font-bold text-ink">$2.99/mes</span>
                  <span class="text-xs text-muted">Mensual</span>
                </button>
              )}
              {PADDLE_PRICE_YEARLY && (
                <button
                  type="button"
                  data-paddle-price={PADDLE_PRICE_YEARLY}
                  class="paddle-buy flex flex-col items-center justify-center gap-0.5 rounded-2xl border-2 border-accent bg-accent/10 px-4 py-3.5 transition-all hover:bg-accent/15 active:scale-95"
                >
                  <span class="text-sm font-bold text-accent-dark">$14.99/año</span>
                  <span class="text-xs text-accent-dark/80">Ahorra 58%</span>
                </button>
              )}
            </div>
            <p class="text-center text-xs text-muted">Pago seguro con tarjeta, Apple Pay o Google Pay. Cancela cuando quieras.</p>
          </>
        ) : (
          <>
            <a
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full rounded-2xl border border-card-border bg-card px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:border-ink active:scale-95"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              Suscribirme desde la app de iPhone
            </a>
            <p class="text-center text-xs text-muted">La suscripción se gestiona con tu Apple ID. Al suscribirte en el iPhone, Premium se activa también en la web al instante.</p>
          </>
        )}
      </div>
    )}

  </div>

  {/* ── EXIT OFFER: modal de cancelación con motivo + contraoferta ── */}
  {premium.isPremium && premium.source === 'web' && !cancelAt && (
    <div id="cancel-modal" class="fixed inset-0 z-50 items-end sm:items-center justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
      <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-2xl">
        <h3 class="text-base font-bold text-ink mb-1">Antes de que te vayas…</h3>
        <p class="text-sm text-muted mb-4">¿Qué te hizo querer cancelar? Nos ayuda a mejorar.</p>

        <div class="space-y-2 mb-4" id="cancel-reasons">
          {[
            { v: 'price', l: 'Es muy caro' },
            { v: 'not_used', l: 'No lo uso lo suficiente' },
            { v: 'missing_feature', l: 'Le falta algo que necesito' },
            { v: 'other', l: 'Otro motivo' },
          ].map(r => (
            <label class="flex items-center gap-3 rounded-xl border border-card-border px-4 py-2.5 cursor-pointer hover:bg-canvas transition-colors has-checked:border-accent has-checked:bg-accent/5">
              <input type="radio" name="cancel-reason" value={r.v} class="accent-accent" />
              <span class="text-sm text-ink">{r.l}</span>
            </label>
          ))}
          <textarea
            id="cancel-comment"
            rows="2"
            placeholder="Cuéntanos más (opcional)"
            class="w-full rounded-xl border border-card-border bg-canvas px-4 py-2.5 text-sm text-ink placeholder-muted focus:border-accent focus:outline-none resize-none"
          ></textarea>
        </div>

        {isMonthlyPlan && (
          <div class="rounded-2xl border-2 border-accent bg-accent/5 px-4 py-3.5 mb-4">
            <p class="text-sm font-bold text-ink">¿Y si mejor pagas menos?</p>
            <p class="text-xs text-muted mt-1 mb-3">Cámbiate al plan anual: <strong class="text-ink">$14.99/año</strong> — equivale a $1.25/mes, un 58% menos de lo que pagas hoy.</p>
            <button
              type="button"
              id="switch-yearly-btn"
              class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent-dark transition-colors active:scale-95"
            >
              Cambiarme al anual y ahorrar 58%
            </button>
          </div>
        )}

        <button
          type="button"
          id="keep-sub-btn"
          class="w-full rounded-xl border border-card-border px-4 py-2.5 text-sm font-semibold text-ink hover:bg-canvas transition-colors mb-2"
        >
          Mantener mi suscripción
        </button>
        <button
          type="button"
          id="cancel-sub-btn"
          class="w-full text-center text-xs font-semibold text-red-500 hover:text-red-600 transition-colors py-2"
        >
          Cancelar de todos modos
        </button>
      </div>
    </div>
  )}

  {premium.isPremium && premium.source === 'web' && (
    <script is:inline data-astro-rerun>
      (function () {
        function wire(id, opts) {
          var btn = document.getElementById(id);
          if (!btn || btn.dataset.wired) return;
          btn.dataset.wired = '1';
          var idle = btn.textContent;
          btn.addEventListener('click', async function () {
            if (opts.confirmMsg && !confirm(opts.confirmMsg)) return;
            btn.disabled = true;
            btn.textContent = opts.busy;
            try {
              var res = await fetch(opts.url, { method: 'POST' });
              var data = await res.json();
              if (res.ok) {
                alert(opts.done);
                window.location.reload();
              } else {
                alert(data.error || 'No se pudo completar. Intenta de nuevo.');
                btn.disabled = false;
                btn.textContent = idle;
              }
            } catch (e) {
              alert('Error de conexión. Intenta de nuevo.');
              btn.disabled = false;
              btn.textContent = idle;
            }
          });
        }
        wire('resume-sub-btn', {
          url: '/api/subscription/resume',
          confirmMsg: null,
          busy: 'Reanudando…',
          done: '¡Listo! Tu suscripción se renovará normalmente.',
        });

        // Exit offer: modal de cancelación con motivo + contraoferta anual
        var modal = document.getElementById('cancel-modal');
        var openBtn = document.getElementById('open-cancel-modal-btn');
        if (modal && openBtn && !openBtn.dataset.wired) {
          openBtn.dataset.wired = '1';
          function openModal() { modal.classList.remove('hidden'); modal.classList.add('flex'); }
          function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); }
          openBtn.addEventListener('click', openModal);
          modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
          var keepBtn = document.getElementById('keep-sub-btn');
          if (keepBtn) keepBtn.addEventListener('click', closeModal);

          function getReason() {
            var sel = document.querySelector('input[name="cancel-reason"]:checked');
            var comment = (document.getElementById('cancel-comment') || {}).value || '';
            return { reason: sel ? sel.value : null, comment: comment.trim().slice(0, 500) };
          }

          var cancelBtn = document.getElementById('cancel-sub-btn');
          if (cancelBtn) cancelBtn.addEventListener('click', async function () {
            cancelBtn.disabled = true;
            cancelBtn.textContent = 'Cancelando…';
            try {
              var res = await fetch('/api/subscription/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(getReason()),
              });
              var data = await res.json();
              if (res.ok) {
                alert('Suscripción cancelada. Mantienes Premium hasta el final del período pagado.');
                window.location.reload();
              } else {
                alert(data.error || 'No se pudo cancelar. Intenta de nuevo.');
                cancelBtn.disabled = false;
                cancelBtn.textContent = 'Cancelar de todos modos';
              }
            } catch (e) {
              alert('Error de conexión. Intenta de nuevo.');
              cancelBtn.disabled = false;
              cancelBtn.textContent = 'Cancelar de todos modos';
            }
          });

          var switchBtn = document.getElementById('switch-yearly-btn');
          if (switchBtn) switchBtn.addEventListener('click', async function () {
            switchBtn.disabled = true;
            switchBtn.textContent = 'Cambiando…';
            try {
              var res = await fetch('/api/subscription/switch-yearly', { method: 'POST' });
              var data = await res.json();
              if (res.ok) {
                alert('¡Listo! Ahora estás en el plan anual de $14.99/año.');
                window.location.reload();
              } else {
                alert(data.error || 'No se pudo cambiar el plan. Intenta de nuevo.');
                switchBtn.disabled = false;
                switchBtn.textContent = 'Cambiarme al anual y ahorrar 58%';
              }
            } catch (e) {
              alert('Error de conexión. Intenta de nuevo.');
              switchBtn.disabled = false;
              switchBtn.textContent = 'Cambiarme al anual y ahorrar 58%';
            }
          });
        }
      })();
    </script>
  )}

  {paddleReady && !premium.isPremium && (
    /* data-astro-rerun: con ClientRouter los scripts inline no se re-ejecutan en
       navegación suave — sin esto, llegar a /premium desde el sidebar deja los
       botones muertos. El script es idempotente (guards) para soportar re-runs. */
    <script is:inline data-astro-rerun define:vars={{ PADDLE_TOKEN, PADDLE_ENV, userId: user.id, userEmail: user.email ?? '' }}>
      (function () {
        function wireButtons() {
          if (!window.__vivraPaddleInit) {
            if (PADDLE_ENV === 'sandbox') Paddle.Environment.set('sandbox');
            Paddle.Initialize({
              token: PADDLE_TOKEN,
              eventCallback: function (ev) {
                // Tras el pago, el webhook activa premium en segundos; recargamos para reflejarlo.
                if (ev.name === 'checkout.completed') {
                  setTimeout(function () { window.location.href = '/premium'; }, 4000);
                }
              },
            });
            window.__vivraPaddleInit = true;
          }
          document.querySelectorAll('.paddle-buy').forEach(function (btn) {
            if (btn.dataset.wired) return;
            btn.dataset.wired = '1';
            btn.addEventListener('click', function () {
              Paddle.Checkout.open({
                items: [{ priceId: btn.dataset.paddlePrice, quantity: 1 }],
                customData: { user_id: userId },
                customer: userEmail ? { email: userEmail } : undefined,
                settings: { displayMode: 'overlay', locale: 'es' },
              });
            });
          });
        }

        if (window.Paddle) {
          wireButtons();
        } else if (!window.__vivraPaddleLoading) {
          window.__vivraPaddleLoading = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
          s.onload = wireButtons;
          document.head.appendChild(s);
        } else {
          // paddle.js ya está cargando (navegación rápida): espera a que exista.
          var iv = setInterval(function () {
            if (window.Paddle) { clearInterval(iv); wireButtons(); }
          }, 100);
        }
      })();
    </script>
  )}
</MainLayout>
