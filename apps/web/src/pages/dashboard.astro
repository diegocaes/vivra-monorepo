            <svg class="h-4 w-4 text-muted/40 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ))}
      </div>
      <button type="button" id="btn-dismiss-checklist" class="mt-2 w-full text-xs text-muted hover:text-ink transition-colors py-1">
        Ya lo sé, no mostrar de nuevo →
      </button>
    </div>
  )}

  <script is:inline>
    (function() {
      if (localStorage.getItem('vivra_checklist_hidden') === '1') {
        var el = document.getElementById('onboarding-checklist');
        if (el) el.style.display = 'none';
      }
    })();
  </script>
  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      var btn = document.getElementById('btn-dismiss-checklist');
      if (btn) {
        btn.addEventListener('click', function() {
          localStorage.setItem('vivra_checklist_hidden', '1');
          var el = document.getElementById('onboarding-checklist');
          if (el) el.style.display = 'none';
        });
      }
    });
  </script>

  {/* ── CONFETTI ── */}
  {isNewlyOnboarded && (
    <script is:inline>
      (function() {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js';
        script.onload = function() {
          setTimeout(function() {
            window.confetti({ particleCount: 140, spread: 90, origin: { y: 0.55 },
              colors: ['#F97316','#EA580C','#ffffff','#F59E0B','#FFF7ED'] });
          }, 300);
        };
        document.head.appendChild(script);
      })();
    </script>
  )}

  {/* ── PREMIUM TRIAL BANNER ── */}
  {premium.isPremium && premium.isTrial && premium.daysLeft <= 1 && (
    <div class="mb-5 rounded-2xl border border-red-200 overflow-hidden animate-fade-up" id="premium-trial-banner">
      <div class="bg-linear-to-r from-red-50 to-amber-50 px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-100">
            <svg class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-red-700">Tu Premium gratis vence {premium.daysLeft === 0 ? 'hoy' : 'manana'}</p>
            <p class="text-xs text-muted mt-0.5">Sin Premium perderás el co-dueño y el desglose de gastos por categoría.</p>
          </div>
          <a href="/premium" class="shrink-0 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-dark transition-colors">
            Mantener Premium
          </a>
        </div>
      </div>
    </div>
  )}
  {premium.isPremium && premium.isTrial && premium.daysLeft > 1 && (
    <div class="mb-5 rounded-2xl border border-accent/25 overflow-hidden animate-fade-up" id="premium-trial-banner">
      <div class="bg-linear-to-r from-accent/10 to-amber/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-accent-dark">¡Tienes Premium gratis por {premium.daysLeft} dias!</p>
            <p class="text-xs text-muted mt-0.5">Gracias a tu referido. Agrega un co-dueño y ve el desglose de tus gastos.</p>
          </div>
          <a href="/premium" class="shrink-0 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-dark transition-colors">
            Ver beneficios
          </a>
        </div>
      </div>
    </div>
