---
import MainLayout from '../layouts/MainLayout.astro';
import { getPremiumStatus } from '../lib/premium';
import type { PremiumStatus } from '../lib/premium';

const { supabase, user } = Astro.locals;
const premium: PremiumStatus = await getPremiumStatus(supabase, user.id);

const APP_STORE_URL = 'https://apps.apple.com/app/vivra/id6761087142';

// Checkout web con Paddle — se activa solo cuando las env vars existen.
// PUBLIC_PADDLE_ENV: 'sandbox' | 'production'
const PADDLE_TOKEN = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN ?? '';
const PADDLE_ENV = import.meta.env.PUBLIC_PADDLE_ENV ?? 'sandbox';
const PADDLE_PRICE_MONTHLY = import.meta.env.PUBLIC_PADDLE_PRICE_MONTHLY ?? '';
const PADDLE_PRICE_YEARLY = import.meta.env.PUBLIC_PADDLE_PRICE_YEARLY ?? '';
const paddleReady = !!(PADDLE_TOKEN && (PADDLE_PRICE_MONTHLY || PADDLE_PRICE_YEARLY));

// Premium = co-dueño + desglose de gastos. Todo lo demás es gratis para todos.
const features = [
  { icon: '👥', name: 'Co-dueño', desc: 'Comparte la mascota con tu pareja: ambos ven y registran todo', free: 'No', premium: 'Sí' },
  { icon: '💰', name: 'Desglose de gastos', desc: 'Ve en qué gastas: vet, alimento, grooming, vuelos y más', free: 'Solo el total', premium: 'Por categoría' },
  { icon: '🐾', name: 'Varias mascotas', desc: 'Perros y gatos en una sola cuenta', free: 'Sí', premium: 'Sí' },
  { icon: '📊', name: 'Gráfica de peso', desc: 'Evolución del peso con gráficas detalladas', free: 'Sí', premium: 'Sí' },
  { icon: '🧡', name: 'Vitality Score', desc: 'Desglose por pilar, flags y recomendaciones', free: 'Sí', premium: 'Sí' },
  { icon: '✈️', name: 'Pasaporte y viajes', desc: 'Documentos de vuelo y pasaporte imprimible', free: 'Sí', premium: 'Sí' },
  { icon: '🔔', name: 'Recordatorios', desc: 'Vacunas, comida, antiparasitarios y más', free: 'Sí', premium: 'Sí' },
];
---

<MainLayout title="Premium">
  <div class="max-w-lg mx-auto space-y-6 animate-fade-up">

    <!-- Header -->
    <div class="text-center">
      <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10">
        <svg class="h-8 w-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-ink">Vivra Premium</h1>
      <p class="text-sm text-muted mt-1">Desbloquea refiriendo amigos o con una suscripción</p>
    </div>

    <!-- Current status -->
    {premium.isPremium ? (
      <div class="rounded-2xl border border-accent/30 bg-accent/5 px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold text-accent-dark">Premium activo</p>
            <p class="text-xs text-muted">
              {premium.daysLeft} dias restantes
              {premium.isTrial ? ' (trial por referido)' : premium.source === 'referral' ? ' (por referidos)' : ''}
            </p>
          </div>
        </div>
        {premium.isExpiringSoon && (
          <p class="text-xs text-amber-600 mt-3 font-medium">Tu premium vence pronto. Refiere amigos para extenderlo gratis.</p>
        )}
      </div>
    ) : (
      <div class="rounded-2xl border border-card-border bg-canvas px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-canvas border border-card-border">
            <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold text-ink">Plan gratuito</p>
            <p class="text-xs text-muted">Todo Vivra, gratis — Premium agrega co-dueño y desglose de gastos</p>
          </div>
        </div>
      </div>
    )}

    <!-- Feature comparison -->
    <div class="rounded-2xl border border-card-border bg-card overflow-hidden">
      <div class="grid grid-cols-3 gap-0 border-b border-card-border bg-canvas px-4 py-3">
        <p class="text-xs font-semibold text-muted uppercase tracking-wider col-span-1">Funcion</p>
        <p class="text-xs font-semibold text-muted uppercase tracking-wider text-center">Free</p>
        <p class="text-xs font-semibold text-accent uppercase tracking-wider text-center">Premium</p>
      </div>
      {features.map((f, i) => (
        <div class:list={['grid grid-cols-3 gap-0 px-4 py-3 items-center', i < features.length - 1 && 'border-b border-card-border']}>
          <div class="flex items-center gap-2 col-span-1">
            <span class="text-base">{f.icon}</span>
            <div>
              <p class="text-xs font-semibold text-ink">{f.name}</p>
              <p class="text-xs text-muted leading-tight hidden sm:block">{f.desc}</p>
            </div>
          </div>
          <p class="text-xs text-muted text-center">{f.free}</p>
          <p class="text-xs text-accent-dark font-semibold text-center">{f.premium}</p>
        </div>
      ))}
    </div>

    <!-- How to get premium -->
    <div class="rounded-2xl border border-card-border bg-card p-5">
      <p class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Como obtener premium</p>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-sm">🎁</div>
          <div>
            <p class="text-sm font-medium text-ink">Refiere amigos</p>
            <p class="text-xs text-muted mt-0.5">Cada amigo que se une = 1 mes premium gratis para ti</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-sm">👥</div>
          <div>
            <p class="text-sm font-medium text-ink">Premium compartido</p>
            <p class="text-xs text-muted mt-0.5">Si tu co-dueño tiene Premium, tú también lo obtienes</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-sm">💳</div>
          <div>
            <p class="text-sm font-medium text-ink">Suscripción</p>
            <p class="text-xs text-muted mt-0.5">$2.99/mes o $19.99/año — se contrata desde la app de iPhone (Perfil → Premium)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    {!premium.isPremium && (
      <div class="space-y-3">
        <a
          href="/referidos"
          class="flex items-center justify-center gap-2 w-full rounded-2xl px-6 py-3.5 text-sm font-semibold text-white transition-all active:scale-95"
          style="background:#F97316;box-shadow:0 4px 14px rgba(249,115,22,0.35);"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Invitar amigos y ganar premium
        </a>
        {paddleReady ? (
          <>
            <div class="grid grid-cols-2 gap-3">
              {PADDLE_PRICE_MONTHLY && (
                <button
                  type="button"
                  data-paddle-price={PADDLE_PRICE_MONTHLY}
                  class="paddle-buy flex flex-col items-center justify-center gap-0.5 rounded-2xl border-2 border-accent bg-card px-4 py-3.5 transition-all hover:bg-accent/5 active:scale-95"
                >
                  <span class="text-sm font-bold text-ink">$2.99/mes</span>
                  <span class="text-xs text-muted">Mensual</span>
                </button>
              )}
              {PADDLE_PRICE_YEARLY && (
                <button
                  type="button"
                  data-paddle-price={PADDLE_PRICE_YEARLY}
                  class="paddle-buy flex flex-col items-center justify-center gap-0.5 rounded-2xl border-2 border-accent bg-accent/10 px-4 py-3.5 transition-all hover:bg-accent/15 active:scale-95"
                >
                  <span class="text-sm font-bold text-accent-dark">$19.99/año</span>
                  <span class="text-xs text-accent-dark/80">Ahorra 44%</span>
                </button>
              )}
            </div>
            <p class="text-center text-xs text-muted">Pago seguro con tarjeta, Apple Pay o Google Pay. Cancela cuando quieras.</p>
          </>
        ) : (
          <>
            <a
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full rounded-2xl border border-card-border bg-card px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:border-ink active:scale-95"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              Suscribirme desde la app de iPhone
            </a>
            <p class="text-center text-xs text-muted">La suscripción se gestiona con tu Apple ID. Al suscribirte en el iPhone, Premium se activa también en la web al instante.</p>
          </>
        )}
      </div>
    )}

  </div>

  {paddleReady && !premium.isPremium && (
    /* data-astro-rerun: con ClientRouter los scripts inline no se re-ejecutan en
       navegación suave — sin esto, llegar a /premium desde el sidebar deja los
       botones muertos. El script es idempotente (guards) para soportar re-runs. */
    <script is:inline data-astro-rerun define:vars={{ PADDLE_TOKEN, PADDLE_ENV, userId: user.id, userEmail: user.email ?? '' }}>
      (function () {
        function wireButtons() {
          if (!window.__vivraPaddleInit) {
            if (PADDLE_ENV === 'sandbox') Paddle.Environment.set('sandbox');
            Paddle.Initialize({
              token: PADDLE_TOKEN,
              eventCallback: function (ev) {
                // Tras el pago, el webhook activa premium en segundos; recargamos para reflejarlo.
                if (ev.name === 'checkout.completed') {
                  setTimeout(function () { window.location.href = '/premium'; }, 4000);
                }
              },
            });
            window.__vivraPaddleInit = true;
          }
          document.querySelectorAll('.paddle-buy').forEach(function (btn) {
            if (btn.dataset.wired) return;
            btn.dataset.wired = '1';
            btn.addEventListener('click', function () {
              Paddle.Checkout.open({
                items: [{ priceId: btn.dataset.paddlePrice, quantity: 1 }],
                customData: { user_id: userId },
                customer: userEmail ? { email: userEmail } : undefined,
                settings: { displayMode: 'overlay', locale: 'es' },
              });
            });
          });
        }

        if (window.Paddle) {
          wireButtons();
        } else if (!window.__vivraPaddleLoading) {
          window.__vivraPaddleLoading = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
          s.onload = wireButtons;
          document.head.appendChild(s);
        } else {
          // paddle.js ya está cargando (navegación rápida): espera a que exista.
          var iv = setInterval(function () {
            if (window.Paddle) { clearInterval(iv); wireButtons(); }
          }, 100);
        }
      })();
    </script>
  )}
</MainLayout>
