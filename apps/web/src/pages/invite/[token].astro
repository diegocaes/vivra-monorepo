---
const { token } = Astro.params;
const appDeepLink = `com.vivrapet.app://invite/${token}`;
const appStoreUrl = 'https://apps.apple.com/app/vivra/id6744145107';
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Te invitaron a compartir una mascota — Vivra</title>

  <!-- Open Graph / link preview -->
  <meta property="og:title" content="Te invitaron a compartir una mascota en Vivra" />
  <meta property="og:description" content="Descarga Vivra para aceptar la invitación y cuidar juntos a tu mascota." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://vivrapet.com/invite/${token}`} />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #F7F8FA;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 24px;
      padding: 40px 32px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    }
    .logo {
      font-size: 14px;
      color: #6B7280;
      margin-bottom: 24px;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 600;
    }
    .pet-icon {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: #FFF7ED;
      margin: 0 auto 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
    }
    h1 {
      font-size: 22px;
      color: #0F1117;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .desc {
      font-size: 14px;
      color: #6B7280;
      line-height: 1.5;
      margin-bottom: 24px;
    }
    .btn {
      display: block;
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      transition: opacity 0.15s;
    }
    .btn:hover { opacity: 0.9; }
    .btn-primary { background: #F97316; color: white; }
    .btn-outline { background: transparent; color: #0F1117; border: 1.5px solid #EAECF0; margin-top: 12px; }
    .divider { height: 1px; background: #EAECF0; margin: 20px 0; }
    .app-hint { font-size: 12px; color: #6B7280; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Vivra</div>
    <div class="pet-icon">&#128062;</div>
    <h1>Te invitaron a compartir una mascota en Vivra</h1>
    <p class="desc">Descarga la app para aceptar la invitacion y cuidar juntos a tu mascota.</p>
    <a href={appStoreUrl} class="btn btn-primary">Descargar en App Store</a>
    <div class="divider"></div>
    <a href={appDeepLink} class="btn btn-outline">Abrir en la app</a>
    <p class="app-hint">Si ya tienes Vivra instalada, abrela directamente</p>
  </div>
</body>
</html>
