          </div>
          <p class:list={[
            'text-[11px] mt-1',
            antipulgasInfo.overdue ? 'text-red-600 font-bold' : 'text-muted'
          ]}>
            {antipulgasInfo.overdue ? 'Vencido — aplicar ya' : 'Próxima aplicación registrada'}
          </p>
        </>
      )}
    </a>
    <a href="/salud/preventivos" class:list={[
      'rounded-2xl px-4 py-4 active:scale-95 transition-transform hover:shadow-sm',
      !desparasitanteInfo.hasRecord || (desparasitanteInfo.hasDue && desparasitanteInfo.overdue)
        ? 'border-2 border-red-300 bg-red-50 ring-2 ring-red-200/50'
        : desparasitanteInfo.hasDue && desparasitanteInfo.daysLeft <= 5
          ? 'border-2 border-amber-300 bg-amber-50 ring-2 ring-amber-200/50'
          : 'border border-card-border bg-card'
    ]}>
      <div class="flex items-center gap-2 mb-2">
        <span class="text-blue-500"><Icon name="pastilla" class="h-4 w-4" /></span>
        <p class="text-[10px] font-semibold text-muted uppercase tracking-widest">Desparasitante</p>
      </div>
      {!desparasitanteInfo.hasRecord ? (
        <>
          <p class="text-base font-black text-red-600">Sin registro</p>
          <p class="text-[11px] text-red-600/80 font-semibold mt-1">Registrar primera dosis</p>
        </>
      ) : !desparasitanteInfo.hasDue ? (
        <>
          <p class="text-base font-black text-ink">Registrado</p>
          <p class="text-[11px] text-muted mt-1">Sin próxima fecha</p>
        </>
      ) : (
        <>
          <div class="flex items-baseline gap-1.5">
            <span class:list={[
              'text-2xl font-black leading-none',
              desparasitanteInfo.overdue ? 'text-red-600' : desparasitanteInfo.daysLeft <= 5 ? 'text-amber-600' : 'text-ink'
            ]}>
              {desparasitanteInfo.overdue ? `-${Math.abs(desparasitanteInfo.daysLeft)}d` : `${desparasitanteInfo.daysLeft}d`}
            </span>
            {!desparasitanteInfo.overdue && <span class="text-xs text-muted">restantes</span>}
          </div>
          <p class:list={[
            'text-[11px] mt-1',
            desparasitanteInfo.overdue ? 'text-red-600 font-bold' : 'text-muted'
          ]}>
            {desparasitanteInfo.overdue ? 'Vencido — aplicar ya' : 'Próxima aplicación registrada'}
          </p>
        </>
      )}
    </a>
  </div>

  {/* ── BREED FACT ── */}
  {dailyFact && (
    <div class="mb-5 animate-fade-up animate-fade-up-delay-2">
      <div class="flex items-start gap-3 rounded-2xl border border-accent/15 bg-accent/5 px-4 py-3">
        <svg class="h-5 w-5 shrink-0 mt-0.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><path d="M6 9a4 4 0 0 1 4-1h2a4 4 0 0 1 4 1l1 5-3-1v5H8v-5l-3 1z"/></svg>
        <div>
          <p class="text-xs font-bold text-accent-dark mb-0.5">¿Sabías que...?</p>
          <p class="text-xs text-ink/70 leading-relaxed">{dailyFact.fact}</p>
        </div>
      </div>
    </div>
  )}

</MainLayout>
