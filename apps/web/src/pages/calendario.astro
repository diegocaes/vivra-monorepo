---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { formatDate } from '@vivra/shared';
import { getActivePet } from '../lib/pet';

/**
 * Calendario — rejilla mensual real.
 *
 * Antes esto era una lista agrupada por mes: se veía qué había pasado, pero
 * no CUÁNDO respecto a hoy, ni cuánto falta para lo próximo, que es para lo
 * que uno abre un calendario. Ahora:
 *   1. Rejilla del mes con un punto de color por evento en cada día.
 *   2. Al tocar un día, sus eventos se listan debajo.
 *   3. "Próximos" arriba, con la cuenta regresiva.
 *
 * La navegación entre meses es SSR (`?mes=YYYY-MM`) en vez de JavaScript: con
 * `prefetch` activado en astro.config los enlaces ya vienen cargados y se
 * siente instantáneo, sin mantener estado en el cliente.
 */
const { supabase, user, activePetId } = Astro.locals;
const { pet } = await getActivePet(supabase, user.id, activePetId);
if (!pet) return Astro.redirect('/perfil?new=1');

const [vaccinesRes, visitsRes, groomingsRes, flightsRes, preventivesRes] = await Promise.all([
  supabase.from('vaccines').select('id, name, date_given, next_due').eq('pet_id', pet.id),
  supabase.from('vet_visits').select('id, reason, date, vet_name').eq('pet_id', pet.id),
  supabase.from('groomings').select('id, type, date, groomer_name').eq('pet_id', pet.id),
  supabase.from('flights').select('id, origin, destination, flight_date, airline').eq('pet_id', pet.id),
  supabase.from('preventive_treatments').select('id, type, date_given, product_name').eq('pet_id', pet.id),
]);

let bloodTestsData: { id: string; date: string }[] = [];
try {
  const { data } = await supabase.from('blood_tests').select('id, date').eq('pet_id', pet.id);
  bloodTestsData = data ?? [];
} catch { /* la tabla puede no existir todavía */ }

type Categoria = 'vaccine' | 'vet' | 'grooming' | 'flight' | 'preventive' | 'reminder' | 'blood_test';

interface Evento {
  id: string;
  date: string;
  title: string;
  subtitle: string;
  category: Categoria;
  icon: string;
  href: string;
}

/** Una sola fuente para el color y la etiqueta de cada categoría: la rejilla,
 *  los filtros y la lista tienen que coincidir o el punto no dice nada. */
const CATEGORIAS: Record<Categoria, { label: string; punto: string; chip: string; texto: string }> = {
  vaccine:    { label: 'Vacunas',       punto: 'bg-blue-500',   chip: 'bg-blue-50 border-blue-100',     texto: 'text-blue-600' },
  vet:        { label: 'Veterinario',   punto: 'bg-purple-500', chip: 'bg-purple-50 border-purple-100', texto: 'text-purple-600' },
  grooming:   { label: 'Estética',      punto: 'bg-pink-500',   chip: 'bg-pink-50 border-pink-100',     texto: 'text-pink-600' },
  flight:     { label: 'Vuelos',        punto: 'bg-accent',     chip: 'bg-accent/10 border-accent/20',  texto: 'text-accent' },
  preventive: { label: 'Preventivos',   punto: 'bg-green-500',  chip: 'bg-green-50 border-green-100',   texto: 'text-green-600' },
  blood_test: { label: 'Sangre',        punto: 'bg-red-500',    chip: 'bg-red-50 border-red-100',       texto: 'text-red-600' },
  reminder:   { label: 'Recordatorios', punto: 'bg-amber-500',  chip: 'bg-amber-50 border-amber-100',   texto: 'text-amber-600' },
};

const eventos: Evento[] = [];

for (const v of vaccinesRes.data ?? []) {
  eventos.push({ id: `vac-${v.id}`, date: v.date_given, title: v.name, subtitle: 'Vacuna aplicada', category: 'vaccine', icon: 'vacuna', href: '/salud/vacunas' });
  if (v.next_due) {
    eventos.push({ id: `vac-next-${v.id}`, date: v.next_due, title: `${v.name} (refuerzo)`, subtitle: 'Próxima dosis', category: 'reminder', icon: 'campana', href: '/salud/vacunas' });
  }
}
for (const v of visitsRes.data ?? []) {
  eventos.push({ id: `vet-${v.id}`, date: v.date, title: v.reason, subtitle: v.vet_name ? `Dr. ${v.vet_name}` : 'Visita veterinaria', category: 'vet', icon: 'vet', href: '/salud/historial' });
}
for (const g of groomingsRes.data ?? []) {
  eventos.push({ id: `groom-${g.id}`, date: g.date, title: g.type || 'Grooming', subtitle: g.groomer_name || 'Estética', category: 'grooming', icon: 'grooming', href: '/salud/grooming' });
}
for (const f of flightsRes.data ?? []) {
  eventos.push({ id: `flight-${f.id}`, date: f.flight_date, title: `${f.origin} - ${f.destination}`, subtitle: f.airline || 'Vuelo', category: 'flight', icon: 'vuelo', href: '/viajes' });
}
for (const p of preventivesRes.data ?? []) {
  eventos.push({
    id: `prev-${p.id}`, date: p.date_given,
    title: p.product_name || (p.type === 'antipulgas' ? 'Antipulgas' : p.type === 'combinado' ? 'Combinado' : 'Desparasitante'),
    subtitle: p.type === 'combinado' ? 'Antipulgas + desparasitante' : p.type === 'antipulgas' ? 'Antipulgas aplicado' : 'Desparasitante aplicado',
    category: 'preventive', icon: p.type === 'combinado' ? 'combinado' : p.type === 'antipulgas' ? 'preventivo' : 'pastilla',
    href: '/salud/preventivos',
  });
}

// Próxima dosis por tipo (ciclo de 30 días desde la última aplicación).
// 'combinado' cuenta para los dos tipos, igual que en la pantalla de preventivos.
const ultimaPorTipo: Record<string, string> = {};
for (const p of preventivesRes.data ?? []) {
  for (const tipo of p.type === 'combinado' ? ['antipulgas', 'desparasitante'] : [p.type]) {
    if (!ultimaPorTipo[tipo] || p.date_given > ultimaPorTipo[tipo]) ultimaPorTipo[tipo] = p.date_given;
  }
}
for (const [tipo, ultima] of Object.entries(ultimaPorTipo)) {
  const proxima = new Date(ultima + 'T00:00:00');
  proxima.setDate(proxima.getDate() + 30);
  eventos.push({
    id: `prev-next-${tipo}`, date: proxima.toISOString().slice(0, 10),
    title: tipo === 'antipulgas' ? 'Próximo antipulgas' : 'Próximo desparasitante',
    subtitle: 'Siguiente dosis', category: 'reminder', icon: 'campana', href: '/salud/preventivos',
  });
}

for (const bt of bloodTestsData) {
  eventos.push({ id: `blood-${bt.id}`, date: bt.date, title: 'Examen de sangre', subtitle: 'Análisis realizado', category: 'blood_test', icon: 'sangre', href: '/salud' });
}
if (bloodTestsData.length > 0) {
  const ultimo = [...bloodTestsData].sort((a, b) => b.date.localeCompare(a.date))[0];
  const proximo = new Date(ultimo.date + 'T00:00:00');
  proximo.setFullYear(proximo.getFullYear() + 1);
  eventos.push({ id: 'blood-next', date: proximo.toISOString().slice(0, 10), title: 'Próximo examen de sangre', subtitle: 'Recomendado anual', category: 'reminder', icon: 'campana', href: '/salud' });
}

const validos = eventos.filter(e => !!e.date);

// ── Mes visible ──────────────────────────────────────────────────────────────
const hoy = new Date();
const hoyStr = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
const mesParam = Astro.url.searchParams.get('mes');
const mesValido = mesParam && /^\d{4}-\d{2}$/.test(mesParam) ? mesParam : hoyStr.slice(0, 7);
const [anio, mes] = mesValido.split('-').map(Number);

const primerDia = new Date(anio, mes - 1, 1);
const diasEnMes = new Date(anio, mes, 0).getDate();
// La semana empieza en lunes: getDay() da 0 para domingo, así que se rota.
const offset = (primerDia.getDay() + 6) % 7;

const eventosPorDia = new Map<string, Evento[]>();
for (const e of validos) {
  if (!e.date.startsWith(mesValido)) continue;
  const lista = eventosPorDia.get(e.date) ?? [];
  lista.push(e);
  eventosPorDia.set(e.date, lista);
}

const celdas: { dia: number | null; fecha: string; eventos: Evento[] }[] = [];
for (let i = 0; i < offset; i++) celdas.push({ dia: null, fecha: '', eventos: [] });
for (let d = 1; d <= diasEnMes; d++) {
  const fecha = `${mesValido}-${String(d).padStart(2, '0')}`;
  celdas.push({ dia: d, fecha, eventos: eventosPorDia.get(fecha) ?? [] });
}

const mesAnterior = new Date(anio, mes - 2, 1);
const mesSiguiente = new Date(anio, mes, 1);
const claveMes = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const etiquetaMes = primerDia.toLocaleDateString('es', { month: 'long', year: 'numeric' });
const esMesActual = mesValido === hoyStr.slice(0, 7);

// Día seleccionado: el de la URL, hoy si estamos en el mes actual, o el primer
// día con eventos. Así la lista de abajo nunca aparece vacía sin motivo.
const diaParam = Astro.url.searchParams.get('dia');
const primerDiaConEventos = celdas.find(c => c.eventos.length > 0)?.fecha ?? '';
const diaSeleccionado =
  (diaParam && eventosPorDia.has(diaParam)) ? diaParam
  : (esMesActual && eventosPorDia.has(hoyStr)) ? hoyStr
  : primerDiaConEventos;
const eventosDelDia = eventosPorDia.get(diaSeleccionado) ?? [];

const proximos = validos
  .filter(e => e.date >= hoyStr)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 4);

const DIAS = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
const totalMes = validos.filter(e => e.date.startsWith(mesValido)).length;

const enlaceMes = (clave: string) => `/calendario?mes=${clave}`;
const fechaLarga = (f: string) =>
  new Date(f + 'T00:00:00').toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });
---

<MainLayout title="Calendario">

  <div class="mb-5 animate-fade-up">
    <h1 class="text-xl font-black text-ink">Calendario</h1>
    <p class="text-xs text-muted mt-0.5">Todas las fechas de {pet.name}</p>
  </div>

  {/* ── PRÓXIMOS ── */}
  {proximos.length > 0 && (
    <div class="mb-5 animate-fade-up">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Lo que viene</p>
      <div class="rounded-2xl bg-card border border-card-border divide-y divide-card-border overflow-hidden">
        {proximos.map((ev) => {
          const dias = Math.round(
            (new Date(ev.date + 'T00:00:00').getTime() - new Date(hoyStr + 'T00:00:00').getTime()) / 86400000
          );
          const cat = CATEGORIAS[ev.category];
          return (
            <a href={ev.href} class="flex items-center gap-3 px-4 py-3 hover:bg-canvas/60 transition-colors">
              <div class:list={['h-9 w-9 shrink-0 flex items-center justify-center rounded-xl border', cat.chip, cat.texto]}>
                <Icon name={ev.icon} class="h-4 w-4" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ink truncate">{ev.title}</p>
                <p class="text-[11px] text-muted">{ev.subtitle} · {formatDate(ev.date)}</p>
              </div>
              <span class:list={[
                'rounded-full px-2 py-0.5 text-[10px] font-bold shrink-0',
                dias === 0 ? 'bg-red-50 text-red-600' : dias <= 3 ? 'bg-amber-50 text-amber-600' : 'bg-green-50 text-green-700',
              ]}>
                {dias === 0 ? 'Hoy' : dias === 1 ? 'Mañana' : `${dias} días`}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  )}

  {/* ── REJILLA DEL MES ── */}
  <div class="mb-5 rounded-2xl bg-card border border-card-border p-4 animate-fade-up animate-fade-up-delay-1">
    <div class="flex items-center justify-between mb-4">
      <a
        href={enlaceMes(claveMes(mesAnterior))}
        class="flex h-8 w-8 items-center justify-center rounded-xl text-muted hover:bg-canvas hover:text-ink transition-colors"
        aria-label="Mes anterior"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div class="text-center">
        <p class="text-sm font-bold text-ink capitalize">{etiquetaMes}</p>
        <p class="text-[10px] text-muted mt-0.5">
          {totalMes === 0 ? 'Sin eventos' : totalMes === 1 ? '1 evento' : `${totalMes} eventos`}
        </p>
      </div>
      <a
        href={enlaceMes(claveMes(mesSiguiente))}
        class="flex h-8 w-8 items-center justify-center rounded-xl text-muted hover:bg-canvas hover:text-ink transition-colors"
        aria-label="Mes siguiente"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-7 gap-1 mb-1">
      {DIAS.map((d) => (
        <div class="text-center text-[10px] font-semibold text-muted/70 py-1">{d}</div>
      ))}
    </div>

    <div class="grid grid-cols-7 gap-1">
      {celdas.map((c) => {
        if (c.dia === null) return <div></div>;
        const esHoy = c.fecha === hoyStr;
        const activo = c.fecha === diaSeleccionado;
        const tiene = c.eventos.length > 0;
        // Un punto por CATEGORÍA presente, no por evento: tres visitas al vet
        // el mismo día son un punto morado, no tres.
        const cats = [...new Set(c.eventos.map(e => e.category))].slice(0, 4);
        const celda = (
          <>
            <span class:list={[
              'text-xs font-semibold leading-none',
              activo ? 'text-white' : esHoy ? 'text-accent' : tiene ? 'text-ink' : 'text-muted/50',
            ]}>{c.dia}</span>
            <span class="flex gap-0.5 h-1.5 items-center">
              {cats.map((cat) => (
                <span class:list={['h-1.5 w-1.5 rounded-full', activo ? 'bg-white/80' : CATEGORIAS[cat].punto]}></span>
              ))}
            </span>
          </>
        );
        const clases = [
          'aspect-square flex flex-col items-center justify-center gap-1 rounded-xl transition-colors',
          activo ? 'bg-accent shadow-sm' : esHoy ? 'bg-accent/10 ring-1 ring-accent/30' : tiene ? 'hover:bg-canvas' : '',
        ];
        return tiene ? (
          <a href={`/calendario?mes=${mesValido}&dia=${c.fecha}`} class:list={clases}>{celda}</a>
        ) : (
          <div class:list={clases}>{celda}</div>
        );
      })}
    </div>

    {!esMesActual && (
      <a href="/calendario" class="mt-3 block text-center text-xs font-semibold text-accent hover:text-accent-dark transition-colors">
        Volver a hoy
      </a>
    )}
  </div>

  {/* ── DÍA SELECCIONADO ── */}
  {eventosDelDia.length > 0 ? (
    <div class="mb-5 animate-fade-up animate-fade-up-delay-2">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">
        <span class="capitalize">{fechaLarga(diaSeleccionado)}</span>
        {diaSeleccionado === hoyStr && <span class="ml-1.5 text-accent">· hoy</span>}
      </p>
      <div class="rounded-2xl bg-card border border-card-border divide-y divide-card-border overflow-hidden">
        {eventosDelDia.map((ev) => {
          const cat = CATEGORIAS[ev.category];
          return (
            <a href={ev.href} class="flex items-center gap-3 px-4 py-3 hover:bg-canvas/60 transition-colors">
              <div class:list={['h-9 w-9 shrink-0 flex items-center justify-center rounded-xl border', cat.chip, cat.texto]}>
                <Icon name={ev.icon} class="h-4 w-4" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ink truncate">{ev.title}</p>
                <p class="text-[11px] text-muted truncate">{ev.subtitle}</p>
              </div>
              <svg class="h-4 w-4 shrink-0 text-muted/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="mb-5 rounded-2xl border border-dashed border-card-border bg-card px-5 py-8 text-center animate-fade-up animate-fade-up-delay-2">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent">
        <Icon name="calendario" class="h-6 w-6" />
      </div>
      <p class="text-sm font-semibold text-ink mb-1">
        {validos.length === 0 ? 'Sin eventos todavía' : 'Nada en este mes'}
      </p>
      <p class="text-xs text-muted">
        {validos.length === 0
          ? 'Registra vacunas, visitas o preventivos y aparecerán aquí'
          : 'Usa las flechas para moverte a otro mes'}
      </p>
    </div>
  )}

  {/* ── LEYENDA ── */}
  {validos.length > 0 && (
    <div class="flex flex-wrap gap-x-4 gap-y-2 px-1 animate-fade-up">
      {Object.entries(CATEGORIAS).map(([clave, cat]) => (
        validos.some(e => e.category === clave) && (
          <span class="flex items-center gap-1.5 text-[11px] text-muted">
            <span class:list={['h-1.5 w-1.5 rounded-full', cat.punto]}></span>
            {cat.label}
          </span>
        )
      ))}
    </div>
  )}

</MainLayout>
