---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import HealthHeader from '../../components/health/HealthHeader.astro';
import { getActivePet } from '../../lib/pet';
import { buildVaccineOverview, calculateVitalityScore, daysUntilDate, formatDate, localDateKey, preventiveNextDue, type ScoreInput } from '@vivra/shared';

const { supabase, user, activePetId } = Astro.locals;
const { pet } = await getActivePet(supabase, user.id, activePetId);
if (!pet) return Astro.redirect('/onboarding');

const [weightResult, vaccineResult, visitResult, groomingResult, foodResult, preventiveResult] = await Promise.all([
  supabase.from('weight_records').select('id, weight_kg, date').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('vaccines').select('id, name, date_given, next_due').eq('pet_id', pet.id).order('date_given', { ascending: false }),
  supabase.from('vet_visits').select('id, date, reason, clinic_name, vet_name').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('groomings').select('id, date, type, services, groomer_name').eq('pet_id', pet.id).order('date', { ascending: false }),
  supabase.from('foods').select('brand, daily_grams, bag_size, bag_unit, type, start_date, created_at').eq('pet_id', pet.id).order('created_at', { ascending: false }),
  supabase.from('preventive_treatments').select('id, type, date_given, next_due, product_name').eq('pet_id', pet.id).order('date_given', { ascending: false }),
]);
const loadError = [weightResult, vaccineResult, visitResult, groomingResult, foodResult, preventiveResult].some(result => result.error);
const weightRecords = weightResult.data ?? [];
const vaccines = vaccineResult.data ?? [];
const vetVisits = visitResult.data ?? [];
const groomings = groomingResult.data ?? [];
const foods = foodResult.data ?? [];
const preventives = preventiveResult.data ?? [];
const today = localDateKey();
const vaccineOverview = buildVaccineOverview(vaccines, today);
const scoreInput: ScoreInput = {
  pet: { species: pet.species ?? 'dog', breed: pet.breed ?? null, birth_date: pet.birth_date ?? null, weight_kg: pet.weight_kg ?? null, gender: pet.gender ?? null, is_neutered: pet.is_neutered ?? null },
  weightRecords, vaccines, vetVisits, groomings, foods,
  preventives: preventives as ScoreInput['preventives'],
};
const score = loadError ? null : calculateVitalityScore(scoreInput);
const latestWeight = weightResult.error ? pet.weight_kg : weightRecords[0]?.weight_kg ?? pet.weight_kg;
const visitCountThisYear = vetVisits.filter(visit => visit.date.slice(0, 4) === today.slice(0, 4)).length;
const latestPreventives = [...new Map(['antipulgas', 'desparasitante'].flatMap(type => {
  const treatment = preventives.find(row => row.type === type || row.type === 'combinado');
  return treatment ? [[treatment.id, { ...treatment, next_due: preventiveNextDue(pet.species, treatment.date_given, treatment.next_due) }] as const] : [];
})).values()];
const preventiveOverdue = latestPreventives.filter(record => record.next_due && daysUntilDate(record.next_due, today) < 0).length;
const vaccineStatus = vaccineOverview.overdueCount > 0 ? `${vaccineOverview.overdueCount} fecha${vaccineOverview.overdueCount === 1 ? '' : 's'} pendiente${vaccineOverview.overdueCount === 1 ? '' : 's'}` : vaccineOverview.dueSoonCount > 0 ? `${vaccineOverview.dueSoonCount} próxima${vaccineOverview.dueSoonCount === 1 ? '' : 's'}` : vaccines.length ? 'Registradas' : 'Sin registros';
const preventiveStatus = preventiveOverdue > 0 ? 'Revisar fechas' : latestPreventives.length ? 'Registrados' : 'Sin registros';
function relativeDate(date: string) {
  const days = daysUntilDate(date, today);
  if (days < 0) return `Fecha pendiente · hace ${Math.abs(days)} días`;
  if (days === 0) return 'Fecha registrada para hoy';
  if (days === 1) return 'Mañana';
  return `En ${days} días`;
}
const upcoming = [
  ...vaccineOverview.schedule.map(record => ({ id: record.id, title: record.name, date: record.next_due!, icon: 'vacuna', tone: '', href: '/salud/vacunas' })),
  ...latestPreventives.filter(record => record.next_due).map(record => ({ id: record.id, title: record.type === 'antipulgas' ? 'Antipulgas' : record.type === 'desparasitante' ? 'Desparasitación' : 'Preventivo combinado', date: record.next_due!, icon: 'pastilla', tone: 'sand', href: '/salud/preventivos' })),
].sort((a, b) => a.date.localeCompare(b.date));
const history = [
  ...vaccines.map(record => ({ id: `v-${record.id}`, date: record.date_given, title: record.name, subtitle: 'Vacuna registrada', icon: 'vacuna', tone: '', href: '/salud/vacunas' })),
  ...vetVisits.map(record => ({ id: `h-${record.id}`, date: record.date, title: 'Visita veterinaria', subtitle: [record.reason, record.clinic_name || record.vet_name].filter(Boolean).join(' · '), icon: 'vet', tone: 'sky', href: '/salud/historial' })),
  ...preventives.map(record => ({ id: `p-${record.id}`, date: record.date_given, title: record.type === 'antipulgas' ? 'Antipulgas' : record.type === 'desparasitante' ? 'Desparasitación' : 'Preventivo combinado', subtitle: record.product_name || 'Aplicación registrada', icon: 'pastilla', tone: 'sand', href: '/salud/preventivos' })),
  ...weightRecords.map(record => ({ id: `w-${record.id}`, date: record.date, title: 'Control de peso', subtitle: `${record.weight_kg} kg`, icon: 'peso', tone: '', href: '/salud/peso' })),
].sort((a, b) => b.date.localeCompare(a.date) || b.id.localeCompare(a.id));
---

<MainLayout title="Salud">
  <HealthHeader pet={pet} active="resumen" latestWeight={latestWeight} score={score} scoreUnavailable={loadError} />
  {loadError ? (
    <div class="health-load-notice" role="alert"><Icon name="alerta" class="h-5 w-5 shrink-0" /><p>No pudimos cargar todos los registros de {pet.name}. Reintenta para ver un resumen completo.</p><a href="/salud">Reintentar</a></div>
  ) : (
    <>
      <div class="health-grid">
        <section class="health-panel" aria-labelledby="health-state-title">
          <h2 id="health-state-title">Estado de salud</h2>
          <div class="health-stats">
            <a href="#bienestar-detalle" class="health-stat"><span class="health-icon circle"><Icon name="score" /></span><strong>General</strong><p>{score?.showScore ? score.headline : 'Completar datos'}</p></a>
            <a href="/salud/vacunas" class="health-stat"><span class="health-icon circle"><Icon name="vacuna" /></span><strong>Vacunas</strong><p>{vaccineStatus}</p></a>
            <a href="/salud/preventivos" class="health-stat"><span class="health-icon circle sand"><Icon name="pastilla" /></span><strong>Preventivos</strong><p>{preventiveStatus}</p></a>
            <a href="/salud/historial" class="health-stat"><span class="health-icon circle sky"><Icon name="vet" /></span><strong>Visitas vet</strong><p>{visitCountThisYear} este año</p></a>
          </div>
          <div class="health-panel-head"><h2>Próximas fechas</h2><a href="/calendario">Ver calendario <span aria-hidden="true">›</span></a></div>
          {upcoming.length ? upcoming.slice(0, 4).map(event => (
            <a class="health-event" href={event.href}><span class:list={['health-icon', event.tone]}><Icon name={event.icon} /></span><div class="health-event-info"><strong>{event.title}</strong><p>{relativeDate(event.date)}</p></div><time datetime={event.date}>{formatDate(event.date)}</time><span class="health-chevron" aria-hidden="true">›</span></a>
          )) : <p class="health-empty">Todavía no hay próximas fechas. Puedes añadirlas en <a href="/salud/vacunas">vacunas</a> y <a href="/salud/preventivos">preventivos</a>.</p>}
        </section>
        <section class="health-panel" aria-labelledby="health-history-title">
          <div class="health-panel-head"><h2 id="health-history-title">Historial reciente</h2><a href="/calendario">Ver calendario <span aria-hidden="true">›</span></a></div>
          {history.length ? <>
            <div class="health-timeline">{history.slice(0, 5).map(item => <div class="health-timeline-item"><time datetime={item.date}>{formatDate(item.date)}</time><a href={item.href}><span class:list={['health-icon', item.tone]}><Icon name={item.icon} /></span><div class="health-event-info"><strong>{item.title}</strong><p>{item.subtitle}</p></div><span class="health-chevron" aria-hidden="true">›</span></a></div>)}</div>
            {history.length > 5 && <details class="health-history-more"><summary>Ver los {history.length - 5} registros anteriores</summary><div class="health-timeline">{history.slice(5).map(item => <div class="health-timeline-item"><time datetime={item.date}>{formatDate(item.date)}</time><a href={item.href}><span class:list={['health-icon', item.tone]}><Icon name={item.icon} /></span><div class="health-event-info"><strong>{item.title}</strong><p>{item.subtitle}</p></div><span class="health-chevron" aria-hidden="true">›</span></a></div>)}</div></details>}
          </> : <p class="health-empty">Sus vacunas, visitas, preventivos y controles de peso aparecerán aquí cuando los registres.</p>}
        </section>
      </div>
      <section class="health-reminders"><span class="health-icon"><Icon name="campana" class="h-6 w-6" /></span><div><h2>Mantén los cuidados de {pet.name} al día</h2><p>Consulta los recordatorios de vacunas y preventivos según sus fechas registradas.</p></div><a href="/notificaciones">Ver recordatorios</a></section>
    </>
  )}
  <details class="health-score-details" id="bienestar-detalle" open={!score?.showScore}>
    <summary>Cómo va el bienestar de {pet.name}</summary>
    {score ? <>
      <p>{score.showScore ? score.subline : 'Agrega información para ver un resumen de su bienestar.'}</p>
      {score.showScore && <div class="health-pillars">{score.pillars.map(pillar => <details class="health-pillar"><summary><span>{pillar.name}</span><span>{pillar.score}/{pillar.max}</span></summary><span class="health-progress"><span style={`width:${pillar.pct}%;background:${pillar.pct >= 70 ? '#378655' : pillar.pct >= 40 ? '#B77D35' : '#C25C50'}`}></span></span><p>{pillar.description}</p><p><strong>{pillar.status}</strong></p>{pillar.tips.length > 0 && <ul>{pillar.tips.map(tip => <li>{tip}</li>)}</ul>}</details>)}</div>}
      {score.pendingAreas.length > 0 && <div class="health-flags">{score.pendingAreas.map(area => <a href={area.href}>{area.label}<span aria-hidden="true">›</span></a>)}</div>}
      {score.flags.length > 0 && <div class="health-flags">{score.flags.map(flag => <a href={flag.href}>{flag.message}<span>{flag.action} →</span></a>)}</div>}
    </> : <p>Reintenta la carga para ver el detalle del índice.</p>}
    <p>El índice es orientativo, no un diagnóstico médico. <a href="/faq" class="text-accent">Cómo funciona →</a></p>
  </details>
</MainLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const details = document.querySelector<HTMLDetailsElement>('#bienestar-detalle');
    if (window.location.hash === '#bienestar-detalle' && details) details.open = true;
    document.querySelectorAll<HTMLAnchorElement>('a[href="#bienestar-detalle"]').forEach(link => {
      link.addEventListener('click', () => { if (details) details.open = true; });
    });
  });
</script>
