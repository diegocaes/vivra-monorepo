  <div id="delete-modal" class="fixed inset-0 z-50 items-end justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
    <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl animate-scale-in">
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 mx-auto text-2xl">
        ⚠️
      </div>
      <h3 class="text-center text-base font-bold text-ink mb-2">
        {hasMultiplePets ? `¿Eliminar a ${pet?.name}?` : '¿Eliminar cuenta?'}
      </h3>
      <p class="text-center text-sm text-muted mb-6 leading-relaxed">
        {hasMultiplePets
          ? <>Se borrarán el perfil de <strong class="text-ink">{pet?.name}</strong>, sus vacunas, registros y todos sus datos. <strong class="text-ink">Esta acción no se puede deshacer.</strong></>
          : <>Se borrarán tu cuenta, tu mascota, vacunas, registros y todos tus datos. <strong class="text-ink">Esta acción no se puede deshacer.</strong></>
        }
      </p>
      {!hasMultiplePets && hasActiveWebSub && (
        <p class="rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-700 mb-4 text-center">
          Tienes una suscripción Premium activa — se <strong>cancelará automáticamente</strong> al eliminar la cuenta y no se te volverá a cobrar.
        </p>
      )}
      {!hasMultiplePets && hasActiveIapSub && (
        <p class="rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-700 mb-4 text-center">
          <strong>Importante:</strong> tu suscripción Premium es con Apple y eliminar la cuenta <strong>no detiene el cobro</strong>. Cancélala primero en <a href="https://apps.apple.com/account/subscriptions" target="_blank" rel="noopener" class="underline font-semibold">Suscripciones de tu Apple ID</a>.
        </p>
      )}
      {/* data-astro-reload: fuerza submit nativo — el ClientRouter interceptaba
          este POST y el borrado se quedaba colgado sin llegar al servidor */}
      <form method="POST" id="delete-account-form" data-astro-reload>
        <input type="hidden" name="_action" value="delete_account" />
        <button
          type="submit"
          id="btn-confirm-delete"
          class="w-full rounded-xl bg-red-500 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-red-600 active:scale-95 mb-3"
        >
          {hasMultiplePets ? `Sí, eliminar a ${pet?.name}` : 'Sí, eliminar todo'}
        </button>
      </form>
      <button
        type="button"
        id="btn-cancel-delete"
        class="w-full rounded-xl border border-card-border px-6 py-3 text-sm font-semibold text-muted transition-all hover:bg-canvas active:scale-95"
      >
        Cancelar
      </button>
    </div>
  </div>

  <!-- Feedback / Sugerencias -->
  <div id="feedback" class="mt-4 animate-fade-up animate-fade-up-delay-2">
    <button
      type="button"
      id="btn-open-feedback"
      class="w-full rounded-2xl border border-card-border bg-white px-5 py-4 flex items-center gap-4 hover:border-accent/30 transition-all active:scale-[0.98]"
    >
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/10">
        <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div class="text-left">
        <p class="text-sm font-semibold text-ink">Enviar sugerencias</p>
        <p class="text-xs text-muted">Ayúdanos a mejorar Vivra</p>
      </div>
      <svg class="h-4 w-4 text-muted/40 ml-auto shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <!-- Feedback modal -->
  <div id="feedback-modal" class="fixed inset-0 z-50 items-end justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
    <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl animate-scale-in">
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 mx-auto">
        <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <h3 class="text-center text-base font-bold text-ink mb-1">Enviar sugerencias</h3>
      <p class="text-center text-xs text-muted mb-5 leading-relaxed">
        Estamos lanzando la aplicación y cualquier aporte o reporte nos ayuda a crear una mejor experiencia. ¡Gracias!
      </p>
      <form id="feedback-form" class="space-y-3">
        <div>
          <select id="feedback-type" class="w-full rounded-xl border border-card-border bg-canvas px-4 py-2.5 text-sm text-ink focus:border-accent focus:outline-none transition-colors">
            <option value="sugerencia">Sugerencia</option>
            <option value="bug">Reportar error</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div>
          <textarea
            id="feedback-message"
            rows="4"
            required
            placeholder="Cuéntanos tu idea, reporte o comentario..."
            class="w-full rounded-xl border border-card-border bg-canvas px-4 py-3 text-sm text-ink placeholder-muted focus:border-accent focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="button"
          id="feedback-send-btn"
          class="w-full rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white text-center transition-all hover:bg-accent-dark active:scale-95"
        >
          Enviar por email
        </button>
      </form>
      <button
        type="button"
        id="btn-cancel-feedback"
        class="w-full rounded-xl border border-card-border px-6 py-3 text-sm font-semibold text-muted transition-all hover:bg-canvas active:scale-95 mt-3"
      >
        Cancelar
      </button>
    </div>
  </div>

  <!-- Footer -->
  <div class="mt-8 pb-4 text-center">
    <p class="text-xs text-muted/50">Vivra © 2026</p>
    <div class="mt-1 flex items-center justify-center gap-3">
      <a href="mailto:admin@vivrapet.com" class="text-xs text-muted/40 hover:text-muted transition-colors">Contactar soporte</a>
      <span class="text-muted/30">·</span>
      <a href="/" class="text-xs text-muted/40 hover:text-muted transition-colors">Inicio</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      // Copy invite link
      var copyBtn = document.getElementById('btn-copy-invite');
      var inviteLink = document.getElementById('invite-link');
      if (copyBtn && inviteLink) {
        copyBtn.addEventListener('click', function() {
          navigator.clipboard.writeText(inviteLink.textContent.trim()).then(function() {
            copyBtn.textContent = '¡Copiado!';
            setTimeout(function() { copyBtn.textContent = 'Copiar'; }, 2000);
          });
        });
      }

      // Photo preview
      var input = document.getElementById('photo-input');
      var preview = document.getElementById('photo-preview');
      if (input) {
        input.addEventListener('change', function() {
          var file = input.files && input.files[0];
          if (file && preview) {
            var reader = new FileReader();
            reader.onload = function(e) { preview.src = e.target.result; };
            reader.readAsDataURL(file);
          }
        });
      }

      // Theme color picker
      var themeInput = document.getElementById('theme-color-input');
      document.querySelectorAll('.theme-color-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btn.dataset.locked) { window.location.href = '/premium'; return; }
          var color = btn.dataset.color;
          if (themeInput) themeInput.value = color;
          document.querySelectorAll('.theme-color-btn').forEach(function(b) {
            var isSelected = b.dataset.color === color;
            b.classList.toggle('ring-2', isSelected);
            b.classList.toggle('ring-offset-2', isSelected);
            b.classList.toggle('ring-ink', isSelected);
            b.classList.toggle('bg-canvas', isSelected);
          });
          document.body.setAttribute('data-pet-theme', color);
        });
      });

      // Breed "Other" toggle
      var select = document.getElementById('breed-select');
      var otherInput = document.getElementById('breed-other-input');
      function toggleOther() {
        if (otherInput) {
          otherInput.classList.toggle('hidden', select.value !== 'Other');
          if (select.value !== 'Other') otherInput.value = '';
        }
      }
      if (select) select.addEventListener('change', toggleOther);

      // Change password toggle
      var btnTogglePassword = document.getElementById('btn-toggle-password');
      var passwordFormBody = document.getElementById('password-form-body');
      var iconPasswordToggle = document.getElementById('icon-password-toggle');
      if (btnTogglePassword) {
        btnTogglePassword.addEventListener('click', function() {
          var isHidden = passwordFormBody && passwordFormBody.classList.toggle('hidden');
          if (iconPasswordToggle) iconPasswordToggle.classList.toggle('rotate-180', !isHidden);
        });
      }
      var passwordForm = document.getElementById('password-form');
      if (passwordForm) {
        passwordForm.addEventListener('submit', function() {
          var btn = document.getElementById('btn-save-password');
          if (btn) { btn.textContent = 'Guardando...'; btn.disabled = true; }
        });
      }

      // Delete account modal
      var modal = document.getElementById('delete-modal');
      var btnOpen = document.getElementById('btn-delete-account');
      var btnCancel = document.getElementById('btn-cancel-delete');
      var btnConfirm = document.getElementById('btn-confirm-delete');

      function openDeleteModal() { if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); } }
      function closeDeleteModal() { if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); } }

      if (btnOpen) btnOpen.addEventListener('click', openDeleteModal);
      if (btnCancel) btnCancel.addEventListener('click', closeDeleteModal);
      if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeDeleteModal(); });
      var deleteForm = document.getElementById('delete-account-form');
      if (deleteForm) {
        deleteForm.addEventListener('submit', function() {
          if (btnConfirm) { btnConfirm.textContent = 'Eliminando...'; btnConfirm.setAttribute('disabled', ''); }
        });
      }

      // Feedback modal
      var feedbackModal = document.getElementById('feedback-modal');
      var btnOpenFeedback = document.getElementById('btn-open-feedback');
      var btnCancelFeedback = document.getElementById('btn-cancel-feedback');

      function openFeedbackModal() { if (feedbackModal) { feedbackModal.classList.remove('hidden'); feedbackModal.classList.add('flex'); } }
      function closeFeedbackModal() { if (feedbackModal) { feedbackModal.classList.add('hidden'); feedbackModal.classList.remove('flex'); } }

      if (btnOpenFeedback) btnOpenFeedback.addEventListener('click', openFeedbackModal);
      if (btnCancelFeedback) btnCancelFeedback.addEventListener('click', closeFeedbackModal);
      if (feedbackModal) feedbackModal.addEventListener('click', function(e) { if (e.target === feedbackModal) closeFeedbackModal(); });

      // Feedback send button
      var feedbackType = document.getElementById('feedback-type');
      var feedbackMessage = document.getElementById('feedback-message');
      var feedbackSendBtn = document.getElementById('feedback-send-btn');

      if (feedbackSendBtn) {
        feedbackSendBtn.addEventListener('click', function() {
          var type = (feedbackType && feedbackType.value) || 'sugerencia';
          var msg = (feedbackMessage && feedbackMessage.value) || '';
          var subject = encodeURIComponent('[Vivra] ' + type.charAt(0).toUpperCase() + type.slice(1));
          var body = encodeURIComponent(msg);
          window.location.href = 'mailto:admin@vivrapet.com?subject=' + subject + '&body=' + body;
        });
      }
    });
  </script>
</MainLayout>
