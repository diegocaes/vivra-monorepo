---
import MainLayout from '../../layouts/MainLayout.astro';
import HistoryChart from '../../components/HistoryChart.astro';
import Icon from '../../components/ui/Icon.astro';
import Card from '../../components/ui/Card.astro';
import MetricGrid from '../../components/ui/MetricGrid.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

import EmptyState from '../../components/ui/EmptyState.astro';
import {
  formatDate,
  formatGroomingServices,
  normalizeGroomingServices,
  parseNumericField,
} from '@vivra/shared';
import { getActivePet } from '../../lib/pet';
import { getPremiumStatus } from '../../lib/premium';
import { GROOMING_TYPES } from '@vivra/shared';

const { supabase, user, activePetId } = Astro.locals;
const { pet } = await getActivePet(supabase, user.id, activePetId);
if (!pet) return Astro.redirect('/perfil?new=1');

const premium = await getPremiumStatus(supabase, user.id);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;
  const services = normalizeGroomingServices(formData.getAll('services'))
    .filter(service => service in GROOMING_TYPES);
  if (action === 'add') {
    if (services.length === 0) return Astro.redirect('/salud/grooming?error=service_required');
    await supabase.from('groomings').insert({
      pet_id: pet.id,
      date: formData.get('date') as string,
      type: services[0],
      services,
      groomer_name: (formData.get('groomer_name') as string) || null,
      location: (formData.get('location') as string) || null,
      cost: parseNumericField(formData.get('cost'), { max: 100_000 }),
      notes: (formData.get('notes') as string) || null,
    });
  }
  if (action === 'edit') {
    const groomingId = formData.get('grooming_id') as string;
    if (services.length === 0) return Astro.redirect('/salud/grooming?error=service_required');
    await supabase.from('groomings').update({
      date: formData.get('date') as string,
      type: services[0],
      services,
      groomer_name: (formData.get('groomer_name') as string) || null,
      location: (formData.get('location') as string) || null,
      cost: parseNumericField(formData.get('cost'), { max: 100_000 }),
      notes: (formData.get('notes') as string) || null,
    }).eq('id', groomingId).eq('pet_id', pet.id);
  }
  if (action === 'delete') {
    const groomingId = formData.get('grooming_id') as string;
    await supabase.from('groomings').delete().eq('id', groomingId).eq('pet_id', pet.id);
    return Astro.redirect('/salud/grooming?deleted=1');
  }
  return Astro.redirect('/salud/grooming?saved=1');
}

const { data: groomings } = await supabase
  .from('groomings')
  .select('*')
  .eq('pet_id', pet.id)
  .order('date', { ascending: false });

// Analytics
const lastGroomDays = groomings?.[0]
  ? Math.floor((Date.now() - new Date(groomings[0].date + 'T00:00:00').getTime()) / 86400000)
  : null;
const avgCost = groomings && groomings.filter(g => g.cost).length > 0
  ? (groomings.filter(g => g.cost).reduce((s, g) => s + g.cost!, 0) / groomings.filter(g => g.cost).length).toFixed(0)
  : null;
---

<MainLayout title="Grooming">
  <a href="/salud" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink transition-colors mb-4">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    Salud
  </a>
  <SectionHeader title="Grooming" subtitle={`Baños, cortes y cuidado de ${pet.name}`} />

  {Astro.url.searchParams.get('error') === 'service_required' && (
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      Selecciona al menos un servicio de grooming.
    </div>
  )}

  {/* ── ANALYTICS ── */}
  {groomings && groomings.length > 0 ? (
    <div class="mb-5 animate-fade-up">
      <MetricGrid items={[
        { value: String(groomings.length), label: 'sesiones' },
        { value: lastGroomDays !== null ? `${lastGroomDays}d` : '—', label: 'último grooming' },
        { value: !avgCost ? '—' : premium.isPremium ? `$${avgCost}` : '$•••', label: 'costo prom.', href: !avgCost || premium.isPremium ? undefined : '/premium' },
      ]} />
    </div>
  ) : (
    <div class="mb-5 rounded-2xl border border-dashed border-card-border bg-card px-5 py-6 text-center animate-fade-up">
      <p class="text-sm font-semibold text-ink mb-1">Sin grooming registrado</p>
      <p class="text-xs text-muted">Registra los baños y sesiones de estética de {pet.name}</p>
    </div>
  )}

  {/* ── FORM (colapsable) ── */}
  <div class="mb-5 animate-fade-up animate-fade-up-delay-1">
    <button
      type="button"
      id="toggle-grooming-form"
      class="w-full action-primary"
    >
      <div class="flex items-center gap-2.5">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/20">
          <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        </div>
        <p class="text-sm font-semibold text-white">Registrar grooming</p>
      </div>
      <svg id="toggle-grooming-icon" class="h-4 w-4 text-white/80 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div id="grooming-form-body" class="hidden mt-2">
      <Card>
        <form method="POST" class="space-y-4">
          <input type="hidden" name="_action" value="add" />
          <fieldset>
            <legend class="block text-sm font-medium text-ink mb-1.5">Servicios incluidos <span class="text-red-500">*</span></legend>
            <p class="text-xs text-muted mb-2">Puedes seleccionar varios dentro de la misma sesión.</p>
            <div class="flex flex-wrap gap-2">
              {Object.entries(GROOMING_TYPES).map(([value, label], index) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-card-border bg-card px-3 py-2 text-xs font-medium text-ink has-[:checked]:border-accent has-[:checked]:bg-accent/10 has-[:checked]:text-accent-dark">
                  <input type="checkbox" name="services" value={value} checked={index === 0} class="accent-orange-500" />
                  {label}
                </label>
              ))}
            </div>
          </fieldset>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Fecha <span class="text-red-500">*</span></label>
              <input type="date" name="date" required value={new Date().toISOString().split('T')[0]} class="field-input" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Groomer / Peluquero</label>
              <input type="text" name="groomer_name" placeholder="Nombre del groomer" class="field-input" />
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Ciudad / Lugar</label>
              <input type="text" name="location" placeholder="Ej: Pet Spa, Madrid" class="field-input" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Costo</label>
              <input type="number" name="cost" step="0.01" placeholder="0.00" class="field-input" />
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Notas</label>
              <input type="text" name="notes" placeholder="Observaciones..." class="field-input" />
            </div>
          </div>
          <button type="submit" class="w-full rounded-xl bg-accent px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-accent-dark active:scale-95">
            Registrar grooming
          </button>
        </form>
      </Card>
    </div>
  </div>

  {/* ── GRÁFICO HISTÓRICO ── */}
  <HistoryChart
    items={(groomings ?? []).map(g => ({ date: g.date, amount: g.cost }))}
    showMoney={premium.isPremium}
    noun="sesiones"
    class="mb-5 animate-fade-up"
  />

  {/* ── HISTORIAL ── */}
  {groomings && groomings.length > 0 && (
    <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Historial</p>
  )}

  {(!groomings || groomings.length === 0) ? (
    <EmptyState icon="grooming" title="Sin grooming registrado" description="Registra la primera sesión de grooming de tu mascota" />
  ) : (
    <div class="space-y-3">
      {groomings.map((g, i) => (
        <Card variant="elevated" class:list={['animate-fade-up', i < 5 && `animate-fade-up-delay-${Math.min(i + 1, 5)}`]}>
          <div class="item-view" data-id={g.id}>
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3 flex-1 min-w-0">
                <div class="shrink-0 rounded-xl bg-pink-50 p-2.5 text-pink-500">
                  <Icon name="grooming" class="h-5 w-5" />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <p class="font-semibold text-ink">{formatGroomingServices(g.services, g.type)}</p>
                    {g.cost && <span class="shrink-0 rounded-full bg-pink-50 px-2 py-0.5 text-xs font-medium text-pink-600">${g.cost}</span>}
                  </div>
                  <p class="text-xs text-gray-400">{formatDate(g.date)}{g.groomer_name && ` · ${g.groomer_name}`}{g.location && ` · ${g.location}`}</p>
                  {g.notes && <p class="text-xs text-gray-400 mt-1">{g.notes}</p>}
                </div>
              </div>
              <div class="flex gap-1 shrink-0">
                <button type="button" class="edit-btn rounded-xl p-2 text-gray-300 transition-colors hover:bg-accent/10 hover:text-accent" data-id={g.id} title="Editar">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                </button>
                <form method="POST" onsubmit="return confirm('¿Eliminar este registro?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="grooming_id" value={g.id} />
                  <button type="submit" class="rounded-xl p-2 text-gray-300 transition-colors hover:bg-red-50 hover:text-red-500" title="Eliminar">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            </div>
          </div>

          <form method="POST" class="item-edit hidden space-y-3" data-id={g.id}>
            <input type="hidden" name="_action" value="edit" />
            <input type="hidden" name="grooming_id" value={g.id} />
            <div class="flex items-center justify-between mb-2">
              <p class="text-xs font-semibold text-accent uppercase tracking-wider">Editando</p>
              <button type="button" class="cancel-edit text-xs text-gray-400 hover:text-gray-600" data-id={g.id}>Cancelar</button>
            </div>
            <fieldset>
              <legend class="text-xs font-medium text-muted mb-2">Servicios incluidos</legend>
              <div class="flex flex-wrap gap-2">
                {Object.entries(GROOMING_TYPES).map(([value, label]) => (
                  <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-card-border px-2.5 py-1.5 text-xs text-ink has-[:checked]:border-accent has-[:checked]:bg-accent/10 has-[:checked]:text-accent-dark">
                    <input
                      type="checkbox"
                      name="services"
                      value={value}
                      checked={normalizeGroomingServices(g.services, g.type).includes(value)}
                      class="accent-orange-500"
                    />
                    {label}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="grid grid-cols-2 gap-3">
              <input type="date" name="date" value={g.date} required class="field-input-sm" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="text" name="groomer_name" value={g.groomer_name || ''} placeholder="Groomer" class="field-input-sm" />
              <input type="text" name="location" value={g.location || ''} placeholder="Ciudad / Lugar" class="field-input-sm" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="number" name="cost" step="0.01" value={g.cost || ''} placeholder="Costo" class="field-input-sm" />
              <input type="text" name="notes" value={g.notes || ''} placeholder="Notas" class="field-input-sm" />
            </div>
            <button type="submit" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-all hover:bg-accent-dark active:scale-95">Guardar cambios</button>
          </form>
        </Card>
      ))}
    </div>
  )}

  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      var toggleBtn = document.getElementById('toggle-grooming-form');
      var formBody = document.getElementById('grooming-form-body');
      var toggleIcon = document.getElementById('toggle-grooming-icon');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          var isOpen = formBody && !formBody.classList.contains('hidden');
          if (formBody) formBody.classList.toggle('hidden');
          if (toggleIcon) toggleIcon.style.transform = isOpen ? '' : 'rotate(180deg)';
        });
      }
      document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id;
          var view = document.querySelector('.item-view[data-id="' + id + '"]');
          var edit = document.querySelector('.item-edit[data-id="' + id + '"]');
          if (view) view.classList.add('hidden');
          if (edit) edit.classList.remove('hidden');
        });
      });
      document.querySelectorAll('.cancel-edit').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id;
          var view = document.querySelector('.item-view[data-id="' + id + '"]');
          var edit = document.querySelector('.item-edit[data-id="' + id + '"]');
          if (view) view.classList.remove('hidden');
          if (edit) edit.classList.add('hidden');
        });
      });
    });
  </script>

  <p class="mt-10 mb-4 text-center text-xs text-muted/40 leading-relaxed max-w-xs mx-auto">El grooming regular mantiene a tu mascota limpia y saludable. Registra cada sesión para llevar el control de baños, cortes y cuidado dental.</p>

</MainLayout>
