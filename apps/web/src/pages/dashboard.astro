              <p class="text-[11px] text-muted">
                <span class="font-semibold text-ink">${formatCurrency(foodStats.avgPricePerDay)}</span>/día
              </p>
            )}
            {foodStats.avgDaysPerBag !== null && (
              <p class="text-[11px] text-muted">
                <span class="font-semibold text-ink">{foodStats.avgDaysPerBag}d</span>/bolsa
              </p>
            )}
            {foodStats.avgDailyGrams !== null && (
              <p class="text-[11px] text-muted">
                <span class="font-semibold text-ink">{foodStats.avgDailyGrams}g</span>/día
              </p>
