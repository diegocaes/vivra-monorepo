              <span class="font-semibold text-ink">{foodStats.totalBags}</span> {foodStats.totalBags === 1 ? 'bolsa' : 'bolsas'}
            </p>
          </div>
        </>
      ) : (
        <p class="text-sm text-muted">—</p>
      )}
    </a>
  </div>

  {/* ── PREVENTIVOS: Antipulgas + Desparasitante ── */}
  <div class="grid grid-cols-2 gap-3 mb-6 animate-fade-up animate-fade-up-delay-2">
    <a href="/salud/preventivos" class:list={[
      'rounded-2xl px-4 py-4 active:scale-95 transition-transform hover:shadow-sm',
      !antipulgasInfo.hasRecord || (antipulgasInfo.hasDue && antipulgasInfo.overdue)
        ? 'border-2 border-red-300 bg-red-50 ring-2 ring-red-200/50'
        : antipulgasInfo.hasDue && antipulgasInfo.daysLeft <= 5
          ? 'border-2 border-amber-300 bg-amber-50 ring-2 ring-amber-200/50'
