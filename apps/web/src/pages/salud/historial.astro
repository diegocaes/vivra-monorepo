---
import MainLayout from '../../layouts/MainLayout.astro';
import HistoryChart from '../../components/HistoryChart.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import HealthHeader from '../../components/health/HealthHeader.astro';
import HealthLoadNotice from '../../components/health/HealthLoadNotice.astro';
import { formatDate, parseNumericField, formatCurrency, sumAmounts, localDateKey } from '@vivra/shared';
import { getActivePet } from '../../lib/pet';
import { getPremiumStatus } from '../../lib/premium';

const { supabase, user, activePetId } = Astro.locals;
const { pet } = await getActivePet(supabase, user.id, activePetId);
if (!pet) return Astro.redirect('/perfil?new=1');

const premium = await getPremiumStatus(supabase, user.id);

function redirectError(message: string) {
  return Astro.redirect('/salud/historial?toast_error=' + encodeURIComponent(message));
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;
  if (action === 'add') {
    const { error } = await supabase.from('vet_visits').insert({
      pet_id: pet.id,
      date: formData.get('date') as string,
      reason: formData.get('reason') as string,
      vet_name: (formData.get('vet_name') as string) || null,
      clinic_name: (formData.get('clinic_name') as string) || null,
      location: (formData.get('location') as string) || null,
      diagnosis: (formData.get('diagnosis') as string) || null,
      treatment: (formData.get('treatment') as string) || null,
      cost: parseNumericField(formData.get('cost'), { max: 100_000 }),
      notes: (formData.get('notes') as string) || null,
    });
    if (error) return redirectError('No se pudo guardar el registro. Inténtalo de nuevo.');
  }
  if (action === 'edit') {
    const visitId = formData.get('visit_id') as string;
    const { error } = await supabase.from('vet_visits').update({
      date: formData.get('date') as string,
      reason: formData.get('reason') as string,
      vet_name: (formData.get('vet_name') as string) || null,
      clinic_name: (formData.get('clinic_name') as string) || null,
      location: (formData.get('location') as string) || null,
      diagnosis: (formData.get('diagnosis') as string) || null,
      treatment: (formData.get('treatment') as string) || null,
      cost: parseNumericField(formData.get('cost'), { max: 100_000 }),
      notes: (formData.get('notes') as string) || null,
    }).eq('id', visitId).eq('pet_id', pet.id);
    if (error) return redirectError('No se pudo guardar el registro. Inténtalo de nuevo.');
  }
  if (action === 'delete') {
    const visitId = formData.get('visit_id') as string;
    const { error } = await supabase.from('vet_visits').delete().eq('id', visitId).eq('pet_id', pet.id);
    if (error) return redirectError('No se pudo eliminar el registro. Inténtalo de nuevo.');
    return Astro.redirect('/salud/historial?deleted=1');
  }
  return Astro.redirect('/salud/historial?saved=1');
}

const { data: visits, error: loadError } = await supabase
  .from('vet_visits')
  .select('*')
  .eq('pet_id', pet.id)
  .order('date', { ascending: false });

// Analytics
// Misma suma y mismo formato que el perfil: `toFixed(0)` redondeaba a $428
// lo que el perfil mostraba como $427.99, y el mismo gasto parecía distinto.
const totalCost = sumAmounts(visits, 'cost');
const visitsThisYear = visits?.filter(visit => visit.date.slice(0, 4) === localDateKey().slice(0, 4)).length ?? 0;
---

<MainLayout title="Historial Veterinario">
  <HealthHeader pet={pet} active="historial" title="Visitas veterinarias" subtitle={`Consultas y tratamientos de ${pet.name}`} />
  {loadError && <HealthLoadNotice href="/salud/historial" subject="las visitas veterinarias" />}

  {!loadError && <>
  {/* ── ANALYTICS ── */}
  {visits && visits.length > 0 ? (
    <div class="health-metric-strip">
      <div><Icon name="vet" class="h-5 w-5 mx-auto mb-2 text-muted" /><strong>{visitsThisYear}</strong><p>Visitas este año</p></div>
      <div><Icon name="calendario" class="h-5 w-5 mx-auto mb-2 text-muted" /><strong>{formatDate(visits[0].date)}</strong><p>Última visita</p></div>
      <div><Icon name="vet" class="h-5 w-5 mx-auto mb-2 text-muted" /><strong>{visits[0].clinic_name || visits[0].vet_name || 'Sin registrar'}</strong><p>Clínica o veterinario de la última visita</p></div>
    </div>
    <p class="health-metric-note">{visits.length} visitas registradas · Gasto total: {totalCost === 0 ? '—' : premium.isPremium ? `$${formatCurrency(totalCost)}` : '$•••'}{totalCost > 0 && !premium.isPremium && <a href="/premium"> Ver con Premium</a>}</p>
  ) : (
    <div class="mb-5 rounded-2xl border border-dashed border-card-border bg-card px-5 py-6 text-center animate-fade-up">
      <p class="text-sm font-semibold text-ink mb-1">Sin visitas registradas</p>
      <p class="text-xs text-muted">Registra las citas al veterinario para llevar un historial completo</p>
    </div>
  )}

  </>}

  {/* ── FORM (colapsable) ── */}
  <div class="mb-5 animate-fade-up animate-fade-up-delay-1">
    <button
      type="button"
      id="toggle-historial-form"
      aria-controls="historial-form-body"
      aria-expanded={Astro.url.searchParams.get('new') === '1'}
      class="w-full action-primary"
    >
      <div class="flex items-center gap-2.5">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/20">
          <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        </div>
        <p class="text-sm font-semibold text-white">Nueva visita</p>
      </div>
      <svg id="toggle-historial-icon" class="h-4 w-4 text-white/80 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div id="historial-form-body" class:list={['mt-2', { hidden: Astro.url.searchParams.get('new') !== '1' }]}>
      <Card>
        <form method="POST" class="space-y-4">
          <input type="hidden" name="_action" value="add" />
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Fecha <span class="text-red-500">*</span></label>
              <input type="date" name="date" required class="field-input" />
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Costo</label>
              <input type="number" name="cost" step="0.01" placeholder="0.00" class="field-input" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Motivo <span class="text-red-500">*</span></label>
            <input type="text" name="reason" required placeholder="Ej: Revisión anual" class="field-input" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Veterinario</label>
              <input type="text" name="vet_name" placeholder="Dr. García" class="field-input" />
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5">Clínica</label>
              <input type="text" name="clinic_name" placeholder="Ej: Clínica Animal" class="field-input" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Ciudad / Lugar</label>
            <input type="text" name="location" placeholder="Ej: Madrid, España" class="field-input" />
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Diagnóstico</label>
            <textarea name="diagnosis" rows="2" placeholder="¿Qué encontró el veterinario?" class="field-input resize-none"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Tratamiento</label>
            <textarea name="treatment" rows="2" placeholder="Medicamentos, indicaciones..." class="field-input resize-none"></textarea>
          </div>
          <button type="submit" class="w-full rounded-xl bg-accent px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-accent-dark active:scale-95">
            Registrar visita
          </button>
        </form>
      </Card>
    </div>
  </div>

  {!loadError && <>
  {/* ── GRÁFICO HISTÓRICO ── */}
  <HistoryChart
    items={(visits ?? []).map(v => ({ date: v.date, amount: v.cost }))}
    showMoney={premium.isPremium}
    noun="visitas"
    class="mb-5 animate-fade-up"
  />

  {/* ── HISTORIAL ── */}
  {visits && visits.length > 0 && (
    <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Historial</p>
  )}

  {(!visits || visits.length === 0) ? (
    <EmptyState icon="vet" title="Sin visitas registradas" description="Registra la primera visita al veterinario" />
  ) : (
    <div class="space-y-3">
      {visits.map((visit, i) => (
        <Card variant="elevated" class:list={['animate-fade-up', i < 5 && `animate-fade-up-delay-${Math.min(i + 1, 5)}`]}>
          <div class="item-view" data-id={visit.id}>
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <p class="font-semibold text-ink">{visit.reason}</p>
                  {visit.cost && (
                    <span class="shrink-0 rounded-full bg-amber/10 px-2 py-0.5 text-xs font-medium text-amber-dark">${visit.cost}</span>
                  )}
                </div>
                <p class="text-xs text-gray-400 mb-2">{formatDate(visit.date)}{visit.vet_name && ` · ${visit.vet_name}`}{visit.clinic_name && ` · ${visit.clinic_name}`}{visit.location && ` · ${visit.location}`}</p>
                {visit.diagnosis && <p class="text-sm text-gray-600 mb-1"><strong>Diagnóstico:</strong> {visit.diagnosis}</p>}
                {visit.treatment && <p class="text-sm text-gray-600"><strong>Tratamiento:</strong> {visit.treatment}</p>}
                {visit.notes && <p class="text-xs text-gray-400 mt-1">{visit.notes}</p>}
              </div>
              <div class="flex gap-1 shrink-0">
                <button type="button" class="edit-btn rounded-xl p-2 text-gray-300 transition-colors hover:bg-accent/10 hover:text-accent" data-id={visit.id} title="Editar">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                </button>
                <form method="POST" onsubmit="return confirm('¿Eliminar esta visita?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="visit_id" value={visit.id} />
                  <button type="submit" class="rounded-xl p-2 text-gray-300 transition-colors hover:bg-red-50 hover:text-red-500" title="Eliminar">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            </div>
          </div>

          <form method="POST" class="item-edit hidden space-y-3" data-id={visit.id}>
            <input type="hidden" name="_action" value="edit" />
            <input type="hidden" name="visit_id" value={visit.id} />
            <div class="flex items-center justify-between mb-2">
              <p class="text-xs font-semibold text-accent uppercase tracking-wider">Editando</p>
              <button type="button" class="cancel-edit text-xs text-gray-400 hover:text-gray-600" data-id={visit.id}>Cancelar</button>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="date" name="date" value={visit.date} required class="field-input-sm" />
              <input type="number" name="cost" step="0.01" value={visit.cost || ''} placeholder="Costo" class="field-input-sm" />
            </div>
            <input type="text" name="reason" value={visit.reason} required placeholder="Motivo" class="field-input-sm" />
            <div class="grid grid-cols-2 gap-3">
              <input type="text" name="vet_name" value={visit.vet_name || ''} placeholder="Veterinario" class="field-input-sm" />
              <input type="text" name="clinic_name" value={visit.clinic_name || ''} placeholder="Clínica" class="field-input-sm" />
            </div>
            <input type="text" name="location" value={visit.location || ''} placeholder="Ciudad / Lugar" class="field-input-sm" />
            <textarea name="diagnosis" rows="2" placeholder="Diagnóstico" class="field-input-sm resize-none">{visit.diagnosis || ''}</textarea>
            <textarea name="treatment" rows="2" placeholder="Tratamiento" class="field-input-sm resize-none">{visit.treatment || ''}</textarea>
            <textarea name="notes" rows="1" placeholder="Notas" class="field-input-sm resize-none">{visit.notes || ''}</textarea>
            <button type="submit" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-all hover:bg-accent-dark active:scale-95">Guardar cambios</button>
          </form>
        </Card>
      ))}
    </div>
  )}

  </>}

  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      var pageControl = document.getElementById('toggle-historial-form');
      if (!pageControl || pageControl.dataset.healthInitialized === '1') return;
      pageControl.dataset.healthInitialized = '1';
      var toggleBtn = document.getElementById('toggle-historial-form');
      var formBody = document.getElementById('historial-form-body');
      var toggleIcon = document.getElementById('toggle-historial-icon');
      if (toggleIcon && formBody && !formBody.classList.contains('hidden')) toggleIcon.style.transform = 'rotate(180deg)';
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          var isOpen = formBody && !formBody.classList.contains('hidden');
          if (formBody) formBody.classList.toggle('hidden');
          toggleBtn.setAttribute('aria-expanded', String(!isOpen));
          if (toggleIcon) toggleIcon.style.transform = isOpen ? '' : 'rotate(180deg)';
        });
      }
      document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id;
          var view = document.querySelector('.item-view[data-id="' + id + '"]');
          var edit = document.querySelector('.item-edit[data-id="' + id + '"]');
          if (view) view.classList.add('hidden');
          if (edit) edit.classList.remove('hidden');
        });
      });
      document.querySelectorAll('.cancel-edit').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id;
          var view = document.querySelector('.item-view[data-id="' + id + '"]');
          var edit = document.querySelector('.item-edit[data-id="' + id + '"]');
          if (view) view.classList.remove('hidden');
          if (edit) edit.classList.add('hidden');
        });
      });
    });
  </script>

  <p class="mt-10 mb-4 text-center text-xs text-muted/40 leading-relaxed max-w-xs mx-auto">Llevar un registro de cada visita al veterinario te ayuda a tener el historial médico completo y tomar mejores decisiones sobre la salud de tu mascota.</p>

</MainLayout>
